                            help="Download the known-bad package list now without asking")
    output_flags(aur_parser)

    # self-check subcommand
    selfcheck_parser = subparsers.add_parser(
        "self-check",
        help="Startup self-check items (ld.so.preload, loader variables, unowned mappings) and the self "
