def format_default_rules() -> str:
    """The built-in rules as TOML, for `weird rules show --defaults`."""
    lines = ["# Built-in rules, applied before rules.toml (defaults = false turns them off)", ""]
    for rule in DEFAULT_RULES:
        lines.append("[[rules]]")
        for key, value in rule.items():
            if isinstance(value, dict):
                inner = ", ".join(f'{k} = "{v}"' for k, v in value.items())
                lines.append(f"{key} = {{ {inner} }}")
            elif isinstance(value, str):
                lines.append(f'{key} = "{value}"')
            else:
                lines.append(f"{key} = {value}")
        lines.append("")
    return "\n".join(lines)


def cmd_rules_init(args) -> int:
    """Write rules template to rules.toml."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if RULES_FILE.exists() and not getattr(args, "force", False):
        print(f"{RULES_FILE} already exists. Use --force to overwrite.")
        return 1
    template = RULES_TEMPLATE
    RULES_FILE.write_text(template)
    print(f"Wrote rules template to {RULES_FILE}")
    return 0


def cmd_cache(args) -> int:
    """Manage the file->package cache."""
    if args.rebuild:
        print("Rebuilding file->package cache...")
        file_package_cache.build(force=True)
        print(f"Cache rebuilt: {len(file_package_cache._cache)} files indexed")
        print(f"Cache location: {CACHE_FILE}")
    else:
        if CACHE_FILE.exists():
            file_package_cache.build()
            print(f"Cache contains {len(file_package_cache._cache)} files")
            print(f"Location: {CACHE_FILE}")
            stat = CACHE_FILE.stat()
            print(f"Size: {stat.st_size / 1024:.1f} KB")
        else:
            print("Cache not built yet. Run 'weird cache --rebuild'")

    return 0


# =============================================================================
# Real-time sensor events (weird watch --events)
# =============================================================================

SENSOR_SCHEMA = 1
SENSOR_SCHEMA_EXIT = 3
SENSOR_SEEN_MAX = 100000
FOLLOW_POLL_SECONDS = 0.2
# bpf(2) commands that put code or hooks into the kernel; map and query commands are not reported
BPF_LOAD_COMMANDS = {5: "BPF_PROG_LOAD", 17: "BPF_RAW_TRACEPOINT_OPEN", 28: "BPF_LINK_CREATE"}


def follow_file(path: str, follow: bool = True, poll: float = FOLLOW_POLL_SECONDS):
    """Yield complete lines from `path` the way tail -F does.

    At end of file: stop when `follow` is false, otherwise sleep `poll` seconds and
    look again. The file is reopened from the start when its inode changes
    (rotation) or its size drops below the read position (truncation). A file
    truncated and rewritten to the same or a larger size is not noticed, same as
    tail. A partial last line waits for its newline; without follow it is
    yielded as is.
    """
    f = open(path, "rb")
    try:
        inode = os.fstat(f.fileno()).st_ino
        partial = b""
        while True:
            chunk = f.readline()
            if chunk:
                partial += chunk
                if partial.endswith(b"\n"):
                    line, partial = partial, b""
                    yield line.decode("utf-8", errors="replace")
                continue
            if not follow:
                if partial:
                    yield partial.decode("utf-8", errors="replace")
                return
            time.sleep(poll)
            try:
                st = os.stat(path)
            except OSError:
                continue
            if st.st_ino != inode or st.st_size < f.tell():
                f.close()
                f = open(path, "rb")
                inode = os.fstat(f.fileno()).st_ino
                partial = b""
    finally:
        f.close()


def event_start_time(event: Dict, hello: Optional[Dict]) -> Optional[float]:
    """Epoch seconds for an exec event's task start, the unit ProcessInfo.start_time uses.

    The sensor sends task->start_time, nanoseconds on the monotonic clock. The
    hello event carries the boot time as epoch seconds (wall clock minus
    CLOCK_BOOTTIME), so boot + start / 1e9 is the same kind of number as
    /proc/stat btime + starttime / CLK_TCK in poll mode, rounded to the tick
    (0.01 s). The two clocks only part across a suspend (BOOTTIME keeps counting,
    MONOTONIC does not); event keys are compared with other event keys only, and
    an emitted record takes its start_time from /proc while the process exists.
    Without a hello, /proc/stat btime stands in; without either the raw
    nanoseconds are used so keys still tell reused pids apart.
    """
    start = event.get("start")
    if not isinstance(start, (int, float)):
        return None
    boot = hello.get("boot") if hello else None
    if not isinstance(boot, (int, float)):
        boot = boot_time()
    if boot is None:
        return float(start)
    return round(boot + start / 1e9, 2)


def event_process(event: Dict) -> ProcessInfo:
    """A ProcessInfo built from an event alone, for a process that exited before /proc could be read."""
    uid = int(event.get("uid", 0) or 0)
    proc = ProcessInfo(pid=int(event.get("pid", 0) or 0), name=str(event.get("comm", "")),
                       path=str(event.get("path", "")), cmdline=str(event.get("argv0", "") or event.get("path", "")),
                       uid=uid, username=get_username(uid), ppid=int(event.get("ppid", 0) or 0))
    proc.evidence.append("short-lived process: exited before /proc could be read, judged from the sensor event alone")
    proc.process_key = build_process_key(proc)
    return proc


class SensorConsumer:
    """Turns sensor events into the same alerts poll mode prints, plus module and bpf findings.

    Exec events are keyed by (pid, start) like poll mode; a key is dropped on the
    exit event and the set is capped at SENSOR_SEEN_MAX with the oldest evicted
    first. Every signal goes through add_signal so reasons and ATT&CK ids match
    a scan.
    """

    def __init__(self, emit, rescan):
        self.emit = emit
        self.rescan = rescan
        self.hello: Optional[Dict] = None
        self.seen: Dict[Tuple[int, Optional[float]], str] = {}
        self.by_pid: Dict[int, Tuple[int, Optional[float]]] = {}
        self.host = socket.gethostname()
        self.user_trusted = load_user_trusted()
        self.trusted = load_trusted()
        file_package_cache.build()

    def handle(self, event: Dict) -> None:
        handler = getattr(self, "on_" + str(event.get("kind", "")), None)
        if handler is not None:
            handler(event)

    def remember(self, key: Tuple[int, Optional[float]], path: str) -> None:
        self.seen[key] = path
        self.by_pid[key[0]] = key
        while len(self.seen) > SENSOR_SEEN_MAX:
            oldest = next(iter(self.seen))
            del self.seen[oldest]
            if self.by_pid.get(oldest[0]) == oldest:
                del self.by_pid[oldest[0]]

    def emit_alert(self, proc: ProcessInfo) -> None:
        item = process_to_dict(proc)
        item["host"] = self.host
        item["timestamp"] = int(time.time())
        self.emit(item)

    def emit_finding(self, finding: Finding) -> None:
        item = asdict(finding)
        item["host"] = self.host
        item["timestamp"] = int(time.time())
        self.emit(item)

    def score(self, proc: ProcessInfo) -> None:
        proc.parent_chain = [comm for _, comm in ancestors(proc.pid)]
        classify_and_score([proc], self.user_trusted, trusted=self.trusted)

    def on_exec(self, event: Dict) -> None:
        pid = int(event.get("pid", 0) or 0)
        path = str(event.get("path", ""))
        key = (pid, event_start_time(event, self.hello))
        if self.seen.get(key) == path:
            return
        self.remember(key, path)
        proc = read_process(pid)
        if proc is None:
            if is_suspicious_path(path) or path.endswith(" (deleted)"):
                proc = event_process(event)
                proc.weirdness_score = add_signal(proc, "suspicious_path", f"short-lived process ran from {path}")
                self.emit_alert(proc)
            return
        self.score(proc)
        if watch_flagged(proc):
            self.emit_alert(proc)

    def on_memfd(self, event: Dict) -> None:
        pid = int(event.get("pid", 0) or 0)
        name = str(event.get("name", ""))
        if _is_legitimate_memfd("/memfd:" + name):
            return
        proc = read_process(pid)
        if proc is None:
            proc = event_process(event)
            proc.weirdness_score = add_signal(proc, "memfd_exec", f"short-lived process created memfd \"{name}\"")
            self.emit_alert(proc)
            return
        self.score(proc)
        if proc.suppressed or proc.name in JIT_HEAVY_PROCESSES or "memfd_exec" in proc.signal_keys:
            return
        if proc.trust_level in (TrustLevel.OFFICIAL_REPO, TrustLevel.FLATPAK, TrustLevel.SNAP,
                                TrustLevel.CONTAINER, TrustLevel.KERNEL, TrustLevel.USER_TRUSTED):
            proc.evidence.append(f"memfd_create(\"{name}\") by a packaged program (not scored)")
            return
        proc.weirdness_score += add_signal(proc, "memfd_exec", f"memfd_create(\"{name}\"): anonymous in-memory file")
        self.emit_alert(proc)

    def on_ptrace(self, event: Dict) -> None:
        tracer = int(event.get("pid", 0) or 0)
        comm = str(event.get("comm", ""))
        proc = read_process(int(event.get("target", 0) or 0))
        if proc is None:
            return
        self.score(proc)
        text = f"Being traced by pid {tracer} ({comm}), ptrace request {event.get('request')}"
        if comm in KNOWN_DEBUGGERS:
            proc.evidence.append(f"{text}, known debugger (not scored)")
            return
        if proc.suppressed or "traced" in proc.signal_keys:
            return
        proc.weirdness_score += add_signal(proc, "traced", text)
        self.emit_alert(proc)

    def on_module(self, event: Dict) -> None:
        pid = int(event.get("pid", 0) or 0)
        name = str(event.get("name", ""))
        comm = str(event.get("comm", ""))
        release = str((self.hello or {}).get("release") or running_kernel())
        owner = None
        if "fd" in event:
            try:
                path = os.readlink(proc_path(pid, "fd", str(event["fd"])))
            except OSError:
                path = ""
            where = f"{path} (from fd {event['fd']})" if path else f"fd {event['fd']} of pid {pid}, already closed"
        else:
            path = (module_file_index(release) or {}).get(name.replace("-", "_"), "")
            where = path or f"no {name}.ko under /usr/lib/modules/{release}"
        if path:
            owner = file_package_cache.get(normalize_exe_path(path))
            if not owner:
                dkms = dkms_source_package(name)
                owner = f"dkms ({dkms[1]})" if dkms else None
        verdict = f"owned by {owner}" if owner else "not owned by any package"
        self.emit_finding(Finding("module_load", f"{name} loaded by {comm} pid {pid}: {where}, {verdict}",
                                  "info" if owner else "critical", "T1014", subject=name))

    def on_bpf(self, event: Dict) -> None:
        pid = int(event.get("pid", 0) or 0)
        cmd = event.get("cmd")
        if cmd not in BPF_LOAD_COMMANDS:
            return
        comm = str(event.get("comm", ""))
        what = BPF_LOAD_COMMANDS[cmd] + (f" prog_type {event['prog_type']}" if "prog_type" in event else "")
        proc = read_process(pid)
        if proc is None:
            who = f"{comm} pid {pid} (exited before it could be checked)"
            official = False
        else:
            proc.trust_level, evidence = classify_process(proc)
            proc.evidence.extend(evidence)
            official = proc.trust_level == TrustLevel.OFFICIAL_REPO
            who = f"{comm} pid {pid} ({proc.path or 'unknown path'}, {proc.trust_level.value})"
        self.emit_finding(Finding("bpf_load", f"{what} by {who}", "info" if official else "medium", "T1014",
                                  subject=comm))

    def on_connect(self, event: Dict) -> None:
        daddr = str(event.get("daddr", ""))
        dport = int(event.get("dport", 0) or 0)
        if dport in COMMON_OUTBOUND_PORTS or not is_public_ip(daddr):
            return
        proc = read_process(int(event.get("pid", 0) or 0))
        if proc is None:
            return
        protocol = "tcp6" if event.get("family") == 10 else "tcp"
        proc.connections = [NetworkConnection("", 0, daddr, dport, "SYN_SENT", protocol)]
        self.score(proc)
        if "raw_ip_outbound" in proc.signal_keys and not proc.suppressed:
            self.emit_alert(proc)

    def on_lost(self, event: Dict) -> None:
        print(f"warning: sensor lost {event.get('count', '?')} event(s) (ring buffer overflow), rescanning /proc",
              file=sys.stderr, flush=True)
        self.rescan()

    def on_exit(self, event: Dict) -> None:
        key = self.by_pid.pop(int(event.get("pid", 0) or 0), None)
        if key is not None:
            self.seen.pop(key, None)


def events_loop(lines, emit, rescan) -> int:
    """Consume sensor NDJSON lines. Returns 0 at the end of the stream, 3 on an unsupported schema.

    `lines` yields one NDJSON string per event (follow_file in production, a
    list in tests). `emit` receives alert dicts in the --ndjson shape and
    finding dicts (with "kind"); `rescan` runs on a lost event. The first line
    should be the sensor's hello; without one the stream is still consumed and
    start times fall back to /proc/stat btime.
    """
    consumer = SensorConsumer(emit, rescan)
    first = True
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except ValueError:
            print(f"warning: unparseable sensor line: {line[:80]}", file=sys.stderr, flush=True)
            continue
        if not isinstance(event, dict):
            continue
        if event.get("kind") == "hello":
            version = event.get("v")
            if version != SENSOR_SCHEMA:
                print(f"unsupported sensor schema v={version} (weird understands v={SENSOR_SCHEMA})",
                      file=sys.stderr, flush=True)
                return SENSOR_SCHEMA_EXIT
            consumer.hello = event
            first = False
            continue
        if first:
            print("warning: sensor stream did not start with a hello event; start times use /proc/stat btime",
                  file=sys.stderr, flush=True)
            first = False
        consumer.handle(event)
    return 0


def journal_watch_item(item: Dict) -> None:
    """--journal for a watch line: findings via journal_findings, alerts like journal_alerts."""
    if "detail" in item and "severity" in item:
        journal_findings("watch", [Finding(item["kind"], item["detail"], item["severity"],
                                           item.get("attack", ""), item.get("subject", ""))])
        return
    critical = load_policy()["thresholds"]["critical"]
    score = int(item.get("weirdness_score", 0))
    severity = "critical" if item.get("is_memfd") or item.get("is_deleted") or score >= critical else "warning"
    verdict = item.get("verdict") or "Flagged"
    reasons = item.get("reasons") or [""]
    journal_send({
        "MESSAGE": f"weird: {verdict} {item.get('name', '')} pid {item.get('pid')} score {score}: {reasons[0]}",
        "PRIORITY": journal_priority(severity),
        "SYSLOG_IDENTIFIER": "weird",
        "WEIRD_PID": item.get("pid"),
        "WEIRD_NAME": item.get("name", ""),
        "WEIRD_SCORE": score,
        "WEIRD_TRUST": item.get("trust_level", ""),
        "WEIRD_ATTACK": ",".join(item.get("attack") or []),
        "WEIRD_VERDICT": verdict,
    })


def watch_scan_args() -> argparse.Namespace:
    """What run_scan needs for the full rescan a lost event triggers."""
    return argparse.Namespace(verbose=False, all=False, net=False, net_outbound_only=False, include_listen=False,
                              enrich_net=False, deep=False, json=False, ndjson=False, log_file=None,
                              raw_cmdline=False, debug_log=None, proc_root=None, sysroot=None,
                              command="watch", baseline_cmd=None)


def watch_events(path: str, emit, follow: Optional[bool]) -> int:
    """Feed the sensor's file to events_loop; follow defaults to on for paths under /run."""
    if follow is None:
        follow = path.startswith("/run/")
    try:
        open(path, "rb").close()
    except OSError as exc:
        print(f"cannot read sensor events {path}: {exc.strerror or exc}", file=sys.stderr, flush=True)
        return 1
    host = socket.gethostname()

    def rescan() -> None:
        processes, alerts, _ = run_scan(watch_scan_args())
        by_pid = {p.pid: p for p in processes}
        timestamp = int(time.time())
        for alert in alerts:
            proc = by_pid.get(alert["pid"])
            if proc is None:
                continue
            item = process_to_dict(proc)
            item["host"] = host
            item["timestamp"] = timestamp
            emit(item)

    print(f"{'following' if follow else 'reading'} sensor events from {path}", file=sys.stderr, flush=True)
    try:
        return events_loop(follow_file(path, follow=follow), emit, rescan)
    except (KeyboardInterrupt, BrokenPipeError):
        return 0


def cmd_watch(args) -> int:
    """Consume the sensor's events (--events, or automatically when its file is fresh), poll /proc, or run Falco."""
    if getattr(args, "falco", False):
        return watch_falco()
    journal = getattr(args, "journal", False)

    def emit(item: Dict) -> None:
        print(json.dumps(item), flush=True)
        if journal:
            journal_watch_item(item)

    events = getattr(args, "events", None)
    poll = getattr(args, "poll", None)
    if events is None and poll is None and sensor_state() == "active":
        events = sys_path(SENSOR_EVENTS_FILE)
        print(f"real-time sensor is writing {events}: using its events (--poll SECONDS forces polling)",
              file=sys.stderr, flush=True)
    if events is not None:
        return watch_events(events, emit, getattr(args, "follow", None))
    interval = max(0.1, float(poll or 2))
    print(f"watching {PROC_ROOT} every {interval:g} s", file=sys.stderr, flush=True)
    try:
        watch_loop(watch_snapshots(interval), emit)
    except (KeyboardInterrupt, BrokenPipeError):
        return 0
    return 0


def systemd_unit_for_pid(pid: int) -> Tuple[str, Optional[str]]:
    """(unit, manager) from /proc/<pid>/cgroup. manager is 'system', 'user', or None when not a unit."""
    cgroup = ""
    try:
        with open(proc_path(pid, "cgroup")) as f:
            for line in f:
                parts = line.strip().split(":", 2)
                if len(parts) == 3 and (parts[0] == "0" or not cgroup):
                    cgroup = parts[2]
    except (IOError, PermissionError):
        return "not a unit", None
    components = [c for c in cgroup.split("/") if c]
    if not components or not components[-1].endswith((".service", ".scope")):
        return "not a unit", None
    # user units sit below user@<uid>.service; session scopes next to it belong to the system manager
    user = any(c.startswith("user@") and c.endswith(".service") for c in components[:-1])
    return components[-1], "user" if user else "system"


def restart_suggestion(unit: str, manager: Optional[str]) -> str:
    if manager is None:
        return "restart the program by hand (not managed by a systemd unit)"
    if unit.endswith(".scope"):
        return f"restart the program by hand ({unit} is a scope, scopes cannot be restarted)"
    if manager == "user":
        return f"systemctl --user restart {unit}"
    return f"systemctl restart {unit}"


def find_stale_processes() -> List[ProcessInfo]:
    """Processes whose executable or a mapped library was replaced by a package installed after they started."""
    file_package_cache.build()
    stale = []
    for proc in get_processes():
        annotate_staleness(proc)
        if proc.is_stale or proc.stale_libs:
            stale.append(proc)
    return stale


def group_stale_by_unit(processes: List[ProcessInfo]) -> List[Dict]:
    groups: Dict[Tuple[str, Optional[str]], Dict] = {}
    for proc in sorted(processes, key=lambda p: p.pid):
        unit, manager = systemd_unit_for_pid(proc.pid)
        group = groups.setdefault((unit, manager), {
            "unit": unit,
            "manager": manager,
            "restart": restart_suggestion(unit, manager),
            "processes": [],
        })
        group["processes"].append({
            "pid": proc.pid,
            "name": proc.name,
            "path": proc.path,
            "is_stale": proc.is_stale,
            "stale_libs": proc.stale_libs,
        })
    return sorted(groups.values(), key=lambda g: (g["manager"] is None, g["manager"] or "", g["unit"]))


def cmd_restart_needed(args) -> int:
    """List processes still running files a package upgrade replaced, grouped by systemd unit."""
    stale = find_stale_processes()
    groups = group_stale_by_unit(stale)
    note_counts({"medium": len(stale)})
    if args.json:
        payload = {
            "host": socket.gethostname(),
            "timestamp": int(time.time()),
            "stale_processes": len(stale),
            "groups": groups,
        }
        print(json.dumps(payload, indent=2))
        return 1 if stale else 0

    if not stale:
        print("Nothing to restart: no process is running a replaced executable or library.")
        return 0

    print(f"{len(stale)} process(es) still running files replaced by a package upgrade:\n")
    header = f"{'UNIT':<40} {'PIDS':<18} {'NAMES':<20} STALE"
    print(header)
    print("-" * 100)
    for group in groups:
        pids = ", ".join(str(p["pid"]) for p in group["processes"])
        names = ", ".join(sorted({p["name"] for p in group["processes"]}))
        what = []
        for p in group["processes"]:
            if p["is_stale"]:
                what.append(f"exe {os.path.basename(p['path']) or p['name']}")
            for lib in p["stale_libs"]:
                what.append(f"library {os.path.basename(lib)}")
        label = group["unit"] + (" (user)" if group["manager"] == "user" else "")
        print(f"{label:<40} {pids:<18} {names:<20} {', '.join(dict.fromkeys(what))}")

    print("\nSuggested:")
    for group in groups:
        print(f"  {group['restart']}")
    return 1


# =============================================================================
# Persistence (weird persist)
# =============================================================================

PERSIST_ATTACK = {
    "systemd service": "T1543.002",
    "systemd timer": "T1053.006",
    "cron": "T1053.003",
    "autostart": "T1547.013",
    "shell rc": "T1546.004",
    "ld.so.preload": "T1574.006",
    "udev": "T1546",
    "pacman hook": "T1546",
    "libalpm hook": "T1546",
    "makepkg.conf": "T1195.001",
}
PERSIST_SEVERITY_ORDER = {"critical": 0, "medium": 1, "info": 2}
PERSIST_TEMP_PREFIXES = ("/tmp/", "/dev/shm/", "/var/tmp/")
PERSIST_PATH_DIRS = ("/usr/local/bin", "/usr/local/sbin", "/usr/bin", "/bin", "/usr/sbin", "/sbin")
# Sources where a hit means "user controlled code runs", which is worth a look but not an alarm
PERSIST_LOW_PRIORITY_SOURCES = ("shell rc", "makepkg.conf")
SYSTEMD_EXEC_KEYS = ("ExecStartPre", "ExecStart", "ExecStartPost", "ExecReload")
SYSTEMD_UNIT_DIRS = (
    "/etc/systemd/system", "/usr/lib/systemd/system", "/etc/systemd/user", "/usr/lib/systemd/user",
)
SHELL_NAMES = {"sh", "bash", "dash", "zsh", "fish", "ksh"}
SHELL_RC_FILES = ("~/.bashrc", "~/.zshrc", "~/.profile", "~/.bash_profile", "~/.config/fish/config.fish")
SYSTEM_RC_FILES = ("/etc/profile", "/etc/bash.bashrc")
MAKEPKG_KEYS = ("CC", "CXX", "LD", "STRIP", "BUILDENV", "PACKAGER")


@dataclass
class PersistEntry:
    """One thing the system will run on its own: where it is configured and what it launches."""
    source: str
    file: str
    key: str
    command: str
    target: str = ""
    inline: bool = False
    via: str = ""
    trust: str = ""
    provenance: str = ""
    integrity: str = ""
    severity: str = "info"
    attack: str = ""


def persist_home() -> str:
    return str(Path.home())


def under_home(path: str) -> bool:
    home = persist_home()
    return path == home or path.startswith(home + "/")


def persist_host_path(path: str) -> str:
    """Files under the home directory are read as they are; everything else goes through the sysroot."""
    return path if under_home(path) else sys_path(path)


def persist_expand_home(text: str) -> str:
    home = persist_home()
    if text == "~" or text.startswith("~/"):
        return home + text[1:]
    return text.replace("${HOME}", home).replace("$HOME", home)


def persist_read_lines(path: str) -> Optional[List[str]]:
    try:
        with open(persist_host_path(path), errors="replace") as f:
            return f.read().splitlines()
    except OSError:
        return None


def persist_list_files(directory: str, suffix: str = "") -> List[str]:
    """Regular files directly in a directory, sorted. Unreadable or missing directories give an empty list."""
    try:
        names = sorted(os.listdir(persist_host_path(directory)))
    except OSError:
        return []
    files = []
    for name in names:
        if suffix and not name.endswith(suffix):
            continue
        path = os.path.join(directory, name)
        if os.path.isfile(persist_host_path(path)):
            files.append(path)
    return files


def join_continuations(lines: List[str]) -> List[Tuple[int, str]]:
    """(line number, text) with backslash continuations joined onto their first line."""
    joined = []
    buf = ""
    start = 0
    for number, line in enumerate(lines, 1):
        if not buf:
            start = number
        if line.rstrip().endswith("\\"):
            buf += line.rstrip()[:-1] + " "
            continue
        joined.append((start, buf + line))
        buf = ""
    if buf:
        joined.append((start, buf))
    return joined


def parse_ini_lines(path: str) -> Optional[List[Tuple[str, str, str]]]:
    """(section, key, value) from a systemd unit, .desktop or pacman hook file. None when unreadable."""
    lines = persist_read_lines(path)
    if lines is None:
        return None
    fields = []
    section = ""
    for _, line in join_continuations(lines):
        line = line.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1]
            continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        fields.append((section, key.strip(), value.strip()))
    return fields


def split_command(text: str) -> List[str]:
    try:
        return shlex.split(text)
    except ValueError:
        return text.split()


def resolve_in_path(name: str, extra_dirs: Tuple[str, ...] = ()) -> str:
    """Absolute path for a bare command name, searched in the usual bin directories. Unchanged when not found."""
    if "/" in name:
        return name
    for directory in PERSIST_PATH_DIRS + extra_dirs:
        candidate = os.path.join(directory, name)
        if os.path.isfile(persist_host_path(candidate)):
            return candidate
    return name


def is_interpreter_name(name: str) -> bool:
    return name in INTERPRETERS or name in SHELL_NAMES or bool(re.match(r"^python\d", name))


def resolve_persist_command(command: str, extra_dirs: Tuple[str, ...] = ()) -> Tuple[str, bool, str]:
    """(target, inline, via) for the command line of a persistence entry.

    Strips the systemd prefixes (-, @, +, !, !!, :), leading VAR=value words
    and `env`. A shell or interpreter given -c (or -e) is an inline script and
    the target is the interpreter itself. An interpreter given a script path
    has that script as the target and the interpreter in `via`.
    """
    argv = split_command(command)
    if not argv:
        return "", False, ""
    at_form = argv[0].startswith("@")
    argv[0] = argv[0].lstrip("-@+!:")
    if at_form and len(argv) > 1:
        argv = [argv[0]] + argv[2:]
    while argv:
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", argv[0]):
            argv.pop(0)
        elif os.path.basename(argv[0]) == "env":
            argv.pop(0)
            while argv and argv[0].startswith("-"):
                option = argv.pop(0)
                if option in ("-u", "--unset", "-C", "--chdir", "-S", "--split-string") and argv:
                    argv.pop(0)
        else:
            break
    if not argv or not argv[0]:
        return "", False, ""
    exe = resolve_in_path(persist_expand_home(argv[0]), extra_dirs)
    name = os.path.basename(exe)
    if not is_interpreter_name(name):
        return exe, False, ""
    options = []
    script = ""
    for arg in argv[1:]:
        if arg.startswith("-") and len(arg) > 1:
            options.append(arg)
            continue
        script = persist_expand_home(arg)
        break
    if name in SHELL_NAMES:
        inline = any(o.startswith("-") and not o.startswith("--") and "c" in o for o in options)
    else:
        inline = any(o in ("-c", "-e") for o in options)
    if inline:
        return exe, True, ""
    if script.startswith("/"):
        return script, False, exe
    return exe, False, ""


def in_temp_dir(path: str) -> bool:
    return path.startswith(PERSIST_TEMP_PREFIXES) and not under_home(path)


_pristine_cache: Dict[str, bool] = {}


def persist_file_pristine(path: str) -> bool:
    """True when a config file is owned by a package and still matches the hash it was installed with."""
    if path not in _pristine_cache:
        package = file_package_cache.get(path)
        pristine = False
        if package:
            status, _ = verify_integrity(path, package, file_package_cache.get_manager(path) or "")
            pristine = status == "intact"
        _pristine_cache[path] = pristine
    return _pristine_cache[path]


def assess_persist_entry(entry: PersistEntry) -> None:
    """Fill trust, provenance, integrity and severity from the package provenance of the target."""
    entry.attack = PERSIST_ATTACK.get(entry.source, "")
    target = entry.target
    temp = in_temp_dir(entry.file) or in_temp_dir(target)
    notes = []
    if entry.inline:
        notes.append("inline script")
    if temp:
        notes.append("in a temporary directory")
    if not target:
        entry.trust = "UNKNOWN"
        notes.append(entry.provenance or "no target")
        entry.provenance = ", ".join(notes)
        entry.severity = "critical" if temp else "info"
        return
    if not os.path.exists(persist_host_path(target)):
        entry.trust = "UNKNOWN"
        notes.append("target does not exist")
        entry.provenance = ", ".join(notes)
        entry.severity = "critical" if temp else "info"
        return

    if under_home(target) and under_home(sys_realpath(target)):
        # nothing under the home directory is package owned; skip the pacman -Qo round trip
        level, info = TrustLevel.UNKNOWN, ProvenanceInfo(ownership="unowned", signature="unknown")
    else:
        level, info = verify_package_provenance(target)
    user_path = under_home(target) or is_user_local(target)
    if info.ownership == "owned" and info.package:
        notes.append(f"package {info.package} ({level.value.lower().replace('_', ' ')})")
        status, detail = verify_integrity(target, info.package, info.manager)
        entry.integrity = status
        if status == "modified":
            notes.append(f"integrity modified: {detail}")
        if user_path:
            level = TrustLevel.USER_LOCAL
            notes.append("launched through a user controlled path")
    else:
        notes.append("not owned by any package")
        if user_path:
            level = TrustLevel.USER_LOCAL
            notes.append("user path")
    if entry.via:
        notes.append(f"run by {entry.via}")
    entry.trust = level.value
    entry.provenance = ", ".join(notes)

    # an inline script in a file the distro shipped, unchanged, is the distro's script
    shipped_inline = entry.inline and persist_file_pristine(entry.file)
    if shipped_inline:
        notes.append("file unchanged since package install")
        entry.provenance = ", ".join(notes)
    if temp or entry.integrity == "modified" or level == TrustLevel.UNKNOWN:
        severity = "critical"
    elif (entry.inline and not shipped_inline) or level in (TrustLevel.LOCAL_BUILD, TrustLevel.USER_LOCAL, TrustLevel.USER_PKG):
        severity = "medium"
    else:
        severity = "info"
    if severity == "critical" and entry.source in PERSIST_LOW_PRIORITY_SOURCES and not temp \
            and entry.integrity != "modified":
        severity = "medium"
    entry.severity = severity


def expand_unit_specifiers(text: str) -> str:
    uid = os.getuid()
    subs = {
        "%h": persist_home(), "%u": get_username(uid), "%U": str(uid),
        "%H": socket.gethostname(), "%t": f"/run/user/{uid}", "%%": "%",
    }
    return re.sub(r"%[a-zA-Z%]", lambda m: subs.get(m.group(0), m.group(0)), text)


def systemd_unit_dirs() -> List[str]:
    return list(SYSTEMD_UNIT_DIRS) + [os.path.join(persist_home(), ".config/systemd/user")]


def find_unit_file(name: str) -> Optional[str]:
    for directory in systemd_unit_dirs():
        candidate = os.path.join(directory, name)
        if os.path.isfile(persist_host_path(candidate)):
            return candidate
    return None


def unit_exec_entries(unit_file: str, source: str, report_file: str, key_prefix: str = "") -> List[PersistEntry]:
    entries = []
    for section, key, value in parse_ini_lines(unit_file) or []:
        if section == "Service" and key in SYSTEMD_EXEC_KEYS and value:
            command = expand_unit_specifiers(value)
            target, inline, via = resolve_persist_command(command)
            entries.append(PersistEntry(source, report_file, key_prefix + key, command, target, inline, via))
    return entries


def persist_systemd_entries() -> List[PersistEntry]:
    entries = []
    seen = set()
    for directory in systemd_unit_dirs():
        for unit in persist_list_files(directory, ".service"):
            real = os.path.realpath(persist_host_path(unit))
            if real in seen:
                continue
            seen.add(real)
            entries += unit_exec_entries(unit, "systemd service", unit)
            for dropin in persist_list_files(unit + ".d", ".conf"):
                entries += unit_exec_entries(dropin, "systemd service", dropin)
        for timer in persist_list_files(directory, ".timer"):
            name = os.path.basename(timer)[:-len(".timer")] + ".service"
            for section, key, value in parse_ini_lines(timer) or []:
                if section == "Timer" and key == "Unit" and value:
                    name = value
            service = find_unit_file(name)
            if service is None:
                entries.append(PersistEntry("systemd timer", timer, "Unit", name,
                                            provenance=f"service unit {name} not found"))
                continue
            entries += unit_exec_entries(service, "systemd timer", timer, key_prefix=name + " ")
    return entries


def cron_command(line: str, system: bool) -> Optional[str]:
    """Command part of a crontab line. None for blanks, comments and variable assignments."""
    line = line.strip()
    if not line or line.startswith("#") or re.match(r"^[A-Za-z_][A-Za-z0-9_]*\s*=", line):
        return None
    time_fields = 1 if line.startswith("@") else 5
    parts = line.split(None, time_fields)
    if len(parts) <= time_fields:
        return None
    rest = parts[time_fields]
    if system:
        user_and_command = rest.split(None, 1)
        # a "user" that looks like a path is a broken line without the user field; still worth resolving
        if "/" not in user_and_command[0]:
            if len(user_and_command) < 2:
                return None
            rest = user_and_command[1]
    return re.split(r"(?<!\\)%", rest)[0].strip() or None


def persist_cron_entries() -> List[PersistEntry]:
    entries = []

    def add_crontab(path: str, system: bool, lines: Optional[List[str]]) -> bool:
        if lines is None:
            return False
        for number, line in enumerate(lines, 1):
            command = cron_command(line, system)
            if command is None:
                continue
            target, inline, via = resolve_persist_command(command)
            entries.append(PersistEntry("cron", path, f"line {number}", command, target, inline, via))
        return True

    add_crontab("/etc/crontab", True, persist_read_lines("/etc/crontab"))
    for path in persist_list_files("/etc/cron.d"):
        add_crontab(path, True, persist_read_lines(path))
    for period in ("hourly", "daily", "weekly", "monthly"):
        for script in persist_list_files(f"/etc/cron.{period}"):
            entries.append(PersistEntry("cron", script, "script", script, script))
    me = get_username(os.getuid())
    own_seen = False
    for spool in ("/var/spool/cron", "/var/spool/cron/crontabs"):
        for path in persist_list_files(spool):
            if add_crontab(path, False, persist_read_lines(path)) and os.path.basename(path) == me:
                own_seen = True
    if not own_seen:
        out = run_command(["crontab", "-l"])
        if out:
            add_crontab("crontab -l", False, out.splitlines())
    return entries


def persist_autostart_entries() -> List[PersistEntry]:
    entries = []
    for directory in ("/etc/xdg/autostart", os.path.join(persist_home(), ".config/autostart")):
        for path in persist_list_files(directory, ".desktop"):
            values = {k: v for section, k, v in parse_ini_lines(path) or [] if section == "Desktop Entry"}
            if values.get("Hidden", "").lower() == "true" or not values.get("Exec"):
                continue
            command = re.sub(r"%[a-zA-Z%]", "", values["Exec"]).strip()
            target, inline, via = resolve_persist_command(command)
            entries.append(PersistEntry("autostart", path, "Exec", command, target, inline, via))
    return entries


def shell_rc_hit(line: str) -> Optional[Tuple[str, str]]:
    """(kind, path) when a shell rc line sources or runs an absolute path that exists, else None."""
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    argv = split_command(line)
    if not argv:
        return None
    if argv[0] in ("source", ".") and len(argv) > 1:
        kind, path = "source", argv[1]
    else:
        kind, path = "exec", argv[0]
    path = persist_expand_home(path)
    if "$" in path or not path.startswith("/") or not os.path.isfile(persist_host_path(path)):
        return None
    return kind, path


def persist_shell_rc_entries() -> List[PersistEntry]:
    entries = []
    files = [persist_expand_home(f) for f in SHELL_RC_FILES] + list(SYSTEM_RC_FILES)
    files += persist_list_files("/etc/profile.d")
    for path in files:
        lines = persist_read_lines(path)
        # a packaged rc file that still matches its install hash only contains the distro's lines
        if lines is None or persist_file_pristine(path):
            continue
        for number, line in enumerate(lines, 1):
            hit = shell_rc_hit(line)
            if hit is None:
                continue
            kind, target = hit
            # sourcing a packaged file (completion, distro config) is how rc files are meant to work
            if kind == "source" and file_package_cache.get(target):
                continue
            entries.append(PersistEntry("shell rc", path, f"line {number} ({kind})", line.strip(), target))
    return entries


def persist_ld_preload_entries() -> List[PersistEntry]:
    entries = []
    lines = persist_read_lines("/etc/ld.so.preload")
    for number, line in enumerate(lines or [], 1):
        text = line.split("#", 1)[0].strip()
        for lib in re.split(r"[\s:]+", text):
            if lib:
                entries.append(PersistEntry("ld.so.preload", "/etc/ld.so.preload", f"line {number}", text, lib))
    return entries


def persist_udev_entries() -> List[PersistEntry]:
    entries = []
    pattern = re.compile(r'RUN(?:\{[^}]*\})?\s*[+:]?=\s*"((?:[^"\\]|\\.)*)"')
    for path in persist_list_files("/etc/udev/rules.d", ".rules"):
        for number, line in join_continuations(persist_read_lines(path) or []):
            if line.strip().startswith("#"):
                continue
            for match in pattern.finditer(line):
                command = match.group(1)
                target, inline, via = resolve_persist_command(command, extra_dirs=("/usr/lib/udev",))
                entries.append(PersistEntry("udev", path, f"line {number}", command, target, inline, via))
    return entries


def persist_pacman_hook_entries() -> List[PersistEntry]:
    entries = []
    for directory, source in (("/etc/pacman.d/hooks", "pacman hook"), ("/usr/share/libalpm/hooks", "libalpm hook")):
        for path in persist_list_files(directory, ".hook"):
            for section, key, value in parse_ini_lines(path) or []:
                if section == "Action" and key == "Exec" and value:
                    target, inline, via = resolve_persist_command(value)
                    entries.append(PersistEntry(source, path, "Exec", value, target, inline, via))
    return entries


def persist_makepkg_entries() -> List[PersistEntry]:
    """CC, CXX, LD, STRIP, BUILDENV or PACKAGER pointing at a path no package owns."""
    entries = []
    files = ["/etc/makepkg.conf"] + persist_list_files("/etc/makepkg.conf.d", ".conf")
    files.append(os.path.join(persist_home(), ".makepkg.conf"))
    pattern = re.compile(r"^\s*(?:export\s+)?(" + "|".join(MAKEPKG_KEYS) + r")=(.*)$")
    for path in files:
        for number, line in join_continuations(persist_read_lines(path) or []):
            match = pattern.match(line)
            if not match:
                continue
            key, value = match.group(1), match.group(2).strip()
            if value.startswith("(") and value.endswith(")"):
                value = value[1:-1]
            for word in split_command(value):
                word = persist_expand_home(word.lstrip("!"))
                if not word.startswith("/") or file_package_cache.get(word):
                    continue
                entries.append(PersistEntry("makepkg.conf", path, f"{key} (line {number})", line.strip(), word))
    return entries


PERSIST_COLLECTORS = (
    persist_systemd_entries, persist_cron_entries, persist_autostart_entries, persist_shell_rc_entries,
    persist_ld_preload_entries, persist_udev_entries, persist_pacman_hook_entries, persist_makepkg_entries,
)


# =============================================================================
# Round 2 persistence checks: PATH shadowing, SSH footholds, restart loops
# =============================================================================

PATH_SHADOW_WATCHLIST = ("sudo", "su", "ssh", "scp", "git", "pacman", "passwd", "doas", "gpg", "curl",
                         "wget", "python3", "bash", "ls", "cat", "systemctl")
PATH_SHADOW_SYSTEM_DIRS = ("/usr/bin", "/usr/sbin", "/bin", "/sbin")
SSH_KEY_RISKY_OPTIONS = ("agent-forwarding", "port-forwarding", "permitopen", "tunnel")
SSH_CONFIG_COMMAND_KEYS = ("proxycommand", "localcommand", "permitlocalcommand", "remotecommand")
RESTART_LOOP_MAX_SEC = 60


def user_writable_dir(path: str) -> bool:
    """A directory the current user can write to (own home, temp dirs, or world writable)."""
    try:
        st = os.stat(persist_host_path(path))
    except OSError:
        return False
    if under_home(path) or in_temp_dir(path):
        return True
    return bool(st.st_mode & 0o002) or (st.st_uid == os.getuid() and os.getuid() != 0)


def path_shadow_dirs() -> List[str]:
    """User-writable directories on PATH plus the usual personal bin dirs."""
    home = persist_home()
    candidates = [home + "/.local/bin", home + "/bin"]
    for entry in (os.environ.get("PATH") or "").split(":"):
        entry = persist_expand_home(entry.strip())
        if entry and entry not in candidates:
            candidates.append(entry)
    out = []
    for d in candidates:
        if d in out or d in PATH_SHADOW_SYSTEM_DIRS or not os.path.isdir(persist_host_path(d)):
            continue
        if under_home(d) or in_temp_dir(d) or user_writable_dir(d):
            out.append(d)
    return out


def system_binary_for(name: str) -> Optional[str]:
    for d in PATH_SHADOW_SYSTEM_DIRS:
        candidate = d + "/" + name
        if os.path.exists(sys_path(candidate)):
            return candidate
    return None


def persist_path_shadow_entries() -> List[PersistEntry]:
    """Files in user-writable PATH dirs that carry the name of a system binary on the watchlist."""
    entries = []
    for d in path_shadow_dirs():
        try:
            names = sorted(os.listdir(persist_host_path(d)))
        except OSError:
            continue
        for name in names:
            if name not in PATH_SHADOW_WATCHLIST:
                continue
            system = system_binary_for(name)
            if system is None:
                continue
            path = d + "/" + name
            host = persist_host_path(path)
            real = os.path.realpath(host)
            system_real = os.path.realpath(sys_path(system))
            entry = PersistEntry("path shadow", path, name, path, target=path, attack="T1036.005")
            if os.path.islink(host) and real == system_real:
                entry.trust, entry.severity = "OFFICIAL", "info"
                entry.provenance = f"symlink to {system}"
            else:
                entry.trust, entry.severity = "UNKNOWN", "critical"
                entry.provenance = f"shadows {system} on PATH"
            entries.append(entry)
    return entries


def ssh_path_suspicious(path: str) -> bool:
    path = persist_expand_home(path)
    if in_temp_dir(path):
        return True
    host = persist_host_path(path)
    if not os.path.exists(host):
        return True
    if under_home(path):
        return True
    file_package_cache.build()
    return pacman_owner(path) is None


def parse_authorized_key(line: str) -> Optional[Tuple[str, str, str]]:
    """(options, key type, comment) for one authorized_keys line; None for blanks and comments."""
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    m = re.match(r"^(?:(.*?)\s+)?((?:ssh|ecdsa|sk-)[\w@.-]+)\s+(\S+)(?:\s+(.*))?$", line)
    if not m:
        return None
    return (m.group(1) or "", m.group(2), (m.group(4) or "").strip())


def persist_ssh_foothold_entries() -> List[PersistEntry]:
    """authorized_keys entries with forced commands, forwarding options, wildcard from= or no comment,
    and ssh config commands that point at unowned or temp paths."""
    entries = []
    home = persist_home()
    for name in ("authorized_keys", "authorized_keys2"):
        path = f"{home}/.ssh/{name}"
        lines = persist_read_lines(path)
        if lines is None:
            if os.path.exists(os.path.dirname(path)) and os.path.exists(path):
                entries.append(PersistEntry("ssh key", path, name, "", trust="UNKNOWN",
                                            provenance="unavailable (unreadable)", attack="T1098.004"))
            continue
        for number, line in enumerate(lines, 1):
            parsed = parse_authorized_key(line)
            if parsed is None:
                continue
            options, keytype, comment = parsed
            notes, severity = [], ""
            opts = options.lower()
            m = re.search(r'command="([^"]*)"', options)
            if m:
                command = m.group(1)
                target = command.split()[0] if command.split() else ""
                if target and ssh_path_suspicious(target):
                    severity = "critical"
                    notes.append(f"forced command {command} runs from an unowned or temporary path")
                else:
                    severity = severity or "medium"
                    notes.append(f"forced command {command}")
            if any(o in opts for o in SSH_KEY_RISKY_OPTIONS):
                severity = severity or "medium"
                notes.append("forwarding or tunnel option set")
            m = re.search(r'from="([^"]*)"', options)
            if m and ("*" in m.group(1) or "?" in m.group(1)):
                severity = severity or "medium"
                notes.append(f"from={m.group(1)} is a wildcard")
            if not comment:
                severity = severity or "medium"
                notes.append("key has no comment, owner unknown")
            if not severity:
                continue
            entries.append(PersistEntry("ssh key", path, f"line {number} ({keytype})", line.strip()[:80],
                                        target="", trust="UNKNOWN", provenance=", ".join(notes),
                                        severity=severity, attack="T1098.004"))
    config = f"{home}/.ssh/config"
    for number, line in enumerate(persist_read_lines(config) or [], 1):
        parts = line.strip().replace("=", " ", 1).split(None, 1)
        if len(parts) < 2 or parts[0].lower() not in SSH_CONFIG_COMMAND_KEYS:
            continue
        key, value = parts[0], parts[1].strip()
        if key.lower() == "permitlocalcommand":
            if value.lower() == "yes":
                entries.append(PersistEntry("ssh config", config, f"line {number} {key}", value, trust="UNKNOWN",
                                            provenance="LocalCommand allowed", severity="medium", attack="T1098.004"))
            continue
        words = shlex.split(value) if value else []
        target = words[0] if words else ""
        if target and ("/" in target) and ssh_path_suspicious(target):
            entries.append(PersistEntry("ssh config", config, f"line {number} {key}", value, target=target,
                                        trust="UNKNOWN", provenance="command from an unowned or temporary path",
                                        severity="medium", attack="T1098.004"))
    return entries


def unit_restart_loop(unit_file: str) -> Optional[str]:
    """'Restart=always every 5s' when the unit restarts itself quickly, else None."""
    restart, restart_sec = "", "0"
    for section, key, value in parse_ini_lines(unit_file) or []:
        if section != "Service":
            continue
        if key == "Restart":
            restart = value.strip().lower()
        elif key == "RestartSec":
            restart_sec = value.strip()
    if restart not in ("always", "on-failure"):
        return None
    m = re.match(r"^(\d+(?:\.\d+)?)\s*(ms|msec|s|sec|seconds?|min|m|minutes?|h|hours?)?$", restart_sec)
    if not m:
        return None
    seconds = float(m.group(1))
    unit = m.group(2) or "s"
    if unit.startswith("m") and unit not in ("ms", "msec"):
        seconds *= 60
    elif unit.startswith("h"):
        seconds *= 3600
    elif unit in ("ms", "msec"):
        seconds /= 1000
    if seconds >= RESTART_LOOP_MAX_SEC:
        return None
    return f"Restart={restart} every {restart_sec or '0'}s"


def persist_apply_restart_loops(entries: List[PersistEntry]) -> None:
    """Raise systemd entries one severity step when a quick restart loop keeps a non-package target alive."""
    for entry in entries:
        if not entry.source.startswith("systemd") or entry.severity == "critical":
            continue
        if entry.trust not in ("UNKNOWN", "USER_LOCAL") and not in_temp_dir(entry.target or ""):
            continue
        loop = unit_restart_loop(entry.file)
        if loop is None:
            continue
        if entry.severity == "medium" and (entry.trust == "UNKNOWN" or in_temp_dir(entry.target or "")):
            entry.severity = "critical"
        elif entry.severity != "medium":
            entry.severity = "medium"
        entry.provenance = f"{entry.provenance}, restart loop keeps it alive ({loop})"
        entry.attack = "T1543.002"


PERSIST_EXTRA_COLLECTORS = (persist_path_shadow_entries, persist_ssh_foothold_entries)


def persist_extra_entries() -> List[PersistEntry]:
    """Entries whose severity is decided by their own collector, not by target provenance."""
    entries: List[PersistEntry] = []
    for collector in PERSIST_EXTRA_COLLECTORS:
        entries += collector()
    return entries


def collect_persistence() -> List[PersistEntry]:
    """Every persistence entry with its target assessed, critical first."""
    file_package_cache.build()
    entries: List[PersistEntry] = []
    for collector in PERSIST_COLLECTORS:
        entries += collector()
    for entry in entries:
        assess_persist_entry(entry)
    persist_apply_restart_loops(entries)
    entries += persist_extra_entries()
    entries.sort(key=lambda e: (PERSIST_SEVERITY_ORDER[e.severity], e.source, e.file, e.key))
    return entries


def persist_counts(entries: List[PersistEntry]) -> Dict[str, int]:
    counts = {level: 0 for level in PERSIST_SEVERITY_ORDER}
    for entry in entries:
        counts[entry.severity] += 1
    counts["total"] = len(entries)
    return counts


def persist_exit_code(entries: List[PersistEntry]) -> int:
    if any(e.severity == "critical" for e in entries):
        return 2
    if any(e.severity == "medium" for e in entries):
        return 1
    return 0


def shorten_path(path: str, width: int) -> str:
    home = persist_home()
    if path == home or path.startswith(home + "/"):
        path = "~" + path[len(home):]
    if len(path) <= width:
        return path
    return "..." + path[-(width - 3):]


def cmd_persist(args) -> int:
    """List persistence entries and the provenance of what they launch."""
    started = time.monotonic()
    warnings = self_check()
    entries = collect_persistence()
    counts = persist_counts(entries)
    note_counts(counts)
    code = persist_exit_code(entries)
    emit_findings_outputs(args, "persist", persist_findings(entries), started)
    if args.json:
        payload = {
            "host": socket.gethostname(),
            "timestamp": int(time.time()),
            "self_check": warnings,
            "self_integrity": _self_integrity,
            "entries": [asdict(e) for e in entries],
            "counts": counts,
        }
        print(json.dumps(payload, indent=2))
        return code
    print_self_check(warnings)

    show_all = getattr(args, "all", False) or getattr(args, "verbose", False)
    shown = [e for e in entries if show_all or e.severity != "info"]
    if shown:
        header = f"{'SOURCE':<16} {'FILE':<40} {'TARGET':<36} {'TRUST':<12} SEVERITY"
        print(header)
        print("-" * len(header))
        for entry in shown:
            print(f"{entry.source:<16} {shorten_path(entry.file, 40):<40} "
                  f"{shorten_path(entry.target, 36) if entry.target else '(none)':<36} "
                  f"{entry.trust:<12} {entry.severity}")
            if entry.severity != "info":
                print(f"{'':16} {entry.key}: {entry.command[:90]}")
                print(f"{'':16} {entry.provenance}"
                      + (f" [{entry.attack}]" if entry.attack else ""))
    else:
        print("Every persistence entry launches a packaged, intact executable.")
    tail = "" if show_all or not counts["info"] else " (-v lists the info entries)"
    print(f"\n{counts['total']} persistence entries checked: {counts['critical']} critical, "
          f"{counts['medium']} medium, {counts['info']} info{tail}")
    return code


# =============================================================================
# Findings shared by hidden, kernel and aur
# =============================================================================

FINDING_SEVERITY_ORDER = {"critical": 0, "medium": 1, "low": 2, "info": 3}
YELLOW = "\033[33m"
RESET = "\033[0m"


@dataclass
class Finding:
    kind: str
    detail: str
    severity: str
    attack: str = ""
    subject: str = ""


def sort_findings(findings: List[Finding]) -> None:
    findings.sort(key=lambda f: (FINDING_SEVERITY_ORDER[f.severity], f.subject, f.kind, f.detail))


_last_counts: Dict[str, int] = {}


def note_counts(counts: Dict[str, int]) -> None:
    """Severity counts of the section that just ran, read by the combined report."""
    _last_counts.clear()
    _last_counts.update(counts)


def finding_counts(findings: List[Finding]) -> Dict[str, int]:
    counts = {level: 0 for level in FINDING_SEVERITY_ORDER}
    for f in findings:
        counts[f.severity] += 1
    counts["total"] = len(findings)
    return counts


def findings_exit_code(findings: List[Finding]) -> int:
    if any(f.severity == "critical" for f in findings):
        return 2
    if any(f.severity == "medium" for f in findings):
        return 1
    return 0


def print_findings(findings: List[Finding], explanations: Optional[Dict[str, str]] = None,
                   subject_header: str = "") -> None:
    """KIND / DETAIL / SEVERITY rows, long details wrapped under the DETAIL column."""
    width = 24
    prefix = f"{subject_header:<22} " if subject_header else ""
    header = f"{prefix}{'KIND':<{width}} {'DETAIL':<64} SEVERITY"
    print(header)
    print("-" * len(header))
    for f in findings:
        lines = textwrap.wrap(f.detail, 64) or [""]
        tag = f" [{f.attack}]" if f.attack else ""
        first = f"{f.subject:<22} " if subject_header else ""
        print(f"{first}{f.kind:<{width}} {lines[0]:<64} {f.severity}{tag}")
        indent = " " * (len(prefix) + width + 1)
        for line in lines[1:]:
            print(f"{indent}{line}")
        why = (explanations or {}).get(f.kind)
        if why and f.severity != "info":
            for line in textwrap.wrap(why, 64):
                print(f"{indent}{line}")


def print_self_check(warnings: List[str]) -> None:
    if _self_check_shown:
        return
    for warning in warnings:
        print(f"{YELLOW}WARNING (self-check): {warning}{RESET}")
    if warnings:
        print()


def finding_payload(findings: List[Finding], **extra) -> Dict:
    payload = {"host": socket.gethostname(), "timestamp": int(time.time()), "self_integrity": _self_integrity}
    payload.update(extra)
    payload["findings"] = [asdict(f) for f in findings]
    payload["counts"] = finding_counts(findings)
    return payload


def persist_findings(entries: List[PersistEntry]) -> List[Finding]:
    """PersistEntry rows as Findings, for the journal and Prometheus outputs."""
    return [Finding(e.source, f"{e.key} in {e.file} runs {e.target or e.command} ({e.provenance})",
                    e.severity, e.attack, e.target) for e in entries]


# =============================================================================
# Output integrations: systemd journal and Prometheus textfile
# =============================================================================

JOURNAL_PRIORITY = {"critical": 2, "warning": 4, "medium": 4, "low": 5, "info": 6}
JOURNAL_SOCKET = "/run/systemd/journal/socket"
SYSLOG_LEVELS = {2: "crit", 4: "warning", 5: "notice", 6: "info"}


def journal_priority(severity: str) -> int:
    return JOURNAL_PRIORITY.get(severity, 6)


def _journal_socket_send(fields: Dict[str, str]) -> bool:
    """Native journald protocol: KEY=value lines on the journal datagram socket."""
    data = b""
    for key, value in fields.items():
        raw = value.encode()
        if b"\n" in raw:
            data += key.encode() + b"\n" + struct.pack("<Q", len(raw)) + raw + b"\n"
        else:
            data += key.encode() + b"=" + raw + b"\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
            sock.sendto(data, JOURNAL_SOCKET)
        return True
    except OSError:
        return False


def journal_send(fields: Dict) -> None:
    """Write one journal record with every field.

    systemd.journal when the module is installed, else the journald socket
    directly, else systemd-cat, else logger(1) (the last two keep MESSAGE and
    PRIORITY only). Tests replace this function.
    """
    fields = {k: str(v) for k, v in fields.items()}
    try:
        from systemd import journal
        journal.send(fields.pop("MESSAGE", ""), **fields)
        return
    except Exception:
        pass
    if _journal_socket_send(fields):
        return
    prio = int(fields.get("PRIORITY", "6"))
    message = fields.get("MESSAGE", "")
    if run_command(["systemd-cat", "-t", "weird", "-p", str(prio), "echo", message]) is not None:
        return
    run_command(["logger", "-t", "weird", "-p", f"user.{SYSLOG_LEVELS.get(prio, 'info')}", "--", message])


def journal_alerts(processes: List[ProcessInfo], alerts: List[Dict]) -> None:
    by_pid = {p.pid: p for p in processes}
    for alert in alerts:
        proc = by_pid.get(alert["pid"])
        if not proc:
            continue
        reason = proc.reasons[0] if proc.reasons else alert.get("reason", "")
        verdict = alert.get("verdict") or "Flagged"
        journal_send({
            "MESSAGE": f"weird: {verdict} {proc.name} pid {proc.pid} score {proc.weirdness_score}: {reason}",
            "PRIORITY": journal_priority(alert["severity"]),
            "SYSLOG_IDENTIFIER": "weird",
            "WEIRD_PID": proc.pid,
            "WEIRD_NAME": proc.name,
            "WEIRD_SCORE": proc.weirdness_score,
            "WEIRD_TRUST": proc.trust_level.value,
            "WEIRD_ATTACK": ",".join(proc.attack),
            "WEIRD_VERDICT": verdict,
        })


def journal_findings(command: str, findings: List[Finding]) -> None:
    for f in findings:
        if f.severity == "info":
            continue
        subject = f" {f.subject}" if f.subject else ""
        journal_send({
            "MESSAGE": f"weird {command}: {f.severity} {f.kind}{subject}: {f.detail}",
            "PRIORITY": journal_priority(f.severity),
            "SYSLOG_IDENTIFIER": "weird",
            "WEIRD_COMMAND": command,
            "WEIRD_KIND": f.kind,
            "WEIRD_SEVERITY": f.severity,
            "WEIRD_SUBJECT": f.subject,
            "WEIRD_ATTACK": f.attack,
        })


def prometheus_lines(name: str, help_text: str, samples: List[Tuple[str, object]]) -> List[str]:
    lines = [f"# HELP {name} {help_text}", f"# TYPE {name} gauge"]
    for labels, value in samples:
        lines.append(f"{name}{labels} {value}")
    return lines


def prometheus_scan_text(alerts: List[Dict], processes_total: int, timestamp: int, duration: float) -> str:
    counts = {"critical": 0, "warning": 0}
    for alert in alerts:
        counts[alert["severity"]] = counts.get(alert["severity"], 0) + 1
    lines = prometheus_lines("weird_alerts", "Alerts from the last weird scan by level.",
                             [(f'{{level="{level}"}}', counts[level]) for level in ("critical", "warning")])
    lines += prometheus_lines("weird_processes_total", "Processes examined by the last weird scan.",
                              [("", processes_total)])
    lines += prometheus_lines("weird_scan_timestamp_seconds", "Unix time of the last weird scan.",
                              [("", timestamp)])
    lines += prometheus_lines("weird_scan_duration_seconds", "Wall clock seconds the last weird scan took.",
                              [("", f"{duration:.3f}")])
    return "\n".join(lines) + "\n"


def prometheus_findings_text(command: str, counts: Dict[str, int], timestamp: int, duration: float) -> str:
    lines = prometheus_lines("weird_findings", "Findings from the last run of a weird subcommand by severity.",
                             [(f'{{command="{command}",severity="{s}"}}', counts.get(s, 0))
                              for s in FINDING_SEVERITY_ORDER])
    lines += prometheus_lines("weird_scan_timestamp_seconds", "Unix time of the last weird scan.",
                              [(f'{{command="{command}"}}', timestamp)])
    lines += prometheus_lines("weird_scan_duration_seconds", "Wall clock seconds the last weird scan took.",
                              [(f'{{command="{command}"}}', f"{duration:.3f}")])
    return "\n".join(lines) + "\n"


def write_prometheus(path: str, text: str) -> bool:
    """node_exporter textfile: written to a temp file in the same directory, then renamed over PATH."""
    path = os.path.abspath(path)
    directory = os.path.dirname(path)
    temp = None
    try:
        os.makedirs(directory, exist_ok=True)
        fd, temp = tempfile.mkstemp(prefix=".weird-", suffix=".tmp", dir=directory)
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(temp, 0o644)
        os.replace(temp, path)
        return True
    except OSError as e:
        if temp and os.path.exists(temp):
            os.unlink(temp)
        print(f"Warning: could not write {path}: {e}", file=sys.stderr)
        return False


def emit_findings_outputs(args, command: str, findings: List[Finding], started: float) -> None:
    """--journal and --prometheus for the subcommands that produce findings."""
    if getattr(args, "journal", False):
        journal_findings(command, findings)
    path = getattr(args, "prometheus", None)
    if path:
        write_prometheus(path, prometheus_findings_text(
            command, finding_counts(findings), int(time.time()), time.monotonic() - started))


# =============================================================================
# Startup self-check and hidden processes (weird hidden)
# =============================================================================

PID_MAX_DEFAULT = 32768
PID_MAX_CAP = 4194304
NET_SOCKET_TABLES = ("tcp", "tcp6", "udp", "udp6")
HIDDEN_EXPLANATIONS = {
    "hidden pid": "A rootkit that filters the /proc directory listing hides a process from ps and top, "
                  "but /proc/<pid>/stat still answers a direct stat. This is what unhide does.",
    "hidden socket": "The kernel reports sockets two ways: /proc/net/* and the netlink sock_diag "
                     "interface ss uses. A hook on one path leaves the socket visible on the other.",
    "thread count mismatch": "The Threads: line in status comes from the task counter; /proc/<pid>/task "
                             "is a directory listing. A hidden thread shows up as a difference.",
    "loadavg mismatch": "The fourth field of /proc/loadavg is the kernel's own task count. A gap "
                        "larger than normal churn means tasks exist that the listing does not show.",
}


def self_check() -> List[str]:
    """Signs that weird itself runs under an injected library. Warnings only, never blocks a run."""
    if PROC_ROOT != "/proc":
        return []
    warnings = []
    try:
        preload = Path(sys_path("/etc/ld.so.preload")).read_text().strip()
    except OSError:
        preload = ""
    if preload:
        warnings.append(f"/etc/ld.so.preload is active ({preload.split()[0]}): every process, "
                        "this scan included, loads it first")
    for var in ("LD_PRELOAD", "LD_AUDIT"):
        if os.environ.get(var):
            warnings.append(f"{var}={os.environ[var]} is set in weird's own environment: "
                            "results can be tampered with")
    if SYSROOT != "/":
        return warnings
    file_package_cache.build()
    own = {sys.prefix, sys.base_prefix, sys.exec_prefix, sys.base_exec_prefix} - {"/usr", "/"}
    prefixes = tuple(p.rstrip("/") + "/" for p in own)
    for pathname in exec_file_mappings(os.getpid()) or []:
        mapped = pathname[:-len(" (deleted)")] if pathname.endswith(" (deleted)") else pathname
        if mapped.startswith("/memfd:") or (prefixes and mapped.startswith(prefixes)):
            continue
        if file_package_cache.get(mapped):
            continue
        warnings.append(f"{mapped} is mapped executable in this process but no package owns it")
    return warnings


def list_pids_readdir() -> Set[int]:
    """Pids as the /proc directory listing shows them (the view a readdir hook filters)."""
    try:
        names = os.listdir(PROC_ROOT)
    except OSError:
        return set()
    return {int(n) for n in names if n.isdigit()}


def probe_pid(pid: int) -> bool:
    """True when /proc/<pid>/stat answers a direct stat, listed or not."""
    try:
        os.stat("%s/%d/stat" % (PROC_ROOT, pid))
        return True
    except OSError:
        return False


def read_pid_max() -> int:
    try:
        with open(proc_path("sys", "kernel", "pid_max")) as f:
            value = int(f.read().strip())
    except (OSError, ValueError):
        return PID_MAX_DEFAULT
    return max(1, min(value, PID_MAX_CAP))


def status_int(pid: int, name: str) -> Optional[int]:
    try:
        return int(read_status_fields(pid, (name,)).get(name, ""))
    except ValueError:
        return None


def find_hidden_pids(listed: Optional[Set[int]] = None) -> List[Dict]:
    """Pids that answer a direct stat but are absent from the listing, confirmed a second time.

    Thread ids also have a /proc entry without being listed, so a hit whose
    Tgid is another pid is a thread, not a hidden process.
    """
    if listed is None:
        listed = list_pids_readdir()
    hidden = []
    for pid in range(1, read_pid_max() + 1):
        if pid in listed:
            if getpgid_probe(pid) is False and pid_interface_mismatch(pid) == "proc only":
                hidden.append({"pid": pid, "name": _get_process_name(pid) or "?", "ppid": status_int(pid, "PPid"),
                               "uid": status_int(pid, "Uid"), "mismatch": "proc only"})
            continue
        if not probe_pid(pid):
            if getpgid_probe(pid) and pid_interface_mismatch(pid) == "getpgid only":
                hidden.append({"pid": pid, "name": "?", "ppid": None, "uid": None, "mismatch": "getpgid only"})
            continue
        if pid_interface_mismatch(pid) == "proc only":
            hidden.append({"pid": pid, "name": _get_process_name(pid) or "?", "ppid": status_int(pid, "PPid"),
                           "uid": status_int(pid, "Uid"), "mismatch": "proc only"})
            continue
        tgid = status_int(pid, "Tgid")
        if tgid is not None and tgid != pid:
            continue
        if pid in list_pids_readdir() or not probe_pid(pid):
            continue
        hidden.append({"pid": pid, "name": _get_process_name(pid) or "?",
                       "ppid": status_int(pid, "PPid"), "uid": status_int(pid, "Uid")})
    return hidden


def procfs_socket_inodes() -> Dict[int, str]:
    """inode -> description for every socket in /proc/net/{tcp,tcp6,udp,udp6} that has an inode."""
    sockets: Dict[int, str] = {}
    for table in NET_SOCKET_TABLES:
        try:
            with open(proc_path("net", table)) as f:
                lines = f.read().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            parts = line.split()
            if len(parts) < 10:
                continue
            try:
                inode = int(parts[9])
            except ValueError:
                continue
            if inode == 0:
                continue
            local = parse_hex_address(parts[1])
            remote = parse_hex_address(parts[2])
            state = decode_tcp_state(parts[3]) if table.startswith("tcp") else ""
            sockets[inode] = f"{table} {local[0]}:{local[1]} -> {remote[0]}:{remote[1]} {state}".rstrip()
    return sockets


def ss_socket_inodes() -> Optional[Dict[int, str]]:
    """inode -> description from `ss -tunapHe` (netlink sock_diag), None when ss cannot be used."""
    out = run_command(["ss", "-tunapHe"])
    if out is None:
        return None
    sockets: Dict[int, str] = {}
    for line in out.splitlines():
        m = re.search(r"\bino:(\d+)", line)
        if not m:
            continue
        inode = int(m.group(1))
        if inode == 0:
            continue
        parts = line.split()
        text = f"{parts[0]} {parts[4]} -> {parts[5]} {parts[1]}" if len(parts) >= 6 else line.strip()
        owner = re.search(r'users:\(\("([^"]+)",pid=(\d+)', line)
        if owner:
            text += f" pid {owner.group(2)} ({owner.group(1)})"
        sockets[inode] = text
    if not sockets and out.strip() and "ino:" not in out:
        return None
    return sockets


def socket_view_findings() -> List[Finding]:
    """Sockets that only one of /proc/net and netlink reports. Read /proc twice so churn is not a hit."""
    before = procfs_socket_inodes()
    from_ss = ss_socket_inodes()
    if from_ss is None:
        return [Finding("socket cross-view", "skipped: ss unavailable or prints no inode column (iproute2 ss -e)", "info")]
    after = procfs_socket_inodes()
    findings = []
    for inode in sorted(set(from_ss) - set(before) - set(after)):
        findings.append(Finding("hidden socket", f"inode {inode} ({from_ss[inode]}) reported by ss over "
                                "netlink but absent from /proc/net", "critical", "T1014"))
    for inode in sorted((set(before) & set(after)) - set(from_ss)):
        findings.append(Finding("hidden socket", f"inode {inode} ({before[inode]}) listed in /proc/net "
                                "but not reported by ss", "critical", "T1014"))
    return findings


def thread_view_findings(listed: Set[int]) -> Tuple[List[Finding], int]:
    """(findings, total threads seen) comparing Threads: in status with the task directory listing."""
    findings = []
    total = 0
    for pid in sorted(listed):
        first = status_int(pid, "Threads")
        if first is None:
            continue
        total += first
        try:
            tasks = sum(1 for n in os.listdir(proc_path(pid, "task")) if n.isdigit())
        except OSError:
            continue
        if tasks == first:
            continue
        second = status_int(pid, "Threads")
        if second != first or second == tasks:
            continue
        findings.append(Finding("thread count mismatch", f"pid {pid} ({_get_process_name(pid) or '?'}): "
                                f"status says {first} threads, /proc/{pid}/task lists {tasks}",
                                "medium", "T1564.001"))
    return findings, total


def read_loadavg_tasks() -> Optional[int]:
    try:
        with open(proc_path("loadavg")) as f:
            return int(f.read().split()[3].split("/")[1])
    except (OSError, ValueError, IndexError):
        return None


def loadavg_finding(counted: int, before: Optional[int], after: Optional[int]) -> Optional[Finding]:
    """Low finding when the kernel's task total is further from the count than normal churn explains."""
    if before is None or after is None:
        return None
    low, high = min(before, after), max(before, after)
    margin = max(10, high // 20)
    if low - margin <= counted <= high + margin:
        return None
    return Finding("loadavg mismatch", f"/proc/loadavg reports {before} tasks ({after} after the walk), "
                   f"{counted} threads counted across the listed pids", "low", "T1564.001")


# =============================================================================
# Round 2 hidden checks: bind mounts over /proc, second pid interface
# =============================================================================

def read_mountinfo() -> Optional[List[Tuple[str, str]]]:
    """(mount point, filesystem type) rows from /proc/self/mountinfo."""
    try:
        with open(proc_path("self", "mountinfo")) as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    rows = []
    for line in lines:
        parts = line.split()
        if len(parts) < 7 or "-" not in parts:
            continue
        point = parts[4].replace("\\040", " ")
        tail = parts[parts.index("-") + 1:]
        rows.append((point, tail[0] if tail else "?"))
    return rows


def proc_mount_findings() -> List[Finding]:
    """Mounts placed over /proc/<pid> hide that pid from every /proc reader; a non-proc mount on /proc hides everything."""
    rows = read_mountinfo()
    if rows is None:
        return [Finding("proc mounts", "mountinfo unavailable", "info")]
    findings = []
    for point, fstype in rows:
        if point == "/proc" and fstype != "proc":
            findings.append(Finding("proc mounts", f"/proc is mounted as {fstype}, not proc: the process table "
                                    "is a substitute", "critical", "T1564"))
        m = re.match(r"^/proc/(\d+)(/.*)?$", point)
        if m:
            findings.append(Finding("proc mounts", f"{fstype} mount over {point}: hides pid {m.group(1)} "
                                    "from every /proc reader", "critical", "T1564"))
    return findings


def getpgid_probe(pid: int) -> Optional[bool]:
    """Whether the kernel knows the pid, asked through getpgid instead of /proc. None on a replayed tree."""
    if PROC_ROOT != "/proc":
        return None
    try:
        os.getpgid(pid)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return None


def pid_interface_mismatch(pid: int) -> Optional[str]:
    """'proc only' or 'getpgid only' when /proc and getpgid disagree twice in a row, else None."""
    for _ in range(2):
        in_proc = probe_pid(pid)
        in_kernel = getpgid_probe(pid)
        if in_kernel is None or in_proc == in_kernel:
            return None
    return "proc only" if in_proc else "getpgid only"


def cmd_hidden(args) -> int:
    """Cross-view checks for hidden processes, threads and sockets."""
    started = time.monotonic()
    warnings = self_check()
    listed = list_pids_readdir()
    pid_max = read_pid_max()
    load_before = read_loadavg_tasks()
    hidden = find_hidden_pids(listed)
    findings = [Finding("hidden pid", f"pid {h['pid']} ({h['name']}): present in /proc but absent from "
                        "the directory listing", "critical", "T1564.001") for h in hidden if not h.get("mismatch")]
    findings += [Finding("hidden pid", f"pid {h['pid']} ({h['name']}): visible to one kernel interface but not "
                         f"the other ({h['mismatch']})", "critical", "T1564.001") for h in hidden if h.get("mismatch")]
    findings += proc_mount_findings()
    if PROC_ROOT == "/proc":
        findings += socket_view_findings()
    else:
        findings.append(Finding("socket cross-view", "skipped on a replayed /proc tree (ss reads the live kernel)", "info"))
    thread_findings, counted = thread_view_findings(listed)
    findings += thread_findings
    load = loadavg_finding(counted, load_before, read_loadavg_tasks())
    if load:
        findings.append(load)
    sort_findings(findings)
    note_counts(finding_counts(findings))
    code = findings_exit_code(findings)
    emit_findings_outputs(args, "hidden", findings, started)

    if args.json:
        print(json.dumps(finding_payload(findings, self_check=warnings, pid_max=pid_max,
                                         listed_pids=len(listed), hidden_pids=hidden), indent=2))
        return code
    print_self_check(warnings)
    shown = [f for f in findings if f.severity != "info"]
    if shown:
        print_findings(shown, HIDDEN_EXPLANATIONS)
    else:
        print("Every pid, thread and socket the kernel knows about is also visible through the normal listings.")
    for f in findings:
        if f.severity == "info":
            print(f"note: {f.kind}: {f.detail}")
    counts = finding_counts(findings)
    print(f"\n{len(listed)} pids listed, pids 1..{pid_max} probed: {counts['critical']} critical, "
          f"{counts['medium']} medium, {counts['low']} low")
    return code


# =============================================================================
# Kernel and modules (weird kernel)
# =============================================================================

MODULE_SUFFIXES = (".ko", ".ko.zst", ".ko.xz", ".ko.gz")
KALLSYMS_PSEUDO_MODULES = {"bpf"}
TAINT_FLAGS = {
    0: "proprietary module loaded",
    1: "module force loaded",
    2: "kernel running on an out of spec system",
    3: "module force unloaded",
    4: "machine check exception",
    5: "bad page referenced",
    6: "taint requested by user space",
    7: "kernel died recently (oops or bug)",
    8: "ACPI table overridden by user",
    9: "kernel warning issued",
    10: "staging driver loaded",
    11: "firmware workaround applied",
    12: "out-of-tree module loaded",
    13: "unsigned module loaded",
    14: "soft lockup occurred",
    15: "kernel live patched",
    16: "auxiliary taint",
    17: "struct randomization plugin",
    18: "in-kernel test run",
    19: "firmware bug",
}
EBPF_HOOK_HINTS = ("getdents", "tcp4_seq", "tcp6_seq", "udp4_seq", "udp6_seq", "seq_show", "filldir")
KERNEL_EXPLANATIONS = {
    "module view mismatch": "A loaded module lives in /proc/modules, /sys/module and the kallsyms symbol "
                            "table at once. A rootkit that unlinks itself from the module list stays in the "
                            "others.",
    "unowned module": "Every module of a packaged kernel is owned by a package. A loaded module whose "
                      "file is not, or is missing, was built or dropped here by hand.",
    "unsigned module": "Taint bit 13: a module without a valid signature was loaded. Expected with "
                       "dkms or out-of-tree drivers, otherwise worth a look.",
    "out-of-tree module": "Taint bit 12: a module not built with the kernel was loaded.",
}


def running_kernel() -> str:
    return os.uname().release


def read_proc_modules() -> Dict[str, Dict[str, str]]:
    """name -> {size, refcount, state} from /proc/modules."""
    modules: Dict[str, Dict[str, str]] = {}
    try:
        with open(proc_path("modules")) as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 5:
                    modules[parts[0]] = {"size": parts[1], "refcount": parts[2], "state": parts[4]}
    except OSError:
        pass
    return modules


def sys_module_names() -> Set[str]:
    """Loadable modules under /sys/module (builtins have no coresize or initstate file)."""
    base = sys_path("/sys/module")
    try:
        names = os.listdir(base)
    except OSError:
        return set()
    return {n for n in names
            if os.path.exists(os.path.join(base, n, "coresize")) or os.path.exists(os.path.join(base, n, "initstate"))}


def kallsyms_module_names() -> Optional[Set[str]]:
    """Module names from the [name] suffix in /proc/kallsyms, None when unreadable or empty."""
    names: Set[str] = set()
    try:
        with open(proc_path("kallsyms")) as f:
            for line in f:
                line = line.rstrip()
                if line.endswith("]") and "[" in line:
                    names.add(line[line.rindex("[") + 1:-1])
    except OSError:
        return None
    return (names - KALLSYMS_PSEUDO_MODULES) or None


def module_file_index(release: str) -> Optional[Dict[str, str]]:
    """module name -> host path of its .ko file under /usr/lib/modules/<release>, None when the tree is missing."""
    root = f"/usr/lib/modules/{release}"
    base = sys_path(root)
    if not os.path.isdir(base):
        return None
    index: Dict[str, str] = {}
    for dirpath, _, filenames in os.walk(base):
        rel = os.path.relpath(dirpath, base)
        for filename in filenames:
            for suffix in MODULE_SUFFIXES:
                if filename.endswith(suffix):
                    name = filename[:-len(suffix)].replace("-", "_")
                    index[name] = os.path.join(root, "" if rel == "." else rel, filename)
                    break
    return index


def installed_kernels() -> List[Tuple[str, Optional[str]]]:
    """(release, owning package) for every tree under /usr/lib/modules."""
    base = sys_path("/usr/lib/modules")
    try:
        releases = sorted(n for n in os.listdir(base) if os.path.isdir(os.path.join(base, n)))
    except OSError:
        return []
    kernels = []
    for release in releases:
        owner = None
        for candidate in (f"/usr/lib/modules/{release}/vmlinuz", f"/usr/lib/modules/{release}/pkgbase",
                          f"/boot/vmlinuz-{release}"):
            owner = file_package_cache.get(candidate)
            if owner:
                break
        kernels.append((release, owner))
    return kernels


def dkms_source_package(name: str) -> Optional[Tuple[str, str]]:
    """(source dir, package) when a dkms source tree for this module is owned by a package."""
    base = sys_path("/usr/src")
    for candidate in dict.fromkeys((name, name.replace("_", "-"))):
        for conf in sorted(glob.glob(os.path.join(base, glob.escape(candidate) + "-*", "dkms.conf"))):
            host = "/usr/src/" + os.path.relpath(conf, base)
            owner = file_package_cache.get(host)
            if owner:
                return os.path.dirname(host), owner
    return None


def module_findings() -> Tuple[List[Finding], Dict]:
    """Cross-view and ownership checks for loaded modules, plus a summary for JSON."""
    file_package_cache.build()
    release = running_kernel()
    loaded = read_proc_modules()
    in_sys = sys_module_names()
    in_kallsyms = kallsyms_module_names()
    findings: List[Finding] = []
    summary: Dict = {"release": release, "loaded": len(loaded), "sys_module": len(in_sys),
                     "kallsyms": None if in_kallsyms is None else len(in_kallsyms),
                     "owned": 0, "dkms": 0, "unowned": [], "reboot_pending": False}

    views = {"/proc/modules": set(loaded), "/sys/module": in_sys}
    if in_kallsyms is not None:
        views["kallsyms"] = in_kallsyms
    else:
        findings.append(Finding("module cross-view", "kallsyms unreadable or empty (kptr_restrict, not root): "
                                "only /proc/modules and /sys/module compared", "info"))
    everything = set().union(*views.values())
    for name in sorted(everything):
        present = [v for v, names in views.items() if name in names]
        missing = [v for v in views if name not in views[v]]
        if missing:
            findings.append(Finding("module view mismatch", f"{name}: in {', '.join(present)} but not in "
                                    f"{', '.join(missing)}", "critical", "T1014", subject=name))

    index = module_file_index(release)
    kernels = installed_kernels()
    if index is None:
        others = [(r, p) for r, p in kernels if r != release]
        if others:
            installed = ", ".join(f"{r} ({p or 'unpackaged'})" for r, p in others)
            findings.append(Finding("reboot pending", f"/usr/lib/modules/{release} is gone; running {release}, "
                                    f"installed {installed}. Modules cannot be checked until reboot.", "info"))
            summary["reboot_pending"] = True
        else:
            findings.append(Finding("module files", f"/usr/lib/modules/{release} missing and no other kernel "
                                    "installed: module ownership not checked", "info"))
        return findings, summary

    for name in sorted(loaded):
        path = index.get(name)
        if path is None:
            findings.append(Finding("unowned module", f"{name} is loaded but no {name}.ko exists under "
                                    f"/usr/lib/modules/{release} (loaded from elsewhere, then removed?)",
                                    "critical", "T1014", subject=name))
            summary["unowned"].append(name)
            continue
        owner = file_package_cache.get(path)
        if owner:
            summary["owned"] += 1
            continue
        dkms = dkms_source_package(name)
        if dkms:
            summary["dkms"] += 1
            findings.append(Finding("dkms module", f"{name}: {path} built by dkms from {dkms[0]} "
                                    f"(package {dkms[1]}), unsigned by design", "info", subject=name))
            continue
        findings.append(Finding("unowned module", f"{name}: {path} is not owned by any package",
                                "critical", "T1014", subject=name))
        summary["unowned"].append(name)
    return findings, summary


def read_taint() -> Optional[int]:
    try:
        with open(proc_path("sys", "kernel", "tainted")) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def decode_taint(value: int) -> List[Tuple[int, str]]:
    return [(bit, text) for bit, text in TAINT_FLAGS.items() if value & (1 << bit)]


def taint_findings(value: Optional[int], unowned: bool) -> List[Finding]:
    if not value:
        return []
    findings = []
    for bit, text in decode_taint(value):
        detail = f"{text} (bit {bit})"
        if bit == 13:
            findings.append(Finding("unsigned module", detail, "medium", "T1014"))
        elif bit == 12:
            severity = "medium" if unowned else "low"
            if unowned:
                detail += ", and an unowned module is loaded"
            findings.append(Finding("out-of-tree module", detail, severity, "T1014" if unowned else ""))
        else:
            findings.append(Finding("kernel taint", detail, "info"))
    return findings


def read_sysctl(*parts) -> Optional[str]:
    try:
        with open(proc_path("sys", "kernel", *parts)) as f:
            return f.read().strip()
    except OSError:
        return None


def secure_boot_state() -> str:
    """'enabled', 'disabled' or 'unknown (not EFI)' from the SecureBoot efivar (last byte is the value)."""
    matches = glob.glob(sys_path("/sys/firmware/efi/efivars/SecureBoot-*"))
    for path in matches:
        try:
            data = Path(path).read_bytes()
        except OSError:
            continue
        if data:
            return "enabled" if data[-1] == 1 else "disabled"
    return "unknown (not EFI)"


def lockdown_state() -> str:
    try:
        text = Path(sys_path("/sys/kernel/security/lockdown")).read_text()
    except OSError:
        return "unavailable"
    m = re.search(r"\[(\w+)\]", text)
    return m.group(1) if m else text.strip() or "unavailable"


def sig_enforce_state() -> str:
    try:
        return Path(sys_path("/sys/module/module/parameters/sig_enforce")).read_text().strip() or "unavailable"
    except OSError:
        return "unavailable"


SENSOR_EVENTS_FILE = "/run/weird/events.ndjson"
SENSOR_FRESH_SECONDS = 120


def lkrg_state() -> str:
    """Linux Kernel Runtime Guard: 'active' when its module is loaded, else 'not present'."""
    if os.path.isdir(sys_path("/sys/module/lkrg")) or "lkrg" in read_proc_modules():
        return "active"
    return "not present"


def sensor_state() -> str:
    """The eBPF sensor is 'active' while its event file was written in the last two minutes."""
    try:
        age = time.time() - os.stat(sys_path(SENSOR_EVENTS_FILE)).st_mtime
    except OSError:
        return "not running"
    return "active" if age <= SENSOR_FRESH_SECONDS else "not running"


def sensor_hello(path: Optional[str] = None) -> Optional[Dict]:
    """The hello event on the first line of the sensor's events file, None when absent or unreadable."""
    try:
        with open(path or sys_path(SENSOR_EVENTS_FILE), encoding="utf-8", errors="replace") as f:
            event = json.loads(f.readline())
    except (OSError, ValueError):
        return None
    return event if isinstance(event, dict) and event.get("kind") == "hello" else None


def sensor_row(posture: Dict[str, str]) -> str:
    """Posture text for the sensor: state, then version and schema from the hello when it is active."""
    value = posture["sensor"]
    if posture.get("sensor_version"):
        value += f" (weird-sensor {posture['sensor_version']}, schema v{posture.get('sensor_schema')})"
    return value


def posture_findings(posture: Dict[str, str]) -> List[Finding]:
    _, findings = helper_posture()
    if posture["module_loading"] == "open" and posture["lkrg"] == "not present":
        return findings + [Finding("hardening", "module loading is open and LKRG is not present: enforce signed modules "
                        "(module.sig_enforce=1 or lockdown=integrity) or install LKRG to detect kernel "
                        "modifications at runtime; for a one-off root check of the syscall table, ftrace "
                        "and BPF objects run ghostscan (github.com/aidlx/ghostscan)", "info")]
    return findings


# =============================================================================
# Round 2 kernel checks: core_pattern, modprobe helper, kernel command line
# =============================================================================

CORE_HANDLERS_KNOWN = ("/usr/lib/systemd/systemd-coredump", "/lib/systemd/systemd-coredump",
                       "/usr/share/apport/apport", "/usr/lib/apport/apport")
MODPROBE_HELPERS_KNOWN = ("/sbin/modprobe", "/usr/sbin/modprobe", "/usr/bin/modprobe", "/usr/bin/kmod",
                          "/bin/kmod", "/sbin/kmod")
INIT_PATHS_KNOWN = ("/sbin/init", "/usr/lib/systemd/systemd", "/lib/systemd/systemd", "/bin/init",
                    "/usr/bin/init", "/init", "/bin/systemd", "/usr/sbin/init")


def handler_path_bad(path: str) -> Optional[str]:
    """Why a kernel helper path is unsafe: temp dir, missing, user writable or unowned. None when fine."""
    if not path or not path.startswith("/"):
        return "not an absolute path"
    if in_temp_dir(path):
        return "in a temporary directory"
    host = sys_path(path)
    if not os.path.exists(host):
        return "path does not exist"
    try:
        st = os.stat(host)
        if st.st_mode & 0o002 or (SYSROOT == "/" and st.st_uid != 0 and st.st_uid == os.getuid()):
            return "user writable"
    except OSError:
        return "unreadable"
    file_package_cache.build()
    if pacman_owner(path) is None and os.path.realpath(host) in (os.path.realpath(sys_path(p))
                                                                for p in CORE_HANDLERS_KNOWN + MODPROBE_HELPERS_KNOWN):
        return None
    if pacman_owner(path) is None:
        return "not owned by any package"
    return None


def core_pattern_state() -> Tuple[str, Optional[Finding]]:
    value = read_sysctl("core_pattern")
    if value is None:
        return "unavailable", None
    if not value.startswith("|"):
        return f"file {value}" if value else "disabled", None
    handler = value[1:].split()[0] if value[1:].split() else ""
    if handler in CORE_HANDLERS_KNOWN or os.path.realpath(sys_path(handler)) in CORE_HANDLERS_KNOWN:
        return f"piped to {handler}", None
    why = handler_path_bad(handler)
    if why is None:
        return f"piped to {handler}", Finding("core dump handler", f"core_pattern pipes crashes to {handler}, "
                                               "which is not a known coredump helper", "info", "T1546")
    return f"piped to {handler} ({why})", Finding("core dump handler", f"core_pattern pipes every crash into "
                                                   f"{handler}: {why}; the kernel runs it as root",
                                                   "critical", "T1546")


def modprobe_state() -> Tuple[str, Optional[Finding]]:
    value = read_sysctl("modprobe")
    if value is None:
        return "unavailable", None
    helper = value.strip()
    why = handler_path_bad(helper)
    if why is None:
        return helper, None
    return f"{helper} ({why})", Finding("modprobe helper", f"kernel.modprobe is {helper}: {why}; the kernel runs "
                                        "it as root whenever a module is requested", "critical", "T1547.006")


def read_kernel_cmdline() -> Optional[str]:
    try:
        with open(proc_path("cmdline")) as f:
            return f.read().strip()
    except OSError:
        return None


def cmdline_posture(cmdline: Optional[str]) -> Tuple[Dict[str, str], List[Finding]]:
    """Posture rows and findings from the kernel command line."""
    rows: Dict[str, str] = {}
    findings: List[Finding] = []
    if cmdline is None:
        rows["cmdline"] = "unavailable"
        return rows, findings
    params = cmdline.split()
    values = {}
    for p in params:
        key, _, value = p.partition("=")
        values[key] = value
    notes = []
    if values.get("audit") == "0":
        notes.append("audit=0")
        findings.append(Finding("kernel cmdline", "audit=0 on the command line: the audit subsystem is off",
                                "medium", "T1562.001"))
    if "ima_policy" not in values:
        notes.append("no IMA")
        findings.append(Finding("kernel cmdline", "IMA not enabled (no ima_policy=)", "info"))
    init = values.get("init")
    if init and init not in INIT_PATHS_KNOWN:
        notes.append(f"init={init}")
        findings.append(Finding("kernel cmdline", f"init={init} is not a standard init path", "medium", "T1037"))
    if "nokaslr" in values:
        notes.append("nokaslr")
        findings.append(Finding("kernel cmdline", "nokaslr: kernel address randomisation is off", "info"))
    if values.get("module.sig_enforce") == "1":
        notes.append("module.sig_enforce=1")
        findings.append(Finding("kernel cmdline", "module.sig_enforce=1: only signed modules load", "info"))
    if values.get("lockdown") in (None, "none"):
        notes.append("no lockdown")
    rows["cmdline"] = ", ".join(notes) if notes else "nothing notable"
    return rows, findings


def helper_posture() -> Tuple[Dict[str, str], List[Finding]]:
    """core_pattern, modprobe and cmdline rows with their findings, for kernel_posture and posture_findings."""
    rows: Dict[str, str] = {}
    findings: List[Finding] = []
    core_row, core_finding = core_pattern_state()
    rows["core_pattern"] = core_row
    if core_finding:
        findings.append(core_finding)
    modprobe_row, modprobe_finding = modprobe_state()
    rows["modprobe"] = modprobe_row
    if modprobe_finding:
        findings.append(modprobe_finding)
    cmd_rows, cmd_findings = cmdline_posture(read_kernel_cmdline())
    rows.update(cmd_rows)
    findings += cmd_findings
    return rows, findings


def kernel_posture() -> Dict[str, str]:
    posture = {
        "secure_boot": secure_boot_state(),
        "lockdown": lockdown_state(),
        "modules_disabled": read_sysctl("modules_disabled") or "unavailable",
        "kptr_restrict": read_sysctl("kptr_restrict") or "unavailable",
        "unprivileged_bpf_disabled": read_sysctl("unprivileged_bpf_disabled") or "unavailable",
        "ptrace_scope": read_sysctl("yama", "ptrace_scope") or "unavailable",
        "sig_enforce": sig_enforce_state(),
        "lkrg": lkrg_state(),
        "sensor": sensor_state(),
    }
    helper_rows, _ = helper_posture()
    posture.update(helper_rows)
    hello = sensor_hello() if posture["sensor"] == "active" else None
    if hello:
        posture["sensor_version"] = str(hello.get("sensor", ""))
        posture["sensor_schema"] = str(hello.get("v", ""))
    if posture["modules_disabled"] == "1":
        posture["module_loading"] = "disabled"
    elif posture["sig_enforce"] == "Y" or posture["lockdown"] in ("integrity", "confidentiality"):
        posture["module_loading"] = "signed only"
    else:
        posture["module_loading"] = "open"
    return posture


def ebpf_findings() -> List[Finding]:
    out = run_command(["bpftool", "prog", "list"])
    if out is None:
        return [Finding("ebpf", "bpftool unavailable or not root: loaded eBPF programs not listed", "info")]
    programs = re.findall(r"^(\d+):\s+(\w+)(?:\s+name\s+(\S+))?", out, re.M)
    findings = [Finding("ebpf", f"{len(programs)} eBPF program(s) loaded", "info")]
    for _, kind, name in programs:
        if kind in ("kprobe", "tracepoint") and any(hint in (name or "") for hint in EBPF_HOOK_HINTS):
            findings.append(Finding("ebpf", f"{kind} program {name} sits where process or socket listings "
                                    "are produced; check what attached it", "info", "T1014"))
    return findings


def cmd_kernel(args) -> int:
    """Loaded module cross-view, ownership, taint and hardening posture."""
    started = time.monotonic()
    findings, summary = module_findings()
    taint = read_taint()
    findings += taint_findings(taint, bool(summary["unowned"]))
    posture = kernel_posture()
    findings += posture_findings(posture)
    findings += ebpf_findings()
    sort_findings(findings)
    note_counts(finding_counts(findings))
    code = findings_exit_code(findings)
    summary["taint"] = taint
    summary["taint_flags"] = [text for _, text in decode_taint(taint or 0)]
    emit_findings_outputs(args, "kernel", findings, started)

    if args.json:
        print(json.dumps(finding_payload(findings, modules=summary, posture=posture), indent=2))
        return code

    print("Posture")
    rows = [
        ("secure boot", posture["secure_boot"]),
        ("lockdown", posture["lockdown"]),
        ("kernel module loading", posture["module_loading"]),
        ("modules_disabled", posture["modules_disabled"]),
        ("sig_enforce", posture["sig_enforce"]),
        ("kptr_restrict", posture["kptr_restrict"]),
        ("unprivileged_bpf_disabled", posture["unprivileged_bpf_disabled"]),
        ("yama ptrace_scope", posture["ptrace_scope"]),
        ("core dumps", posture.get("core_pattern", "unavailable")),
        ("modprobe helper", posture.get("modprobe", "unavailable")),
        ("kernel cmdline", posture.get("cmdline", "unavailable")),
        ("LKRG", posture["lkrg"]),
        ("real-time sensor", sensor_row(posture)),
        ("taint", "unavailable" if taint is None else
         f"{taint}" + (f" ({', '.join(summary['taint_flags'])})" if taint else " (clean)")),
        ("running kernel", summary["release"]),
        ("loaded modules", f"{summary['loaded']} in /proc/modules, {summary['sys_module']} in /sys/module, "
         f"{'?' if summary['kallsyms'] is None else summary['kallsyms']} in kallsyms; "
         f"{summary['owned']} owned by packages, {summary['dkms']} dkms, {len(summary['unowned'])} unowned"),
    ]
    for label, value in rows:
        print(f"  {label:<28} {value}")
    print()
    shown = [f for f in findings if f.severity != "info"]
    if shown:
        print_findings(shown, KERNEL_EXPLANATIONS)
    elif summary["reboot_pending"]:
        print("Every loaded module is visible in all views; ownership will be checked after the reboot.")
    else:
        print("Every loaded module is visible in all views, owned by a package, and the kernel is not tainted.")
    for f in findings:
        if f.severity == "info":
            print(f"note: {f.kind}: {f.detail}")
    counts = finding_counts(findings)
    print(f"\n{counts['critical']} critical, {counts['medium']} medium, {counts['low']} low, {counts['info']} info")
    return code


# =============================================================================
# AUR supply chain (weird aur)
# =============================================================================

AUR_PASTE_HOSTS = ("pastebin.com", "hastebin.com", "hastebin.skyra.pw", "ghostbin.co", "ghostbin.com",
                   "transfer.sh", "anonfiles.com", "paste.ee", "dpaste.com", "0x0.st")
AUR_SECURE_SCHEMES = ("https", "git+https", "hg+https", "svn+https", "bzr+https", "fossil+https",
                      "ssh", "git+ssh", "file")
AUR_VCS_PREFIXES = ("git", "hg", "svn", "bzr", "fossil")
AUR_CHECKSUM_ALGOS = ("b2", "sha512", "sha384", "sha256", "sha224", "sha1", "md5", "ck")
AUR_EXPLANATIONS = {
    "known-bad package": "This package name is on a published list of AUR packages compromised during a known "
                         "campaign. Remove it, read its PKGBUILD and install scripts, and check for the campaign's "
                         "indicators (github.com/lenucksi/aur-malware-check).",
    "insecure source": "makepkg downloads this source without TLS (or from a throwaway paste host): "
                       "anyone on the path can swap the archive, and a paste host is not a release channel.",
    "PKGBUILD modified after install": "The cached PKGBUILD changed since this version was built and "
                                       "installed. Read the diff before the next rebuild.",
    "no checksums": "Without a checksum array makepkg accepts whatever the URL serves.",
    "checksum SKIP": "SKIP disables verification for that source; the download is trusted as is.",
}


@dataclass
class AurPackage:
    name: str
    version: str
    base: str
    installdate: int
    packager: str
    validation: str
    pkgbuild: str = ""
    findings: List[Finding] = field(default_factory=list)


def pacman_local_descs() -> List[Dict[str, str]]:
    local_dir = Path(sys_path("/var/lib/pacman/local"))
    if not local_dir.is_dir():
        return []
    descs = []
    for pkgdir in sorted(local_dir.iterdir()):
        desc = read_pacman_desc(pkgdir)
        if desc.get("NAME"):
            descs.append(desc)
    return descs


def desc_to_aur_package(desc: Dict[str, str]) -> AurPackage:
    try:
        installdate = int(desc.get("INSTALLDATE", ""))
    except ValueError:
        installdate = 0
    return AurPackage(desc["NAME"], desc.get("VERSION", ""), desc.get("BASE") or desc["NAME"],
                      installdate, desc.get("PACKAGER", ""), desc.get("VALIDATION", ""))


def foreign_packages(local_db_only: bool = False) -> List[AurPackage]:
    """Packages not from an enabled repository.

    `pacman -Qm` is the authority when it runs; without it (or with
    `local_db_only`, for a mounted disk that is not the running system) a desc
    whose validation is not pgp or whose packager is unknown counts as foreign. A
    foreign package that still carries a pgp validation was signed by
    someone (a repository since removed), so it has no PKGBUILD to check.
    """
    packages: List[AurPackage] = []
    out = run_command(["pacman", "-Qm"]) if shutil.which("pacman") and not local_db_only else None
    foreign = None if out is None else {line.split()[0] for line in out.splitlines() if line.split()}
    for desc in pacman_local_descs():
        pkg = desc_to_aur_package(desc)
        unknown_packager = not pkg.packager or pkg.packager == "Unknown Packager"
        if foreign is None:
            if pkg.validation == "pgp" and not unknown_packager:
                continue
        elif pkg.name not in foreign and not unknown_packager:
            continue
        if pkg.validation == "pgp" and not unknown_packager:
            pkg.findings.append(Finding("foreign but signed", f"not in any enabled repository, signed and built "
                                        f"by {pkg.packager}; no local PKGBUILD to check", "info", subject=pkg.name))
        packages.append(pkg)
    return packages


def pkgbuild_dirs(extra: Optional[str] = None) -> List[Path]:
    dirs = [Path(extra)] if extra else []
    dirs += [Path.home() / ".cache" / "paru" / "clone", Path.home() / ".cache" / "yay"]
    return dirs


def find_pkgbuild(pkg: AurPackage, extra: Optional[str] = None) -> Optional[Path]:
    for directory in pkgbuild_dirs(extra):
        for name in dict.fromkeys((pkg.base, pkg.name)):
            candidate = directory / name / "PKGBUILD"
            if candidate.is_file():
                return candidate
    return None


def _array_body(text: str, start: int) -> str:
    """Text between the opening paren at start-1 and its closing paren, comments removed."""
    out = []
    quote = None
    i = start
    while i < len(text):
        c = text[i]
        if quote:
            if c == "\\" and quote == '"':
                out.append(text[i:i + 2])
                i += 2
                continue
            if c == quote:
                quote = None
            out.append(c)
        elif c in "\"'":
            quote = c
            out.append(c)
        elif c == "\\":
            out.append(text[i:i + 2])
            i += 2
            continue
        elif c == "#" and (i == start or text[i - 1] in " \t\n"):
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        elif c == ")":
            break
        else:
            out.append(c)
        i += 1
    return "".join(out)


def pkgbuild_arrays(text: str) -> Dict[str, List[str]]:
    """name -> items for every name=( ... ) array in a PKGBUILD, quotes stripped."""
    arrays: Dict[str, List[str]] = {}
    for m in re.finditer(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)=\(", text, re.M):
        body = _array_body(text, m.end())
        try:
            arrays[m.group(1)] = shlex.split(body, comments=False)
        except ValueError:
            arrays[m.group(1)] = body.split()
    return arrays


def pkgbuild_scalars(text: str) -> Dict[str, str]:
    """name -> value for simple name=value lines (used to expand $url style sources)."""
    scalars: Dict[str, str] = {}
    for m in re.finditer(r"^[ \t]*([A-Za-z_][A-Za-z0-9_]*)=(\"[^\"\n]*\"|'[^'\n]*'|[^\s#()]+)[ \t]*(?:#.*)?$", text, re.M):
        value = m.group(2)
        if value[:1] in "\"'" and value[-1:] == value[:1]:
            value = value[1:-1]
        scalars[m.group(1)] = value
    return scalars


def expand_pkgbuild_vars(value: str, variables: Dict[str, str]) -> str:
    def sub(m):
        return variables.get(m.group(1) or m.group(2), m.group(0))
    for _ in range(4):
        new = re.sub(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)", sub, value)
        if new == value:
            break
        value = new
    return value


def source_url(entry: str) -> Optional[str]:
    """URL part of a source entry ('name::url' or plain), None for local files."""
    if "::" in entry:
        entry = entry.split("::", 1)[1]
    return entry if "://" in entry else None


def is_paste_host(host: str) -> bool:
    host = host.rsplit("@", 1)[-1].split(":", 1)[0].lower()
    return any(host == h or host.endswith("." + h) for h in AUR_PASTE_HOSTS)


def assess_source(pkg: AurPackage, url: str, findings: List[Finding]) -> None:
    scheme, rest = url.split("://", 1)
    scheme = scheme.lower()
    host = rest.split("/", 1)[0]
    if is_paste_host(host):
        findings.append(Finding("insecure source", f"{url} comes from a paste host", "critical", "T1195.001", pkg.name))
    elif scheme.startswith("$"):
        findings.append(Finding("source unresolved", f"{url}: scheme comes from a variable this parser "
                                "does not expand", "info", subject=pkg.name))
    elif scheme not in AUR_SECURE_SCHEMES:
        findings.append(Finding("insecure source", f"{url} is fetched over {scheme}, not https",
                                "medium", "T1195.001", pkg.name))


def is_vcs_source(url: str) -> bool:
    scheme = url.split("://", 1)[0].lower()
    return scheme.split("+", 1)[0] in AUR_VCS_PREFIXES


def assess_checksums(pkg: AurPackage, suffix: str, sources: List[str], arrays: Dict[str, List[str]],
                     findings: List[Finding]) -> None:
    sums = None
    for algo in AUR_CHECKSUM_ALGOS:
        sums = arrays.get(f"{algo}sums{suffix}")
        if sums is not None:
            break
    if sums is None:
        findings.append(Finding("no checksums", f"source{suffix} has no checksum array", "low", "T1195.001", pkg.name))
        return
    for i, value in enumerate(sums):
        if value.upper() != "SKIP":
            continue
        entry = sources[i] if i < len(sources) else ""
        url = source_url(entry) or entry
        if url and is_vcs_source(url):
            pinned = "#commit=" in url or "#tag=" in url
            findings.append(Finding("vcs source", f"{url}: checksum SKIP is normal for a VCS source"
                                    + (", pinned" if pinned else ", not pinned to a commit or tag"),
                                    "info", subject=pkg.name))
        else:
            findings.append(Finding("checksum SKIP", f"{url or 'entry ' + str(i + 1)} is installed unverified",
                                    "low", "T1195.001", pkg.name))


def pkgbuild_git_findings(pkg: AurPackage, clone_dir: Path, pkgbuild_version: str, findings: List[Finding]) -> None:
    """Compare the last PKGBUILD commit in the helper clone with the package's install date."""
    if not (clone_dir / ".git").exists():
        findings.append(Finding("no git history", "clone is not a git repository, change history unknown",
                                "info", subject=pkg.name))
        return
    directory = str(clone_dir)
    out = run_command(["git", "-C", directory, "log", "-1", "--format=%ct", "--", "PKGBUILD"])
    try:
        last = int((out or "").strip())
    except ValueError:
        return
    status = run_command(["git", "-C", directory, "status", "--porcelain", "--", "PKGBUILD"]) or ""
    if status.strip():
        diff = run_command(["git", "-C", directory, "diff", "--", "PKGBUILD"]) or ""
        changed = [l for l in diff.splitlines()
                   if l[:1] in "+-" and not l.startswith(("+++", "---")) and l[1:].strip()]
        if changed and all(re.match(r"[+-]\s*pkgver=", l) for l in changed):
            findings.append(Finding("pkgver bump", "uncommitted pkgver= edit only, the way makepkg updates a "
                                    "VCS package", "info", subject=pkg.name))
        else:
            findings.append(Finding("PKGBUILD modified after install", f"uncommitted local edits to PKGBUILD "
                                    f"({len(changed)} changed line(s))", "medium", "T1195.001", pkg.name))
    installed_at = pacman_history_install_time(pkg.name) or pkg.installdate
    if last <= installed_at:
        return
    when = time.strftime("%Y-%m-%d", time.localtime(last))
    installed = time.strftime("%Y-%m-%d", time.localtime(installed_at))
    before = run_command(["git", "-C", directory, "log", "-1", "--format=%H", f"--before=@{pkg.installdate}",
                          "--", "PKGBUILD"]) or ""
    summary = "no commit before the install date"
    if before.strip():
        stat = run_command(["git", "-C", directory, "diff", "--stat", f"{before.strip()}..HEAD", "--", "PKGBUILD"]) or ""
        lines = [l.strip() for l in stat.splitlines() if l.strip()]
        if lines:
            summary = lines[-1]
    detail = f"last commit {when}, installed {installed}: {summary}"
    installed_version = pkg.version.split(":", 1)[-1].rsplit("-", 1)[0]
    if pkgbuild_version and pkgbuild_version != installed_version:
        detail += f" (new version {pkgbuild_version}, installed {installed_version})"
    else:
        detail += " (same version, content changed)"
    findings.append(Finding("PKGBUILD modified after install", detail, "medium", "T1195.001", pkg.name))


def assess_pkgbuild(pkg: AurPackage, pkgbuild: Path) -> List[Finding]:
    findings: List[Finding] = []
    try:
        text = pkgbuild.read_text(errors="replace")
    except OSError:
        return [Finding("PKGBUILD unavailable", f"{pkgbuild} unreadable", "info", subject=pkg.name)]
    arrays = pkgbuild_arrays(text)
    variables = pkgbuild_scalars(text)
    variables.setdefault("pkgname", pkg.name)
    variables.setdefault("pkgbase", pkg.base)
    for name, items in arrays.items():
        if name != "source" and not name.startswith("source_"):
            continue
        sources = [expand_pkgbuild_vars(item, variables) for item in items]
        for entry in sources:
            url = source_url(entry)
            if url:
                assess_source(pkg, url, findings)
        assess_checksums(pkg, name[len("source"):], sources, arrays, findings)
    install = re.search(r"^[ \t]*install=[\"']?([^\"'\s]+)", text, re.M)
    if install:
        findings.append(Finding("install script", f"runs install script as root ({install.group(1)})",
                                "info", "T1195.001", pkg.name))
    pkgbuild_git_findings(pkg, pkgbuild.parent, expand_pkgbuild_vars(variables.get("pkgver", ""), variables), findings)
    if any(f.kind == "insecure source" for f in findings):
        for f in findings:
            if f.kind == "PKGBUILD modified after install":
                f.severity = "critical"
                f.detail += "; together with an insecure source"
    return findings


def check_aur_packages(pkgbuild_dir: Optional[str] = None, local_db_only: bool = False) -> List[AurPackage]:
    packages = foreign_packages(local_db_only)
    for pkg in packages:
        if pkg.findings:
            continue
        pkgbuild = find_pkgbuild(pkg, pkgbuild_dir)
        if pkgbuild is None:
            pkg.findings.append(Finding("PKGBUILD unavailable", "no paru or yay clone found; pass --pkgbuild-dir",
                                        "info", subject=pkg.name))
            continue
        pkg.pkgbuild = str(pkgbuild)
        pkg.findings = assess_pkgbuild(pkg, pkgbuild)
    return packages


# ======================================================================# Round 2 AUR checks: pacman.log history and language-manager caches
# =============================================================================

PACMAN_LOG = "/var/log/pacman.log"
PACMAN_LOG_LINE = re.compile(r"^\[([^\]]+)\] \[ALPM\] (installed|upgraded|removed|reinstalled|downgraded) (\S+) \((.*)\)$")
AUR_BUILD_WINDOW_SECONDS = 30 * 60
LANGUAGE_CACHE_DIRS = (
    ("npm cache", "~/.npm/_cacache/index-v5"), ("npx cache", "~/.npm/_npx"),
    ("bun cache", "~/.bun/install/cache"), ("pnpm cache", "~/.cache/pnpm"),
    ("yarn cache", "~/.cache/yarn"), ("yarn berry cache", "~/.yarn/berry/cache"),
    ("npm global", "~/.npm-global/lib/node_modules"), ("npm global", "~/.local/lib/node_modules"),
    ("npm global", "/usr/local/lib/node_modules"),
)
_pacman_history_cache: Optional[List[Tuple[int, str, str, str]]] = None


def parse_pacman_log_time(stamp: str) -> Optional[int]:
    """Epoch seconds from '2024-03-01T10:22:11+0100' or the older '2016-01-01 10:22'."""
    for fmt in ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%d %H:%M"):
        try:
            return int(datetime.strptime(stamp, fmt).timestamp())
        except ValueError:
            continue
    return None


def pacman_log_files() -> List[str]:
    base = sys_path(PACMAN_LOG)
    rotated = sorted(glob.glob(base + ".*"), reverse=True)
    return rotated + [base]


def read_pacman_log_lines(path: str) -> List[str]:
    try:
        if path.endswith(".gz"):
            with gzip.open(path, "rt", errors="replace") as f:
                return f.read().splitlines()
        if path.endswith(".xz"):
            import lzma
            with lzma.open(path, "rt", errors="replace") as f:
                return f.read().splitlines()
        with open(path, errors="replace") as f:
            return f.read().splitlines()
    except (OSError, EOFError, ValueError):
        return []


def pacman_history() -> List[Tuple[int, str, str, str]]:
    """(timestamp, action, package, version) for every ALPM install, upgrade and removal in pacman.log,
    oldest first. Cached for the run; empty when the log is unreadable."""
    global _pacman_history_cache
    if _pacman_history_cache is not None:
        return _pacman_history_cache
    rows = []
    for path in pacman_log_files():
        for line in read_pacman_log_lines(path):
            m = PACMAN_LOG_LINE.match(line)
            if not m:
                continue
            ts = parse_pacman_log_time(m.group(1))
            if ts is None:
                continue
            action = m.group(2)
            version = m.group(4)
            if action in ("upgraded", "downgraded") and " -> " in version:
                version = version.split(" -> ")[-1]
            rows.append((ts, action, m.group(3), version))
    rows.sort(key=lambda r: r[0])
    _pacman_history_cache = rows
    return rows


def pacman_history_install_time(package: str) -> Optional[int]:
    """Most recent install or upgrade time of a package in pacman.log."""
    last = None
    for ts, action, name, _ in pacman_history():
        if name == package and action != "removed":
            last = ts
    return last


def foreign_installs_in_windows(windows: List[Tuple[int, int]],
                                foreign: Optional[Set[str]] = None) -> List[Tuple[int, str, str, str]]:
    """History rows for foreign (locally built) packages installed or upgraded inside any (start, end) window."""
    if foreign is None:
        foreign = {d.get("NAME", "") for d in pacman_local_descs()
                   if not is_distro_packager(d.get("PACKAGER", ""))}
    return [row for row in pacman_history()
            if row[2] in foreign and row[1] != "removed" and any(s <= row[0] <= e for s, e in windows)]


def installed_then_removed() -> List[Tuple[str, int, int]]:
    """(package, installed at, removed at) for packages that came and went, info material."""
    installed: Dict[str, int] = {}
    out = []
    for ts, action, name, _ in pacman_history():
        if action == "installed":
            installed[name] = ts
        elif action == "removed" and name in installed:
            out.append((name, installed.pop(name), ts))
    return out


def is_distro_packager(packager: str) -> bool:
    return any(hint in packager.lower() for hint in PACMAN_DISTRO_PACKAGERS)


NODE_ECOSYSTEM_HINTS = ("nodejs", "npm", "yarn", "pnpm", "bun", "node-gyp", "electron")


def uses_node_ecosystem(desc: Dict[str, str]) -> bool:
    """Whether a package's dependencies or its cached PKGBUILD mention a node package manager."""
    text = "\n".join(desc.get(k, "") for k in ("DEPENDS", "MAKEDEPENDS", "OPTDEPENDS"))
    if any(h in text for h in NODE_ECOSYSTEM_HINTS):
        return True
    try:
        pkgbuild = find_pkgbuild(desc_to_aur_package(desc))
        if pkgbuild is not None:
            return any(h in pkgbuild.read_text(errors="replace") for h in NODE_ECOSYSTEM_HINTS)
    except (OSError, ValueError):
        pass
    return False


def aur_build_windows() -> List[Tuple[int, int, str]]:
    """(start, end, package) for each foreign package install whose build plausibly ran a node package manager:
    the 30 minutes before the install is where makepkg most likely fetched things."""
    foreign = {d.get("NAME", ""): d for d in pacman_local_descs() if not is_distro_packager(d.get("PACKAGER", ""))}
    node_users = {name for name, d in foreign.items() if uses_node_ecosystem(d)}
    return [(ts - AUR_BUILD_WINDOW_SECONDS, ts, name) for ts, action, name, _ in pacman_history()
            if name in node_users and action != "removed"]


def npm_index_entries(index_dir: str) -> List[Tuple[str, int]]:
    """(package name, time) from npm's _cacache index files (one JSON record per line after a hash)."""
    out = []
    for root, _, files in os.walk(index_dir):
        for name in files:
            try:
                with open(os.path.join(root, name), errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            for line in text.splitlines():
                _, _, body = line.partition("\t")
                try:
                    rec = json.loads(body or line)
                except ValueError:
                    continue
                key = str(rec.get("key", ""))
                m = re.search(r"registry\.npmjs\.org/((?:@[^/]+/)?[^/]+)/-/", key) or \
                    re.search(r"request-cache:https?://[^/]+/((?:@[^/]+/)?[^/?]+)$", key)
                if m and rec.get("time"):
                    out.append((m.group(1), int(rec["time"]) // 1000))
    return out


def cache_dir_entries(label: str, directory: str) -> List[Tuple[str, int]]:
    """(name, mtime) per top-level entry of a package cache; npm's index is parsed for real package names."""
    host = persist_host_path(directory)
    if not os.path.isdir(host):
        return []
    if label == "npm cache":
        return npm_index_entries(host)
    out = []
    try:
        names = os.listdir(host)
    except OSError:
        return []
    for name in names:
        path = os.path.join(host, name)
        try:
            mtime = int(os.stat(path).st_mtime)
        except OSError:
            continue
        if name.startswith("@") and os.path.isdir(path):
            try:
                for sub in os.listdir(path):
                    out.append((f"{name}/{sub}", int(os.stat(os.path.join(path, sub)).st_mtime)))
            except OSError:
                continue
        else:
            out.append((name, mtime))
    return out


def language_cache_findings() -> List[Finding]:
    """Packages a language manager fetched while an AUR package was being built."""
    windows = aur_build_windows()
    if not windows:
        return []
    findings = []
    seen = set()
    for label, directory in LANGUAGE_CACHE_DIRS:
        directory = persist_expand_home(directory)
        for name, when in cache_dir_entries(label, directory):
            for start, end, aur_pkg in windows:
                if start <= when <= end and (label, name, aur_pkg) not in seen:
                    seen.add((label, name, aur_pkg))
                    stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(when))
                    findings.append(Finding("package fetched during an AUR build",
                                            f"{label}: {name} fetched {stamp} while {aur_pkg} was being built",
                                            "medium", "T1195.001", aur_pkg))
    return findings
# -----------------------------------------------------------------------------
# Known-bad AUR package lists (campaigns from github.com/lenucksi/aur-malware-check)
# -----------------------------------------------------------------------------

CAMPAIGNS_URL = "https://raw.githubusercontent.com/lenucksi/aur-malware-check/main/data/campaigns.json"
CAMPAIGNS_DIR = CONFIG_DIR / "campaigns"
CAMPAIGNS_FILE = CAMPAIGNS_DIR / "campaigns.json"
CAMPAIGNS_META = CAMPAIGNS_DIR / "meta.json"
CAMPAIGNS_MAX_BYTES = 5 * 1024 * 1024
CAMPAIGNS_TIMEOUT = 20
CAMPAIGNS_MAX_AGE_DAYS = 7
CAMPAIGN_PACKAGE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._+-]*$")
CAMPAIGN_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


class CampaignFetchError(Exception):
    pass


@dataclass
class Campaign:
    id: str
    label: str
    start: str
    end: str
    packages: Set[str] = field(default_factory=set)


def campaign_list_path(base: Path, rel) -> Optional[Path]:
    """A list file reference from campaigns.json as a path under `base`, or None when it is not a clean relative path."""
    if not isinstance(rel, str) or not rel or rel.startswith(("/", "~")) or "\\" in rel:
        return None
    parts = rel.split("/")
    if any(p in ("", ".", "..") for p in parts):
        return None
    return base.joinpath(*parts)


def read_campaign_packages(path: Path) -> Optional[Set[str]]:
    """Package names from a list file: one per line, # comments ignored, odd names dropped. None when unreadable."""
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return None
    names: Set[str] = set()
    for line in text.splitlines():
        name = line.split("#", 1)[0].strip()
        if name and CAMPAIGN_PACKAGE_RE.match(name):
            names.add(name.lower())
    return names


def parse_campaigns(path: Path) -> Tuple[List[Campaign], int]:
    """Campaigns from a campaigns.json plus the list files it names (relative to its directory).

    Only ids, labels, date windows and package names are read; every other field
    is ignored. Returns (campaigns, number of malformed entries or missing list
    files skipped). Nothing from the file is ever executed or evaluated.
    """
    path = Path(path)
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return [], 1
    entries = data.get("campaigns") if isinstance(data, dict) else data
    if not isinstance(entries, list):
        return [], 1
    base = path.parent
    campaigns: List[Campaign] = []
    skipped = 0
    for entry in entries:
        cid = entry.get("id") if isinstance(entry, dict) else None
        if not isinstance(cid, str) or not cid.strip():
            skipped += 1
            continue
        label = entry.get("display") or entry.get("label") or entry.get("name") or cid
        window = entry.get("date_window")
        window = window if isinstance(window, dict) else {}
        start, end = (str(window.get(k) or "") for k in ("start", "end"))
        start = start if CAMPAIGN_DATE_RE.match(start) else ""
        end = end if CAMPAIGN_DATE_RE.match(end) else ""
        packages: Set[str] = set()
        bad_lists = 0
        inline = entry.get("packages")
        if isinstance(inline, list):
            packages |= {str(n).strip().lower() for n in inline
                         if isinstance(n, str) and CAMPAIGN_PACKAGE_RE.match(n.strip())}
        lists = entry.get("lists")
        for rel in (lists if isinstance(lists, list) else []):
            list_path = campaign_list_path(base, rel)
            if list_path is not None and not list_path.is_file():
                list_path = campaign_list_path(base.parent, rel)  # a clone keeps campaigns.json under data/
            names = read_campaign_packages(list_path) if list_path else None
            if names is None:
                bad_lists += 1
                continue
            packages |= names
        if not packages:
            skipped += 1
            continue
        skipped += bad_lists
        campaigns.append(Campaign(cid.strip(), str(label).strip() or cid.strip(), start, end, packages))
    return campaigns, skipped


def load_campaigns(path: Path) -> List[Campaign]:
    return parse_campaigns(path)[0]


def read_campaigns_meta(path: Path = CAMPAIGNS_META) -> Dict:
    if not path.is_file() or not private_file_ok(path):
        return {}
    try:
        meta = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return meta if isinstance(meta, dict) else {}


def campaigns_status(campaigns: List[Campaign], meta: Dict) -> str:
    """Header text: '3 campaigns, 1612 packages, fetched 2026-10-05' or 'not available'."""
    if not campaigns:
        return "not available"
    count = len(set().union(*(c.packages for c in campaigns)))
    text = f"{len(campaigns)} campaigns, {count} packages"
    fetched = meta.get("fetched_at")
    if isinstance(fetched, (int, float)) and fetched > 0:
        text += ", fetched " + time.strftime("%Y-%m-%d", time.localtime(fetched))
    return text


def campaigns_max_age_days() -> int:
    """campaigns_max_age_days from config.toml (top level or [policy]), default 7."""
    if tomllib and CONFIG_FILE.exists():
        try:
            data = tomllib.loads(CONFIG_FILE.read_text())
            value = data.get("campaigns_max_age_days", data.get("policy", {}).get("campaigns_max_age_days"))
            if value is not None:
                return max(0, int(value))
        except (OSError, ValueError, TypeError, AttributeError):
            pass
    return CAMPAIGNS_MAX_AGE_DAYS


def helper_cache_names(pkgbuild_dir: Optional[str] = None) -> Set[str]:
    """Package names with a clone in the AUR helper caches (built here at some point)."""
    names: Set[str] = set()
    for directory in pkgbuild_dirs(pkgbuild_dir):
        try:
            for entry in directory.iterdir():
                if entry.is_dir() and CAMPAIGN_PACKAGE_RE.match(entry.name):
                    names.add(entry.name.lower())
        except OSError:
            continue
    return names


def apply_campaigns(campaigns: List[Campaign], packages: List[AurPackage], cache_names: Set[str]) -> List[Finding]:
    """Installed foreign packages on a list get a critical finding on the package; cache-only hits come back as info."""
    extra: List[Finding] = []
    installed = {p.name.lower() for p in packages}
    for campaign in campaigns:
        window = f"window {campaign.start or 'unknown'} to {campaign.end or 'unknown'}"
        for pkg in packages:
            if pkg.name.lower() in campaign.packages:
                when = f", installed {time.strftime('%Y-%m-%d', time.localtime(pkg.installdate))}" if pkg.installdate else ""
                pkg.findings.append(Finding("known-bad package",
                                            f"installed package {pkg.name} is on the {campaign.label} compromised "
                                            f"list ({window}){when}", "critical", "T1195.002", pkg.name))
        for name in sorted(campaign.packages & cache_names - installed):
            extra.append(Finding("known-bad package built", f"campaign package {name} was built on this machine "
                                 f"but is not installed ({campaign.label}, {window})", "info", "T1195.002", name))
    return extra


def campaigns_host_ok(url: str) -> bool:
    from urllib.parse import urlsplit
    parts = urlsplit(url)
    host = (parts.hostname or "").lower()
    return parts.scheme == "https" and (host in ("github.com", "githubusercontent.com") or
                                        host.endswith((".github.com", ".githubusercontent.com")))


def same_domain_redirect_handler():
    """urllib redirect handler that refuses any redirect leaving github.com / githubusercontent.com."""
    import urllib.request

    class SameDomainRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if not campaigns_host_ok(newurl):
                raise CampaignFetchError(f"redirect to {newurl} refused")
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    return SameDomainRedirects


def download_url(url: str, max_bytes: int = CAMPAIGNS_MAX_BYTES, timeout: int = CAMPAIGNS_TIMEOUT) -> bytes:
    """HTTPS GET with urllib: github.com and githubusercontent.com only, redirects elsewhere refused, size capped."""
    import urllib.error
    import urllib.request

    if not campaigns_host_ok(url):
        raise CampaignFetchError(f"refusing to fetch {url}: not an https github.com address")
    opener = urllib.request.build_opener(same_domain_redirect_handler())
    try:
        with opener.open(urllib.request.Request(url, headers={"User-Agent": "weird"}), timeout=timeout) as resp:
            data = resp.read(max_bytes + 1)
    except (urllib.error.URLError, OSError, ValueError) as exc:
        raise CampaignFetchError(str(getattr(exc, "reason", exc) or exc))
    if len(data) > max_bytes:
        raise CampaignFetchError(f"{url} is larger than {max_bytes // (1024 * 1024)} MB")
    return data


def write_private_bytes(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp_file = path.with_suffix(path.suffix + ".tmp")
    try:
        with open(temp_file, "wb") as f:
            os.chmod(temp_file, 0o600)
            f.write(data)
        temp_file.rename(path)
    except OSError:
        if temp_file.exists():
            temp_file.unlink()
        raise


def fetch_campaigns(url: str = CAMPAIGNS_URL, dest: Path = CAMPAIGNS_DIR, download=download_url) -> Path:
    """Download campaigns.json and the list files it names into `dest`, write meta.json, print one summary line.

    Raises CampaignFetchError; the caller prints it and carries on without the list.
    """
    raw = download(url)
    if len(raw) > CAMPAIGNS_MAX_BYTES:
        raise CampaignFetchError("campaigns.json is larger than 5 MB")
    try:
        data = json.loads(raw.decode("utf-8"))
    except ValueError as exc:
        raise CampaignFetchError(f"campaigns.json is not valid JSON: {exc}")
    entries = data.get("campaigns") if isinstance(data, dict) else data
    if not isinstance(entries, list):
        raise CampaignFetchError("campaigns.json has no campaigns list")
    base_url = url.rsplit("/", 1)[0].rsplit("/data", 1)[0] if "/data/" in url else url.rsplit("/", 1)[0]
    total = len(raw)
    files = []
    dest = Path(dest)
    for entry in entries:
        lists = entry.get("lists") if isinstance(entry, dict) else None
        for rel in (lists if isinstance(lists, list) else []):
            target = campaign_list_path(dest, rel)
            if target is None:
                raise CampaignFetchError(f"campaigns.json names an unsafe list path: {rel!r}")
            blob = download(f"{base_url}/{rel}")
            total += len(blob)
            if total > CAMPAIGNS_MAX_BYTES:
                raise CampaignFetchError("list files add up to more than 5 MB")
            write_private_bytes(target, blob)
            files.append(rel)
    write_private_bytes(dest / "campaigns.json", raw)
    campaigns, _ = parse_campaigns(dest / "campaigns.json")
    newest = max((d for c in campaigns for d in (c.start, c.end) if d), default="")
    count = len(set().union(*(c.packages for c in campaigns))) if campaigns else 0
    sha = hashlib.sha256(raw).hexdigest()
    write_private_json(dest / "meta.json", {"fetched_at": int(time.time()), "url": url, "sha256": sha, "size": total,
                                            "newest_campaign_date": newest, "package_count": count, "files": files})
    print(f"known-bad list fetched: {total} bytes, sha256 {sha}, newest campaign {newest or 'unknown'}, "
          f"{count} packages, {len(campaigns)} campaigns")
    return dest / "campaigns.json"


def maybe_offer_campaign_update(args, ask=None, fetch=None) -> Optional[Path]:
    """Which campaigns file the aur scan should use, after the one place a fetch may be offered.

    --campaigns PATH: that file, no prompt, no fetch. --fetch-campaigns: fetch now
    without asking. Otherwise a [y/N] question is asked only on a terminal (stdin
    and stdout), never under --json/--ndjson, in watch mode, with --no-prompt or
    with WEIRD_NO_PROMPT set; Enter or EOF means no. A failed fetch prints one
    line and the scan continues with whatever is cached.
    """
    ask = ask or input
    fetch = fetch or fetch_campaigns
    chosen = getattr(args, "campaigns", None)
    if chosen:
        return Path(chosen)
    cached = CAMPAIGNS_FILE if CAMPAIGNS_FILE.is_file() and private_file_ok(CAMPAIGNS_FILE) else None
    meta = read_campaigns_meta()
    fetched_at = meta.get("fetched_at") if isinstance(meta.get("fetched_at"), (int, float)) else 0
    age_days = int((time.time() - fetched_at) // 86400) if fetched_at else None
    want = bool(getattr(args, "fetch_campaigns", False))
    if not want:
        interactive = (sys.stdin.isatty() and sys.stdout.isatty() and not getattr(args, "json", False)
                       and not getattr(args, "ndjson", False) and not getattr(args, "watch", False)
                       and getattr(args, "command", None) != "watch" and not getattr(args, "no_prompt", False)
                       and not os.environ.get("WEIRD_NO_PROMPT"))
        if not interactive:
            return cached
        if cached is None:
            question = ("Known-bad AUR package list: not downloaded. Fetch it from "
                        "github.com/lenucksi/aur-malware-check? [y/N] ")
        elif age_days is None or age_days > campaigns_max_age_days():
            shown = f"{age_days} days ago" if age_days is not None else "at an unknown time"
            question = f"Known-bad AUR package list: last updated {shown}. Update it? [y/N] "
        else:
            return cached
        try:
            answer = ask(question)
        except (EOFError, KeyboardInterrupt):
            print()
            answer = ""
        if str(answer).strip().lower() not in ("y", "yes"):
            return cached
    try:
        return fetch()
    except CampaignFetchError as exc:
        print(f"known-bad list not fetched: {exc}")
    except Exception as exc:  # any other failure: continue without the list, exit codes unaffected
        print(f"known-bad list not fetched: {exc.__class__.__name__}: {exc}")
    return cached


def campaigns_for_scan(path: Optional[Path]) -> Tuple[List[Campaign], Dict]:
    """Loaded campaigns and the meta.json next to them (empty when there is no usable file)."""
    if path is None or not Path(path).is_file():
        return [], {}
    campaigns, skipped = parse_campaigns(Path(path))
    if skipped:
        debug_log("campaigns", f"{skipped} malformed campaign entries or missing list files skipped in {path}")
    return campaigns, read_campaigns_meta(Path(path).parent / "meta.json")


def cmd_aur(args) -> int:
    """Supply chain checks on the PKGBUILDs behind locally built (AUR) packages."""
    started = time.monotonic()
    campaigns, campaigns_meta = campaigns_for_scan(maybe_offer_campaign_update(args))
    packages = check_aur_packages(getattr(args, "pkgbuild_dir", None))
    findings = [f for pkg in packages for f in pkg.findings]
    findings += language_cache_findings()
    extra = apply_campaigns(campaigns, packages, helper_cache_names(getattr(args, "pkgbuild_dir", None)))
    known_bad = campaigns_status(campaigns, campaigns_meta)
    if not campaigns:
        known_bad += " (run interactively to fetch, or pass --campaigns PATH)"
    findings = [f for pkg in packages for f in pkg.findings] + extra
    sort_findings(findings)
    note_counts(finding_counts(findings))
    code = findings_exit_code(findings)
    emit_findings_outputs(args, "aur", findings, started)

    if args.json:
        payload = finding_payload(findings, known_bad_list=known_bad, packages=[
            {"name": p.name, "version": p.version, "base": p.base, "installdate": p.installdate,
             "packager": p.packager, "validation": p.validation, "pkgbuild": p.pkgbuild,
             "findings": [asdict(f) for f in p.findings]} for p in packages])
        print(json.dumps(payload, indent=2))
        return code

    if not packages:
        print("No foreign packages installed.")
        return 0
    show_all = getattr(args, "all", False) or getattr(args, "verbose", False)
    if campaigns and not any(f.kind == "known-bad package" for f in findings):
        known_bad += f"; none of the {len(packages)} foreign packages is on any list"
    print(f"known-bad list: {known_bad}")
    show_all = getattr(args, "all", False)
    shown = [f for f in findings if show_all or f.severity != "info"]
    if shown:
        print_findings(shown, AUR_EXPLANATIONS, subject_header="PACKAGE")
    else:
        print("Every checked PKGBUILD fetches over https with checksums and has not changed since install.")
    checked = sum(1 for p in packages if p.pkgbuild)
    counts = finding_counts(findings)
    tail = "" if show_all or not counts["info"] else " (-v lists the info entries)"
    print(f"\n{len(packages)} foreign packages, {checked} PKGBUILDs checked: {counts['critical']} critical, "
          f"{counts['medium']} medium, {counts['low']} low, {counts['info']} info{tail}")
    return code


# =============================================================================
# Self integrity (weird self-check)
# =============================================================================

SELF_PATH = os.path.realpath(__file__)
# bin/weird next to the checkout's package.json, or the copies a pip install puts side by side
PIN_FILE = next((p for p in (Path(SELF_PATH).parent.parent / "package.json",
                             Path(SELF_PATH).parent / "package.json") if p.is_file()),
                Path(SELF_PATH).parent.parent / "package.json")
RED = "\033[31m"
_self_integrity: str = "unchecked"


def self_integrity() -> Dict[str, str]:
    """sha256 of this script against the weirdIntegrity pin in package.json next to bin/.

    status is match, mismatch, unpinned (no pin recorded) or unavailable (script
    unreadable). Report only: exit codes never change because of it.
    """
    info = {"status": "unavailable", "detail": f"cannot read {SELF_PATH}", "path": SELF_PATH,
            "pin_file": str(PIN_FILE), "sha256": "", "pinned_sha256": "", "pinned_version": "", "version": ""}
    actual = digest_file(SELF_PATH, "sha256")
    if actual is None:
        return info
    info["sha256"] = actual
    try:
        data = json.loads(PIN_FILE.read_text())
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    info["version"] = str(data.get("version", ""))
    pin = data.get("weirdIntegrity")
    if not isinstance(pin, dict) or not pin.get("sha256"):
        info["status"] = "unpinned"
        info["detail"] = f"integrity pin not found in {PIN_FILE} (run scripts/update-pin.py to record one)"
        return info
    info["pinned_sha256"] = str(pin.get("sha256", "")).lower()
    info["pinned_version"] = str(pin.get("version", ""))
    if info["pinned_sha256"] == actual:
        info["status"] = "match"
        info["detail"] = f"sha256 matches the pin recorded for version {info['pinned_version'] or 'unknown'}"
    else:
        info["status"] = "mismatch"
        info["detail"] = f"sha256 differs from the pin recorded for version {info['pinned_version'] or 'unknown'}"
    return info


def check_self_integrity() -> str:
    """Startup check: one red line on stderr when the script differs from its pin, nothing otherwise."""
    global _self_integrity
    info = self_integrity()
    _self_integrity = info["status"]
    if info["status"] == "mismatch":
        print(f"{RED}WARNING (self-integrity): {SELF_PATH} does not match the sha256 pinned in {PIN_FILE}: "
              f"this copy of weird was modified, or the pin is stale after an intended change "
              f"(scripts/update-pin.py records the new hash){RESET}", file=sys.stderr, flush=True)
    return _self_integrity


def cmd_self_check(args) -> int:
    """Print the startup self-check items and the self integrity result with both hashes."""
    warnings = self_check()
    info = self_integrity()
    if getattr(args, "json", False):
        print(json.dumps({"host": socket.gethostname(), "timestamp": int(time.time()),
                          "self_check": warnings, "self_integrity": info}, indent=2))
        return 0
    print_self_check(warnings)
    if not warnings:
        print("self-check: no injected library, loader variable or unowned executable mapping in this process")
    print(f"self integrity: {info['status']} ({info['detail']})")
    print(f"  script           {info['path']}")
    print(f"  sha256           {info['sha256'] or 'unreadable'}")
    print(f"  pinned sha256    {info['pinned_sha256'] or 'none'}")
    print(f"  pinned version   {info['pinned_version'] or 'none'} (package.json version {info['version'] or 'unknown'})")
    print(f"  pin file         {info['pin_file']}")
    return 0


# =============================================================================
# Offline mode (weird offline SYSROOT): a mounted disk checked from live media
# =============================================================================

OFFLINE_EXEC_DIRS = ("/usr/bin", "/usr/lib")


def offline_executables(limit: int = 0) -> List[str]:
    """Regular executable files under the sysroot's /usr/bin and /usr/lib, sorted, as system paths."""
    found: List[str] = []
    for top in OFFLINE_EXEC_DIRS:
        base = sys_path(top).rstrip("/")
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames.sort()
            for name in sorted(filenames):
                host = os.path.join(dirpath, name)
                try:
                    mode = os.lstat(host).st_mode
                except OSError:
                    continue
                if os.path.islink(host) or not os.path.isfile(host) or not mode & 0o111:
                    continue
                found.append(top + host[len(base):])
                if limit and len(found) >= limit:
                    return found
    return found


def offline_integrity_findings(limit: int = 0) -> Tuple[List[Finding], Dict[str, int]]:
    """verify_integrity over every package-owned executable on the mounted disk."""
    findings: List[Finding] = []
    counts = {"examined": 0, "checked": 0, "intact": 0, "modified": 0, "unavailable": 0, "unowned": 0}
    for path in offline_executables(limit):
        counts["examined"] += 1
        package = file_package_cache.get(path)
        if not package:
            counts["unowned"] += 1
            continue
        status, detail = verify_integrity(path, package, file_package_cache.get_manager(path) or "")
        counts["checked"] += 1
        counts[status] += 1
        if status == "modified":
            findings.append(Finding("integrity", f"{path} differs from what package {package} installed ({detail})",
                                    "critical", "T1554", path))
    return findings, counts


def cmd_offline(args) -> int:
    """persist, executable integrity and aur against a mounted disk, no process scan."""
    root = os.path.abspath(args.sysroot_dir)
    if root == "/" and not getattr(args, "force", False):
        print("offline mode checks a mounted disk from live media where its kernel is not running; "
              "refusing / (the running system) without --force", file=sys.stderr)
        return 3
    if not os.path.isdir(root):
        print(f"{root} is not a directory", file=sys.stderr)
        return 3
    set_roots(sysroot=root)
    started = time.monotonic()
    warnings = self_check()
    file_package_cache.build()
    limit = int(getattr(args, "limit", 0) or 0)

    entries = collect_persistence()
    persist = persist_findings(entries)
    integrity, integrity_counts = offline_integrity_findings(limit)
    aur: List[Finding] = []
    packages: Optional[List[AurPackage]] = None
    if os.path.isdir(sys_path("/var/lib/pacman/local")):
        packages = check_aur_packages(getattr(args, "pkgbuild_dir", None), local_db_only=True)
        aur = [f for pkg in packages for f in pkg.findings]
    for group in (persist, integrity, aur):
        sort_findings(group)
    findings = persist + integrity + aur
    code = findings_exit_code(findings)
    emit_findings_outputs(args, "offline", findings, started)

    sections = {
        "persist": {"findings": [asdict(f) for f in persist], "counts": persist_counts(entries),
                    "entries": [asdict(e) for e in entries]},
        "integrity": {"findings": [asdict(f) for f in integrity], "counts": integrity_counts,
                      "limit": limit, "dirs": list(OFFLINE_EXEC_DIRS)},
        "aur": None if packages is None else {
            "findings": [asdict(f) for f in aur], "counts": finding_counts(aur),
            "packages": [{"name": p.name, "version": p.version, "pkgbuild": p.pkgbuild} for p in packages]},
    }
    if args.json:
        print(json.dumps(finding_payload(findings, sysroot=root, self_check=warnings, sections=sections), indent=2))
        return code

    print_self_check(warnings)
    print(f"Offline check of {root} (persistence, executable integrity, AUR; no process scan)\n")
    counts = persist_counts(entries)
    print("Persistence")
    shown = [f for f in persist if f.severity != "info"]
    if shown:
        print_findings(shown)
    else:
        print("  every persistence entry launches a packaged, intact executable")
    print(f"  {counts['total']} entries: {counts['critical']} critical, {counts['medium']} medium, "
          f"{counts['info']} info\n")

    print("Executable integrity")
    if integrity:
        print_findings(integrity)
    c = integrity_counts
    tail = f" (first {limit})" if limit else ""
    print(f"  {c['examined']} executables under /usr/bin and /usr/lib{tail}: {c['checked']} checked, "
          f"{c['intact']} intact, {c['modified']} modified, {c['unavailable']} unavailable, {c['unowned']} unowned\n")

    print("AUR")
    if packages is None:
        print("  no pacman local database under the sysroot")
    else:
        shown = [f for f in aur if f.severity != "info"]
        if shown:
            print_findings(shown, AUR_EXPLANATIONS, subject_header="PACKAGE")
        checked = sum(1 for p in packages if p.pkgbuild)
        ac = finding_counts(aur)
        print(f"  {len(packages)} foreign packages, {checked} PKGBUILDs checked: {ac['critical']} critical, "
              f"{ac['medium']} medium, {ac['low']} low, {ac['info']} info")
    total = finding_counts(findings)
    print(f"\n{total['critical']} critical, {total['medium']} medium, {total['low']} low, {total['info']} info")
    return code


# =============================================================================
# Fixture recorder (weird fixture record PID DIR)
# =============================================================================

FIXTURE_PROC_FILES = ("stat", "status", "comm", "cmdline", "maps", "environ", "cgroup")
FIXTURE_SECRET_KEYS = re.compile(r"KEY|TOKEN|SECRET|PASSWORD|API", re.I)


def redact_environ(data: bytes) -> Tuple[bytes, int]:
    """Values of KEY/TOKEN/SECRET/PASSWORD/API variables become 'redacted'; the keys stay so the checks still run."""
    items = []
    redacted = 0
    for item in data.split(b"\x00"):
        if not item:
            continue
        key, sep, value = item.partition(b"=")
        if sep and FIXTURE_SECRET_KEYS.search(key.decode("utf-8", errors="replace")):
            value = b"redacted"
            redacted += 1
        items.append(key + sep + value)
    return b"".join(i + b"\x00" for i in items), redacted


def _fixture_copy(src: str, dest: Path, data: Optional[bytes] = None) -> bool:
    if data is None:
        try:
            data = Path(src).read_bytes()
        except OSError:
            return False
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_bytes(data)
    return True


def _fixture_link(src: str, dest: Path) -> Optional[str]:
    try:
        target = os.readlink(src)
    except OSError:
        return None
    dest.parent.mkdir(parents=True, exist_ok=True)
    if dest.is_symlink() or dest.exists():
        dest.unlink()
    os.symlink(target, dest)
    return target


def record_package_db(package: str, manager: str, sysroot: Path) -> List[str]:
    """Copy the local database entry of one package (pacman desc/files/mtree, dpkg list/md5sums) under the fixture sysroot."""
    copied: List[str] = []
    if manager == "pacman":
        pkgdir = find_pacman_local_dir(package)
        if pkgdir:
            dest = sysroot / "var/lib/pacman/local" / pkgdir.name
            for name in ("desc", "files", "mtree"):
                if _fixture_copy(str(pkgdir / name), dest / name):
                    copied.append(f"var/lib/pacman/local/{pkgdir.name}/{name}")
    elif manager in ("dpkg", "apt"):
        info_dir = Path(sys_path("/var/lib/dpkg/info"))
        for src in sorted(info_dir.glob(f"{package}.*")) + sorted(info_dir.glob(f"{package}:*")):
            if src.suffix in (".list", ".md5sums"):
                if _fixture_copy(str(src), sysroot / "var/lib/dpkg/info" / src.name):
                    copied.append(f"var/lib/dpkg/info/{src.name}")
    return copied


def record_fixture(pid: int, directory: str) -> Dict:
    """Capture what weird reads about one live process into a tree that --proc-root DIR --sysroot DIR/sysroot replays."""
    root = Path(directory)
    sysroot = root / "sysroot"
    pid_dir = root / str(pid)
    summary: Dict = {"pid": pid, "dir": str(root), "files": [], "redacted": 0, "exe": "",
                     "packages": [], "ancestors": [], "sockets": 0}
    for name in FIXTURE_PROC_FILES:
        data = None
        if name == "environ":
            try:
                data, summary["redacted"] = redact_environ(Path(proc_path(pid, name)).read_bytes())
            except OSError:
                continue
        if _fixture_copy(proc_path(pid, name), pid_dir / name, data):
            summary["files"].append(name)
    exe = _fixture_link(proc_path(pid, "exe"), pid_dir / "exe")
    if exe is not None:
        summary["files"].append("exe")

    inodes: Set[str] = set()
    try:
        fds = os.listdir(proc_path(pid, "fd"))
    except OSError:
        fds = []
    for fd in fds:
        target = _fixture_link(proc_path(pid, "fd", fd), pid_dir / "fd" / fd)
        if target and target.startswith("socket:["):
            inodes.add(target[8:-1])
    if fds:
        summary["files"].append("fd")

    for apid, comm in ancestors(pid):
        for name in ("stat", "comm"):
            _fixture_copy(proc_path(apid, name), root / str(apid) / name)
        summary["ancestors"].append(f"{apid} ({comm})")

    _fixture_copy(proc_path("stat"), root / "stat")
    _fixture_copy(proc_path("sys", "kernel", "pid_max"), root / "sys/kernel/pid_max")
    for table in NET_SOCKET_TABLES:
        try:
            lines = Path(proc_path("net", table)).read_text().splitlines()
        except OSError:
            continue
        keep = [line for line in lines[1:] if len(line.split()) > 9 and line.split()[9] in inodes]
        summary["sockets"] += len(keep)
        _fixture_copy("", root / "net" / table, ("\n".join(lines[:1] + keep) + "\n").encode())

    file_package_cache.build()
    exe_path = normalize_exe_path(exe or "")
    if exe_path and not exe_path.startswith("/memfd:") and os.path.isfile(exe_path):
        dest = sysroot / exe_path.lstrip("/")
        dest.parent.mkdir(parents=True, exist_ok=True)
        try:
            shutil.copy2(exe_path, dest)
            summary["exe"] = exe_path
        except OSError:
            pass
    seen: Set[str] = set()
    for pathname in [exe_path] + (exec_file_mappings(pid) or []):
        mapped = pathname[:-len(" (deleted)")] if pathname.endswith(" (deleted)") else pathname
        package = file_package_cache.get(mapped) if mapped else None
        if not package or package in seen:
            continue
        seen.add(package)
        if record_package_db(package, file_package_cache.get_manager(mapped) or "", sysroot):
            summary["packages"].append(package)
    _fixture_copy(sys_path("/etc/pacman.conf"), sysroot / "etc/pacman.conf")
    sysroot.mkdir(parents=True, exist_ok=True)
    return summary


def cmd_fixture(args) -> int:
    if getattr(args, "fixture_cmd", None) != "record":
        print("usage: weird fixture record PID DIR", file=sys.stderr)
        return 2
    if not os.path.isdir(proc_path(args.pid)):
        print(f"pid {args.pid} not found under {PROC_ROOT}", file=sys.stderr)
        return 1
    summary = record_fixture(args.pid, args.dir)
    print(f"recorded pid {summary['pid']} into {summary['dir']}: {', '.join(summary['files']) or 'nothing readable'}")
    print(f"  environment values redacted: {summary['redacted']}; sockets kept: {summary['sockets']}; "
          f"ancestors: {', '.join(summary['ancestors']) or 'none'}")
    print(f"  sysroot: executable {summary['exe'] or 'not copied'}; package entries: "
          f"{', '.join(summary['packages']) or 'none'}")
    print(f"replay: weird --proc-root {summary['dir']} --sysroot {summary['dir']}/sysroot -v")
    return 0


def cmd_rules(args) -> int:
    """Output rules template, or the built-in rules with --defaults."""
    if getattr(args, "defaults", False):
        print(format_default_rules())
        return 0
    print(RULES_TEMPLATE)
    return 0


def cmd_man(args) -> int:
    """Show the manual page for weird."""
    man_candidates = [
        Path(__file__).resolve().parent / ".." / "man" / "weird.1",
        Path(__file__).resolve().parent / "weird.1",
        Path("/usr/local/share/man/man1/weird.1"),
        Path("/usr/share/man/man1/weird.1"),
    ]
    man_path = next((p for p in man_candidates if p.exists()), None)

    if not man_path:
        print("Man page not found. Expected under ../man/weird.1 or system man paths.")
        return 1

    man_bin = shutil.which("man")
    if man_bin:
        try:
            subprocess.run([man_bin, "-l", str(man_path)], check=False)
            return 0
        except (FileNotFoundError, OSError):
            pass

    try:
        print(man_path.read_text())
    except (OSError, UnicodeDecodeError):
        print(f"Man page found at {man_path} but could not be read.")
        return 1
    return 0


# =============================================================================
# Shell completions (weird completions bash|fish)
# =============================================================================

VALUE_OPTION_FILES = ("PATH", "FILE", "DIR", "SYSROOT")


def _parser_words(parser: argparse.ArgumentParser):
    """(options, value-taking options, {word: subparser or None}, help per word) of one parser."""
    options: List[Tuple[str, str, bool, bool]] = []
    words: Dict[str, Optional[argparse.ArgumentParser]] = {}
    help_by_word: Dict[str, str] = {}
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for name, sub in action.choices.items():
                words[name] = sub
            for choice in action._choices_actions:
                help_by_word[choice.dest] = choice.help or ""
        elif action.option_strings:
            if action.help is argparse.SUPPRESS:
                continue
            takes_value = action.nargs != 0
            hint = str(action.metavar or action.dest).upper()
            wants_file = takes_value and any(word in hint for word in VALUE_OPTION_FILES)
            for opt in action.option_strings:
                options.append((opt, action.help or "", takes_value, wants_file))
        elif action.choices:
            for choice in action.choices:
                words[choice] = None
    return options, words, help_by_word


def _short_help(text: str) -> str:
    text = " ".join(text.split())
    for stop in (". ", " (", ": ", "; "):
        if stop in text:
            text = text.split(stop, 1)[0]
    text = text.rstrip(".")
    if len(text) > 70:
        text = text[:70].rsplit(" ", 1)[0]
    return text


def _bash_completion(parser: argparse.ArgumentParser) -> str:
    value_opts: Set[str] = set()
    cases: List[str] = []

    def collect(p: argparse.ArgumentParser, path: Tuple[str, ...]) -> None:
        options, words, _ = _parser_words(p)
        value_opts.update(opt for opt, _h, takes, _f in options if takes)
        listed = [opt for opt, _h, _t, _f in options] + list(words)
        cases.append((path, " ".join(listed)))
        for name, sub in words.items():
            if sub is not None:
                collect(sub, path + (name,))

    collect(parser, ())
    cases.sort(key=lambda item: -len(item[0]))
    lines = ["# bash completion for weird, generated by `weird completions bash`",
             "# install: weird completions bash > ~/.local/share/bash-completion/completions/weird",
             "_weird() {",
             "    local cur prev cmd=\"\" sub=\"\" i words=\"\"",
             "    cur=${COMP_WORDS[COMP_CWORD]}",
             "    prev=${COMP_WORDS[COMP_CWORD-1]}",
             "    case \"$prev\" in",
             f"        {'|'.join(sorted(value_opts))}) compopt -o default 2>/dev/null; COMPREPLY=(); return ;;",
             "    esac",
             "    for ((i = 1; i < COMP_CWORD; i++)); do",
             "        case ${COMP_WORDS[i]} in",
             f"            {'|'.join(sorted(value_opts))}) ((i++)) ;;",
             "            -*) ;;",
             "            *) if [ -z \"$cmd\" ]; then cmd=${COMP_WORDS[i]}; elif [ -z \"$sub\" ]; then sub=${COMP_WORDS[i]}; fi ;;",
             "        esac",
             "    done",
             "    case \"$cmd $sub\" in"]
    for path, listed in cases:
        key = " ".join(path) if path else ""
        pattern = f'"{key} "' if len(path) < 2 else f'"{key}"'
        if len(path) == 1:
            pattern = f'"{key} "*'
        lines.append(f"        {pattern}) words=\"{listed}\" ;;")
    lines += ["    esac",
              "    mapfile -t COMPREPLY < <(compgen -W \"$words\" -- \"$cur\")",
              "}",
              "complete -F _weird weird"]
    return "\n".join(lines) + "\n"


def _fish_completion(parser: argparse.ArgumentParser) -> str:
    def q(text: str) -> str:
        return text.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$")

    top_words = " ".join(_parser_words(parser)[1])
    lines = ["# fish completion for weird, generated by `weird completions fish`",
             "# install: weird completions fish > ~/.config/fish/completions/weird.fish",
             "function __weird_no_subcommand",
             f"    not __fish_seen_subcommand_from {top_words}",
             "end",
             "complete -c weird -f"]

    def emit(p: argparse.ArgumentParser, condition: str, path: Tuple[str, ...]) -> None:
        options, words, help_by_word = _parser_words(p)
        for opt, help_text, takes_value, wants_file in options:
            flag = f"-l {opt[2:]}" if opt.startswith("--") else f"-s {opt[1:]}"
            arg = (" -r -F" if wants_file else " -x") if takes_value else ""
            lines.append(f'complete -c weird -n "{condition}" {flag}{arg} -d "{q(_short_help(help_text))}"')
        for name, sub in words.items():
            desc = q(_short_help(help_by_word.get(name, "")))
            lines.append(f'complete -c weird -n "{condition}" -a {name} -d "{desc}"')
        for name, sub in words.items():
            if sub is not None:
                seen = "; and ".join(f"__fish_seen_subcommand_from {p}" for p in path + (name,))
                inner = [w for w in _parser_words(sub)[1]]
                if inner:
                    seen += f"; and not __fish_seen_subcommand_from {' '.join(inner)}"
                emit(sub, seen, path + (name,))

    emit(parser, "__weird_no_subcommand", ())
    return "\n".join(lines) + "\n"


def cmd_completions(args, parser: argparse.ArgumentParser) -> int:
    """Print a bash or fish completion script generated from the argparse tree."""
    print(_bash_completion(parser) if args.shell == "bash" else _fish_completion(parser), end="")
    return 0


# =============================================================================
# Main
# =============================================================================

def build_dev_parser() -> argparse.ArgumentParser:
    """The old command tree, kept under `weird dev` for scripts and tests."""
    parser = argparse.ArgumentParser(
        prog="weird dev",
        description="Developer and single-section commands of weird (the plain `weird` runs them all)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
SECURITY WARNING:
  Trust levels indicate PROVENANCE (where software came from), NOT security.
  Even 'OFFICIAL' packages can contain vulnerabilities or be compromised
  (e.g., xz backdoor, March 2024). Use this tool as part of defense-in-depth,
  not as your only security control.

Trust Levels:
  OFFICIAL      Signed by system keyring - provenance verified, NOT vuln-free
  THIRD_PARTY   From apt but signed by other key (PPA, etc.) - higher risk
  FLATPAK       Flatpak application - check permissions
  SNAP          Snap application - verify confinement level
  APPIMAGE      Portable AppImage - NO sandboxing, user responsibility
  USER_LOCAL    In ~/.local/bin or /usr/local - verify source manually
  USER_PKG      Installed by uv/pipx/npm/cargo/rustup/go/nvm (own metadata, no signature)
  LOCAL_BUILD   Built locally via makepkg (AUR) - no repo signature, verify PKGBUILD
  CONTAINER     Running in container namespace
  KERNEL        Kernel thread (part of Linux kernel)
  UNKNOWN       No provenance found - INVESTIGATE

Examples:
  weird                 Scan for suspicious processes
  weird -v              Show all processes with classification
  weird --net           Focus on processes with network activity
  weird --deep          Also hash every packaged binary against its package
  weird inspect 1234    Deep dive on PID 1234
  weird trust myapp     Add 'myapp' to trusted list
  weird baseline trust 1234       Record the hash of PID 1234's executable; scans suppress it until the file changes
  weird watch           Poll /proc every 2 s, one NDJSON line per new flagged process (no root, no Falco)
  weird watch --falco   Monitor Falco alerts instead (requires Falco)
  weird --journal       Also send each alert to the systemd journal (journalctl -t weird)
  weird --prometheus /var/lib/node_exporter/textfile_collector/weird.prom   Write node_exporter metrics
  weird restart-needed  Processes still running files replaced by an upgrade (needrestart is not in the official Arch repositories)
  weird persist         Persistence entries (units, cron, autostart, hooks) and what they launch
  weird hidden          Hidden processes, threads and sockets (readdir vs stat, /proc/net vs ss)
  weird kernel          Loaded module cross-view and ownership, taint, hardening posture
  weird aur             PKGBUILD supply chain checks for locally built (AUR) packages
  weird self-check      Own-process checks and the sha256 of this script against its pin
  weird offline /mnt/root   Live-media mode: persist, integrity and aur on a mounted disk
  weird fixture record 1234 DIR   Capture PID 1234 for replay with --proc-root DIR --sysroot DIR/sysroot
  weird man             Show the manual page
  weird completions fish > ~/.config/fish/completions/weird.fish   Shell completions (bash or fish)
  weird --debug-log /tmp/weird.log   Enable debug logging
        """
    )

    parser.add_argument("--version", action="version", version=f"weird {__version__}")
    parser.add_argument("-v", "--verbose", action="store_true",
                       help="Show all processes, not just suspicious ones")
    parser.add_argument("-a", "--all", action="store_true",
                       help="Include containers, Flatpak, and Snap (normally filtered)")
    parser.add_argument("--net", action="store_true",
                       help="Focus on processes with network activity")
    parser.add_argument("--net-outbound-only", action="store_true",
                       help="Only include outbound connections (default)")
    parser.add_argument("--include-listen", action="store_true",
                       help="Include listening sockets in network view")
    parser.add_argument("--enrich-net", action="store_true",
                       help="Enable network enrichment (best-effort)")
    parser.add_argument("--deep", action="store_true",
                       help="Hash every OFFICIAL/THIRD_PARTY executable against its package "
                            "(default: only flagged processes; slower)")
    parser.add_argument("--json", action="store_true",
                       help="Output JSON results")
    parser.add_argument("--ndjson", action="store_true",
                       help="Output newline-delimited JSON (one process per line)")
    parser.add_argument("--journal", action="store_true",
                       help="Send each alert to the systemd journal (SYSLOG_IDENTIFIER=weird, WEIRD_* fields)")
    parser.add_argument("--prometheus", metavar="PATH",
                       help="Write a node_exporter textfile with weird_alerts, weird_processes_total and "
                            "scan timestamp/duration (atomic rename into PATH)")
    parser.add_argument("--log-file", dest="log_file",
                       help="Append logs to a file (no secrets)")
    parser.add_argument("--raw-cmdline", action="store_true",
                       help="Include raw cmdline in JSON/NDJSON output (may contain secrets)")
    parser.add_argument("--debug-log", dest="debug_log", metavar="FILE",
                       help="Enable debug logging to FILE (for troubleshooting)")
    parser.add_argument("--proc-root", dest="proc_root", metavar="DIR",
                       default=os.environ.get("WEIRD_PROC_ROOT"),
                       help="Read process info from DIR instead of /proc (offline analysis, tests)")
    parser.add_argument("--sysroot", dest="sysroot", metavar="DIR",
                       default=os.environ.get("WEIRD_SYSROOT"),
                       help="Prefix for package databases and system config (offline analysis, tests)")

    add_dev_commands(parser)
    return parser


def add_watch_arguments(watch_parser: argparse.ArgumentParser) -> None:

    watch_parser.add_argument("--poll", type=float, default=None, metavar="SECONDS",
                              help="Seconds between /proc scans (default 2); given explicitly it also turns off "
                                   "the automatic switch to the sensor's events file")
    watch_parser.add_argument("--events", metavar="PATH",
                              help="Read weird-sensor NDJSON events from PATH instead of polling (chosen "
                                   f"automatically when {SENSOR_EVENTS_FILE} was written in the last "
                                   f"{SENSOR_FRESH_SECONDS} s)")
    watch_parser.add_argument("--follow", dest="follow", action="store_true", default=None,
                              help="Keep tailing the events file after end of file (default for paths under /run)")
    watch_parser.add_argument("--no-follow", dest="follow", action="store_false",
                              help="Stop at end of file (default for paths elsewhere)")
    watch_parser.add_argument("--falco", action="store_true",
                              help="Run Falco in the foreground with the weird rules instead of polling "
                                   "(needs /usr/bin/falco and sudo)")
    watch_parser.add_argument("--journal", action="store_true", default=argparse.SUPPRESS,
                              help="Send each alert and finding to the systemd journal")


WATCH_HELP = ("Print one NDJSON line per new flagged process: from the weird-sensor events file when it is fresh, "
              "else by polling /proc (--falco runs Falco instead)")


def add_dev_commands(parser: argparse.ArgumentParser) -> None:
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("scan", help="Process scan only (the first section of a plain `weird` run)")

    # inspect subcommand
    inspect_parser = subparsers.add_parser("inspect", help="Detailed inspection of a PID")
    inspect_parser.add_argument("pid", type=int, help="Process ID to inspect")

    # trust subcommand
    trust_parser = subparsers.add_parser("trust", help="Add to user-trusted list")
    trust_parser.add_argument("name", help="Process name or path to trust")

    # rules subcommand
    rules_parser = subparsers.add_parser("rules", help="Manage rules")
    rules_sub = rules_parser.add_subparsers(dest="rules_cmd")
    rules_show = rules_sub.add_parser("show", help="Print rules template")
    rules_show.add_argument("--defaults", action="store_true", help="Print the built-in rules instead")
    rules_init = rules_sub.add_parser("init", help="Write rules template to disk")
    rules_init.add_argument("--force", action="store_true", help="Overwrite existing rules")

    # cache subcommand
    cache_parser = subparsers.add_parser("cache", help="Manage file->package cache")
    cache_parser.add_argument("--rebuild", action="store_true",
                             help="Force rebuild the cache")

    add_watch_arguments(subparsers.add_parser("watch", help=WATCH_HELP))

    def output_flags(sub) -> None:
        sub.add_argument("--journal", action="store_true", default=argparse.SUPPRESS,
                         help="Send each finding to the systemd journal")
        sub.add_argument("--prometheus", metavar="PATH", default=argparse.SUPPRESS,
                         help="Write a node_exporter textfile with weird_findings counts")

    # restart-needed subcommand
    restart_parser = subparsers.add_parser(
        "restart-needed",
        help="List processes running executables or libraries replaced by a package upgrade, grouped by systemd unit")
    restart_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                                help="Output JSON")

    # persist subcommand
    persist_parser = subparsers.add_parser(
        "persist",
        help="List persistence entries (systemd units, cron, autostart, shell rc, ld.so.preload, udev, "
             "pacman hooks, makepkg.conf) with the provenance of what each one launches")
    persist_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                                help="Output JSON")
    persist_parser.add_argument("-a", "--all", action="store_true", default=argparse.SUPPRESS,
                                help="Also list entries whose target is a packaged, intact executable")
    output_flags(persist_parser)

    # hidden subcommand
    hidden_parser = subparsers.add_parser(
        "hidden",
        help="Find hidden processes, threads and sockets by comparing the /proc listing with direct "
             "stat probes up to pid_max, /proc/net with ss over netlink, and status thread counts with task dirs")
    hidden_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                               help="Output JSON")
    output_flags(hidden_parser)

    # kernel subcommand
    kernel_parser = subparsers.add_parser(
        "kernel",
        help="Loaded modules across /proc/modules, /sys/module and kallsyms, module file ownership, "
             "taint flags and a hardening posture report (Secure Boot, lockdown, module signing, sysctls)")
    kernel_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                               help="Output JSON")
    output_flags(kernel_parser)

    # aur subcommand
    aur_parser = subparsers.add_parser(
        "aur",
        help="Supply chain checks on the PKGBUILDs behind locally built packages: insecure or paste host "
             "sources, missing or SKIP checksums, install scripts, PKGBUILD changed after install")
    aur_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                            help="Output JSON")
    aur_parser.add_argument("-a", "--all", action="store_true", default=argparse.SUPPRESS,
                            help="Also list info entries (install scripts, VCS sources, unavailable PKGBUILDs)")
    aur_parser.add_argument("--pkgbuild-dir", dest="pkgbuild_dir", metavar="DIR",
                            help="Directory holding <package>/PKGBUILD clones, checked before the paru and yay caches")
    aur_parser.add_argument("--campaigns", metavar="PATH",
                            help="Known-bad package list (campaigns.json) to use; never fetches or prompts")
    aur_parser.add_argument("--fetch-campaigns", dest="fetch_campaigns", action="store_true",
                            help="Download the known-bad package list now without asking")
    output_flags(aur_parser)

    # self-check subcommand
    selfcheck_parser = subparsers.add_parser(
        "self-check",
        help="Startup self-check items (ld.so.preload, loader variables, unowned mappings) and the self "
             "integrity result: sha256 of this script against the pin in package.json")
    selfcheck_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                                  help="Output JSON")

    # offline subcommand
    offline_parser = subparsers.add_parser(
        "offline",
        help="Live-media mode: persist, executable integrity (/usr/bin, /usr/lib) and aur against a mounted "
             "disk at SYSROOT, no process scan; refuses / without --force")
    offline_parser.add_argument("sysroot_dir", metavar="SYSROOT", help="Mounted root of the disk to check")
    offline_parser.add_argument("--force", action="store_true", help="Allow SYSROOT to be / (the running system)")
    offline_parser.add_argument("--limit", type=int, default=0, metavar="N",
                                help="Check only the first N executables (default: all)")
    offline_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                                help="Output JSON with a section per part")
    offline_parser.add_argument("--pkgbuild-dir", dest="pkgbuild_dir", metavar="DIR",
                                help="Directory holding <package>/PKGBUILD clones for the aur part")
    output_flags(offline_parser)

    # fixture subcommand
    fixture_parser = subparsers.add_parser(
        "fixture", help="Record a live process into a tree that --proc-root DIR --sysroot DIR/sysroot replays")
    fixture_sub = fixture_parser.add_subparsers(dest="fixture_cmd")
    fixture_record = fixture_sub.add_parser(
        "record", help="Copy the /proc files weird reads for PID, its exe and the owning package entries into DIR "
                       "(KEY/TOKEN/SECRET/PASSWORD/API environment values redacted)")
    fixture_record.add_argument("pid", type=int, help="Process ID to record")
    fixture_record.add_argument("dir", metavar="DIR", help="Fixture directory to write")

    # falco rules subcommand
    subparsers.add_parser("falco-rules", help="Output Falco rules for integration")

    # man subcommand
    subparsers.add_parser("man", help="Show the manual page")

    # completions subcommand
    completions_parser = subparsers.add_parser(
        "completions", help="Print a completion script for bash or fish, generated from this command tree")
    completions_parser.add_argument("shell", choices=["bash", "fish"], help="Shell to generate for")

    # baseline subcommand
    baseline_parser = subparsers.add_parser(
        "baseline",
        help="Baseline/diff mode; trust <pid|path> records an executable hash so scans stay quiet "
             "until the file changes, untrust <path> removes it")
    baseline_parser.add_argument("baseline_cmd", choices=["init", "show", "diff", "trust", "untrust"],
                                 help="Baseline action")
    baseline_parser.add_argument("target", nargs="?", help="PID or path for trust, path for untrust")
    return parser


def dev_main(args, parser: argparse.ArgumentParser) -> int:
    """Dispatch for the dev command tree (and the verbs that reuse it)."""
    if args.command == "inspect":
        return cmd_inspect(args)
    elif args.command == "trust":
        return cmd_trust(args)
    elif args.command == "cache":
        return cmd_cache(args)
    elif args.command == "watch":
        return cmd_watch(args)
    elif args.command == "restart-needed":
        return cmd_restart_needed(args)
    elif args.command == "persist":
        return cmd_persist(args)
    elif args.command == "hidden":
        return cmd_hidden(args)
    elif args.command == "kernel":
        return cmd_kernel(args)
    elif args.command == "aur":
        return cmd_aur(args)
    elif args.command == "self-check":
        return cmd_self_check(args)
    elif args.command == "offline":
        return cmd_offline(args)
    elif args.command == "fixture":
        return cmd_fixture(args)
    elif args.command == "rules":
        if args.rules_cmd == "init":
            return cmd_rules_init(args)
        return cmd_rules(args)
    elif args.command == "falco-rules":
        print(FALCO_RULES)
        return 0
    elif args.command == "man":
        return cmd_man(args)
    elif args.command == "completions":
        return cmd_completions(args, parser)
    elif args.command == "baseline":
        if args.baseline_cmd == "trust":
            return cmd_baseline_trust(args)
        if args.baseline_cmd == "untrust":
            return cmd_baseline_untrust(args)
        return cmd_scan(args)
    else:
        return cmd_scan(args)


SECTIONS = ("processes", "aur", "persist", "kernel", "stale", "hidden")
VERBS = ("dev", "trust", "untrust", "watch")
VALUE_OPTIONS = ("--skip", "--prometheus", "--offline", "--proc-root", "--sysroot", "--log-file", "--debug-log")
_self_check_shown = False


def build_parser(with_verbs: bool = False) -> argparse.ArgumentParser:
    """The one-command parser. with_verbs adds the verb tree (completions and docs only)."""
    parser = argparse.ArgumentParser(
        prog="weird",
        usage="weird [options]\n       weird PID | PATH\n       weird trust PID|PATH\n       weird untrust PATH\n"
              "       weird watch [--poll S | --events PATH | --falco]",
        description=textwrap.fill(
            "One run, one report: process scan, AUR packages, persistence entries, kernel posture, "
            "stale binaries and hidden-process cross-views, with a summary line and one exit code "
            "(0 clean, 1 medium or warning, 2 critical, 3 a collector failed). Trust levels mean "
            "provenance, not security.", 78),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.fill(
            "weird PID or weird PATH inspects one process or file; weird trust pins an executable so scans "
            "stay quiet until it changes; weird watch streams new flagged processes.", 78)
            + "\nDeveloper and single-section commands live under `weird dev` (weird dev --help).")
    parser.add_argument("target", nargs="?", metavar="PID|PATH", help=argparse.SUPPRESS)
    parser.add_argument("--version", action="version", version=f"weird {__version__}")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="All processes, info rows and the notes behind each finding")
    parser.add_argument("--json", action="store_true", help="One JSON object, a key per section plus summary")
    parser.add_argument("--ndjson", action="store_true", help="One JSON line per process (scan section only)")
    parser.add_argument("--journal", action="store_true", help="Send alerts and findings to the systemd journal")
    parser.add_argument("--prometheus", metavar="PATH", help="Write node_exporter textfile metrics to PATH")
    parser.add_argument("--deep", action="store_true", help="Hash every packaged executable against its package")
    parser.add_argument("--offline", metavar="SYSROOT",
                        help="Live-media mode: check a mounted disk (no process or hidden sections)")
    parser.add_argument("--skip", action="append", default=[], choices=SECTIONS, metavar="SECTION",
                        help="Leave out a section (repeatable): " + ", ".join(SECTIONS))
    parser.add_argument("--no-prompt", dest="no_prompt", action="store_true", help="Never ask questions (the known-bad list fetch)")
    parser.add_argument("--proc-root", dest="proc_root", metavar="DIR", default=os.environ.get("WEIRD_PROC_ROOT"),
                        help="Read process info from DIR instead of /proc (replays, tests)")
    parser.add_argument("--sysroot", dest="sysroot", metavar="DIR", default=os.environ.get("WEIRD_SYSROOT"),
                        help="Prefix for package databases and system config (replays, tests)")
    parser.add_argument("--debug-log", dest="debug_log", metavar="FILE", help=argparse.SUPPRESS)
    if with_verbs:
        verbs = parser.add_subparsers(dest="verb")
        verbs.add_parser("trust", help="Pin an executable hash").add_argument("target")
        verbs.add_parser("untrust", help="Remove a pinned executable").add_argument("target")
        add_watch_arguments(verbs.add_parser("watch", help=WATCH_HELP))
        add_dev_commands(verbs.add_parser("dev", help="Developer and single-section commands"))
    return parser


def split_argv(argv: List[str]) -> Tuple[List[str], Optional[str], List[str]]:
    """Main flags before the first verb word, the verb, and everything after it."""
    skip_value = False
    for i, word in enumerate(argv):
        if skip_value:
            skip_value = False
            continue
        if word in VALUE_OPTIONS:
            skip_value = True
            continue
        if word.startswith("-"):
            continue
        if word in VERBS:
            return argv[:i], word, argv[i + 1:]
        break
    return argv, None, []


def dev_args(main_args, words: List[str], parser: argparse.ArgumentParser) -> argparse.Namespace:
    """Parse words with the dev parser and carry the main flags over."""
    args, extra = parser.parse_known_args(words)
    if extra:
        parser.parse_args(extra, namespace=args)
    for key in ("verbose", "json", "ndjson", "journal", "prometheus", "deep", "proc_root", "sysroot", "debug_log"):
        if getattr(main_args, key, None) and not getattr(args, key, None):
            setattr(args, key, getattr(main_args, key))
    return args


def section_args(main_args, parser: argparse.ArgumentParser, command: str, **extra) -> argparse.Namespace:
    args = dev_args(main_args, [command], parser)
    args.all = main_args.verbose
    for key, value in extra.items():
        setattr(args, key, value)
    return args


def run_section(fn, args) -> Tuple[Dict, str, int]:
    """Run one section command, capturing its JSON payload or its table text."""
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        code = fn(args)
    text = buf.getvalue()
    if args.json:
        return json.loads(text), "", code
    return {}, text, code


def section_counts() -> Dict[str, int]:
    return {level: _last_counts.get(level, 0) for level in ("critical", "medium", "low", "info")}


def run_all(args) -> Tuple[Dict, Dict, int]:
    """Every section in order; returns ({section: payload or text}, summary, exit code)."""
    parser = build_dev_parser()
    sections: Dict[str, object] = {}
    summary = {"critical": 0, "medium": 0, "low": 0, "info": 0}
    exit_code = 0
    if "aur" not in getattr(args, "skip", None or []):
        chosen = maybe_offer_campaign_update(args)
        if chosen is not None:
            args.campaigns = str(chosen)
    plan = [
        ("processes", cmd_scan, "Processes", {}),
        ("aur", cmd_aur, "AUR packages", {}),
        ("persist", cmd_persist, "Persistence", {}),
        ("kernel", cmd_kernel, "Kernel", {}),
        ("stale", cmd_restart_needed, "Stale binaries (restart needed)", {"prometheus": None, "journal": False}),
        ("hidden", cmd_hidden, "Hidden processes", {}),
    ]
    command = {"processes": "scan", "stale": "restart-needed"}
    for name, fn, title, extra in plan:
        if name in args.skip:
            continue
        if name != "processes":
            extra = dict(extra, prometheus=None)
        sub = section_args(args, parser, command.get(name, name), **extra)
        _last_counts.clear()
        payload, text, code = run_section(fn, sub)
        counts = section_counts()
        for level in summary:
            summary[level] += counts[level]
        exit_code = 3 if 3 in (exit_code, code) else max(exit_code, code)
        if args.json:
            sections[name] = payload
        elif name != "stale" or code:
            print(f"\n== {title} ==\n")
            print(text.rstrip("\n"))
    summary["exit_code"] = exit_code
    return sections, summary, exit_code


def summary_line(summary: Dict) -> str:
    return (f"summary: {summary['critical']} critical, {summary['medium']} medium, {summary['low']} low, "
            f"{summary['info']} info across all sections (exit {summary['exit_code']})")


def cmd_all(args) -> int:
    global _self_check_shown
    warnings = self_check()
    if not args.json and not args.ndjson:
        print_self_check(warnings)
        _self_check_shown = True
    if args.ndjson:
        parser = build_dev_parser()
        return cmd_scan(section_args(args, parser, "scan"))
    sections, summary, exit_code = run_all(args)
    if args.json:
        payload = {"host": socket.gethostname(), "timestamp": int(time.time()), "self_check": warnings,
                   "self_integrity": _self_integrity}
        payload.update(sections)
        payload["summary"] = summary
        print(json.dumps(payload, indent=2))
        return exit_code
    print()
    print(summary_line(summary))
    return exit_code


def main(argv: Optional[List[str]] = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    main_words, verb, rest = split_argv(argv)
    parser = build_parser()
    args = parser.parse_args(main_words)
    set_roots(args.proc_root, args.sysroot)
    check_self_integrity()

    global DEBUG_LOG_FILE
    if getattr(args, 'debug_log', None):
        DEBUG_LOG_FILE = Path(args.debug_log)
        debug_log("startup", f"Debug logging enabled to {DEBUG_LOG_FILE}")

    dev = build_dev_parser()
    if verb == "dev":
        if not rest or rest == ["--help"] or rest == ["-h"]:
            dev.print_help()
            return 0
        sub = dev_args(args, rest, dev)
        if sub.command == "completions":
            return cmd_completions(sub, build_parser(with_verbs=True))
        return dev_main(sub, dev)
    if verb in ("trust", "untrust"):
        return dev_main(dev_args(args, ["baseline", verb] + rest, dev), dev)
    if verb == "watch":
        return dev_main(dev_args(args, ["watch"] + rest, dev), dev)
    if args.offline:
        sub = dev_args(args, ["offline", args.offline], dev)
        return cmd_offline(sub)
    if args.target is not None:
        if args.target.isdigit():
            sub = dev_args(args, ["inspect", args.target], dev)
            return cmd_inspect(sub)
        if os.path.exists(args.target):
            sub = dev_args(args, ["inspect", "0"], dev)
            sub.path = args.target
            return cmd_inspect(sub)
        parser.error(f"{args.target} is neither a pid nor an existing path")
    return cmd_all(args)


if __name__ == "__main__":
    sys.exit(main())
