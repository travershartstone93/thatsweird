def add_watch_arguments(watch_parser: argparse.ArgumentParser) -> None:

    watch_parser.add_argument("--poll", type=float, default=None, metavar="SECONDS",
                              help="Seconds between /proc scans (default 2); given explicitly it also turns off "
                                   "the automatic switch to the sensor's events file")
    watch_parser.add_argument("--events", metavar="PATH",
                              help="Read weird-sensor NDJSON events from PATH instead of polling (chosen "
                                   f"automatically when {SENSOR_EVENTS_FILE} was written in the last "
                                   f"{SENSOR_FRESH_SECONDS} s)")
    watch_parser.add_argument("--follow", dest="follow", action="store_true", default=None,
                              help="Keep tailing the events file after end of file (default for paths under /run)")
    watch_parser.add_argument("--no-follow", dest="follow", action="store_false",
                              help="Stop at end of file (default for paths elsewhere)")
    watch_parser.add_argument("--falco", action="store_true",
                              help="Run Falco in the foreground with the weird rules instead of polling "
                                   "(needs /usr/bin/falco and sudo)")
    watch_parser.add_argument("--journal", action="store_true", default=argparse.SUPPRESS,
                              help="Send each alert and finding to the systemd journal")


WATCH_HELP = ("Print one NDJSON line per new flagged process: from the weird-sensor events file when it is fresh, "
              "else by polling /proc (--falco runs Falco instead)")


def add_dev_commands(parser: argparse.ArgumentParser) -> None:
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("scan", help="Process scan only (the first section of a plain `weird` run)")

    # inspect subcommand
    inspect_parser = subparsers.add_parser("inspect", help="Detailed inspection of a PID")
    inspect_parser.add_argument("pid", type=int, help="Process ID to inspect")

    # trust subcommand
    trust_parser = subparsers.add_parser("trust", help="Add to user-trusted list")
    trust_parser.add_argument("name", help="Process name or path to trust")

    # rules subcommand
    rules_parser = subparsers.add_parser("rules", help="Manage rules")
    rules_sub = rules_parser.add_subparsers(dest="rules_cmd")
    rules_show = rules_sub.add_parser("show", help="Print rules template")
    rules_show.add_argument("--defaults", action="store_true", help="Print the built-in rules instead")
    rules_init = rules_sub.add_parser("init", help="Write rules template to disk")
    rules_init.add_argument("--force", action="store_true", help="Overwrite existing rules")

    # cache subcommand
    cache_parser = subparsers.add_parser("cache", help="Manage file->package cache")
    cache_parser.add_argument("--rebuild", action="store_true",
                             help="Force rebuild the cache")

    add_watch_arguments(subparsers.add_parser("watch", help=WATCH_HELP))

    def output_flags(sub) -> None:
        sub.add_argument("--journal", action="store_true", default=argparse.SUPPRESS,
                         help="Send each finding to the systemd journal")
        sub.add_argument("--prometheus", metavar="PATH", default=argparse.SUPPRESS,
                         help="Write a node_exporter textfile with weird_findings counts")

    # restart-needed subcommand
    restart_parser = subparsers.add_parser(
        "restart-needed",
        help="List processes running executables or libraries replaced by a package upgrade, grouped by systemd unit")
    restart_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                                help="Output JSON")

    # persist subcommand
    persist_parser = subparsers.add_parser(
        "persist",
        help="List persistence entries (systemd units, cron, autostart, shell rc, ld.so.preload, udev, "
             "pacman hooks, makepkg.conf) with the provenance of what each one launches")
    persist_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                                help="Output JSON")
    persist_parser.add_argument("-a", "--all", action="store_true", default=argparse.SUPPRESS,
                                help="Also list entries whose target is a packaged, intact executable")
    output_flags(persist_parser)

    # hidden subcommand
    hidden_parser = subparsers.add_parser(
        "hidden",
        help="Find hidden processes, threads and sockets by comparing the /proc listing with direct "
             "stat probes up to pid_max, /proc/net with ss over netlink, and status thread counts with task dirs")
    hidden_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                               help="Output JSON")
    hidden_parser.add_argument("--deep", action="store_true", default=argparse.SUPPRESS,
                               help="Probe every pid up to pid_max, not only up to the last pid assigned")
    output_flags(hidden_parser)

    # kernel subcommand
    kernel_parser = subparsers.add_parser(
        "kernel",
        help="Loaded modules across /proc/modules, /sys/module and kallsyms, module file ownership, "
             "taint flags and a hardening posture report (Secure Boot, lockdown, module signing, sysctls)")
    kernel_parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                               help="Output JSON")
    output_flags(kernel_parser)

    # aur subcommand
    aur_parser = subparsers.add_parser(
        "aur",
        help="Supply chain checks on the PKGBUILDs behind locally built packages: insecure or paste host "
             "sources, missing or SKIP checksums, install scripts, PKGBUILD changed after install")
