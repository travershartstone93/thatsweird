# Main
# =============================================================================

def build_dev_parser() -> argparse.ArgumentParser:
    """The old command tree, kept under `weird dev` for scripts and tests."""
    parser = argparse.ArgumentParser(
        prog="weird dev",
        description="Developer and single-section commands of weird (the plain `weird` runs them all)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
SECURITY WARNING:
  Trust levels indicate PROVENANCE (where software came from), NOT security.
  Even 'OFFICIAL' packages can contain vulnerabilities or be compromised
  (e.g., xz backdoor, March 2024). Use this tool as part of defense-in-depth,
  not as your only security control.

Trust Levels:
  OFFICIAL      Signed by system keyring - provenance verified, NOT vuln-free
  THIRD_PARTY   From apt but signed by other key (PPA, etc.) - higher risk
  FLATPAK       Flatpak application - check permissions
  SNAP          Snap application - verify confinement level
  APPIMAGE      Portable AppImage - NO sandboxing, user responsibility
  USER_LOCAL    In ~/.local/bin or /usr/local - verify source manually
  USER_PKG      Installed by uv/pipx/npm/cargo/rustup/go/nvm (own metadata, no signature)
  PUBLISHER_SIGNED  The publisher's signed release list names this file's hash
  PUBLISHER_HOSTED  An unsigned checksum list on the publisher's host (TLS) names it
  LOCAL_BUILD   Built locally via makepkg (AUR) - no repo signature, verify PKGBUILD
  CONTAINER     Running in container namespace
  KERNEL        Kernel thread (part of Linux kernel)
  UNKNOWN       No provenance found - INVESTIGATE

Examples:
  weird                 Scan for suspicious processes
  weird -v              Show all processes with classification
  weird --net           Focus on processes with network activity
  weird --deep          Also hash every packaged binary against its package
  weird inspect 1234    Deep dive on PID 1234
  weird trust myapp     Add 'myapp' to trusted list
  weird baseline trust 1234       Record the hash of PID 1234's executable; scans suppress it until the file changes
  weird watch           Poll /proc every 2 s, one NDJSON line per new flagged process (no root, no Falco)
  weird watch --falco   Monitor Falco alerts instead (requires Falco)
  weird --journal       Also send each alert to the systemd journal (journalctl -t weird)
  weird --prometheus /var/lib/node_exporter/textfile_collector/weird.prom   Write node_exporter metrics
  weird restart-needed  Processes still running files replaced by an upgrade (needrestart is not in the official Arch repositories)
  weird persist         Persistence entries (units, cron, autostart, hooks) and what they launch
  weird hidden          Hidden processes, threads and sockets (readdir vs stat, /proc/net vs ss)
  weird kernel          Loaded module cross-view and ownership, taint, hardening posture
  weird aur             PKGBUILD supply chain checks for locally built (AUR) packages
  weird self-check      Own-process checks and the sha256 of this script against its pin
  weird offline /mnt/root   Live-media mode: persist, integrity and aur on a mounted disk
  weird fixture record 1234 DIR   Capture PID 1234 for replay with --proc-root DIR --sysroot DIR/sysroot
  weird man             Show the manual page
  weird completions fish > ~/.config/fish/completions/weird.fish   Shell completions (bash or fish)
  weird --debug-log /tmp/weird.log   Enable debug logging
        """
    )

    parser.add_argument("--version", action="version", version=f"weird {__version__}")
    parser.add_argument("-v", "--verbose", action="store_true",
                       help="Show all processes, not just suspicious ones")
    parser.add_argument("-a", "--all", action="store_true",
                       help="Include containers, Flatpak, and Snap (normally filtered)")
    parser.add_argument("--net", action="store_true",
                       help="Focus on processes with network activity")
    parser.add_argument("--net-outbound-only", action="store_true",
                       help="Only include outbound connections (default)")
    parser.add_argument("--include-listen", action="store_true",
                       help="Include listening sockets in network view")
    parser.add_argument("--enrich-net", action="store_true",
                       help="Enable network enrichment (best-effort)")
    parser.add_argument("--deep", action="store_true",
                       help="Hash every OFFICIAL/THIRD_PARTY executable against its package "
                            "(default: only flagged processes; slower)")
    parser.add_argument("--json", action="store_true",
                       help="Output JSON results")
    parser.add_argument("--ndjson", action="store_true",
                       help="Output newline-delimited JSON (one process per line)")
    parser.add_argument("--journal", action="store_true",
                       help="Send each alert to the systemd journal (SYSLOG_IDENTIFIER=weird, WEIRD_* fields)")
    parser.add_argument("--prometheus", metavar="PATH",
                       help="Write a node_exporter textfile with weird_alerts, weird_processes_total and "
                            "scan timestamp/duration (atomic rename into PATH)")
    parser.add_argument("--log-file", dest="log_file",
                       help="Append logs to a file (no secrets)")
    parser.add_argument("--raw-cmdline", action="store_true",
                       help="Include raw cmdline in JSON/NDJSON output (may contain secrets)")
    parser.add_argument("--debug-log", dest="debug_log", metavar="FILE",
                       help="Enable debug logging to FILE (for troubleshooting)")
    parser.add_argument("--proc-root", dest="proc_root", metavar="DIR",
                       default=os.environ.get("WEIRD_PROC_ROOT"),
                       help="Read process info from DIR instead of /proc (offline analysis, tests)")
    parser.add_argument("--sysroot", dest="sysroot", metavar="DIR",
                       default=os.environ.get("WEIRD_SYSROOT"),
