    baseline_parser.add_argument("baseline_cmd", choices=["init", "show", "diff", "trust", "untrust"],
                                 help="Baseline action")
    baseline_parser.add_argument("target", nargs="?", help="PID or path for trust, path for untrust")
    return parser


def dev_main(args, parser: argparse.ArgumentParser) -> int:
    """Dispatch for the dev command tree (and the verbs that reuse it)."""
    if args.command == "inspect":
        return cmd_inspect(args)
    elif args.command == "trust":
        return cmd_trust(args)
    elif args.command == "cache":
        return cmd_cache(args)
    elif args.command == "watch":
        return cmd_watch(args)
    elif args.command == "restart-needed":
        return cmd_restart_needed(args)
    elif args.command == "persist":
        return cmd_persist(args)
    elif args.command == "hidden":
        return cmd_hidden(args)
    elif args.command == "kernel":
        return cmd_kernel(args)
    elif args.command == "aur":
        return cmd_aur(args)
    elif args.command == "self-check":
        return cmd_self_check(args)
    elif args.command == "offline":
        return cmd_offline(args)
    elif args.command == "fixture":
        return cmd_fixture(args)
    elif args.command == "rules":
        if args.rules_cmd == "init":
            return cmd_rules_init(args)
        return cmd_rules(args)
    elif args.command == "falco-rules":
        print(FALCO_RULES)
        return 0
    elif args.command == "man":
        return cmd_man(args)
    elif args.command == "completions":
        return cmd_completions(args, parser)
    elif args.command == "baseline":
        if args.baseline_cmd == "trust":
            return cmd_baseline_trust(args)
        if args.baseline_cmd == "untrust":
            return cmd_baseline_untrust(args)
        return cmd_scan(args)
    else:
        return cmd_scan(args)


SECTIONS = ("processes", "aur", "persist", "kernel", "stale", "hidden")
VERBS = ("dev", "trust", "untrust", "watch")
VALUE_OPTIONS = ("--skip", "--prometheus", "--offline", "--proc-root", "--sysroot", "--log-file", "--debug-log")
_self_check_shown = False


def build_parser(with_verbs: bool = False) -> argparse.ArgumentParser:
    """The one-command parser. with_verbs adds the verb tree (completions and docs only)."""
    parser = argparse.ArgumentParser(
        prog="weird",
        usage="weird [options]\n       weird PID | PATH\n       weird trust PID|PATH\n       weird untrust PATH\n"
              "       weird watch [--poll S | --events PATH | --falco]",
        description=textwrap.fill(
            "One run, one report: process scan, AUR packages, persistence entries, kernel posture, "
            "stale binaries and hidden-process cross-views, with a summary line and one exit code "
            "(0 clean, 1 medium or warning, 2 critical, 3 a collector failed). Trust levels mean "
            "provenance, not security.", 78),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.fill(
            "weird PID or weird PATH inspects one process or file; weird trust pins an executable so scans "
            "stay quiet until it changes; weird watch streams new flagged processes.", 78)
            + "\nDeveloper and single-section commands live under `weird dev` (weird dev --help).")
    parser.add_argument("target", nargs="?", metavar="PID|PATH", help=argparse.SUPPRESS)
    parser.add_argument("--version", action="version", version=f"weird {__version__}")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="All processes, info rows and the notes behind each finding")
    parser.add_argument("--json", action="store_true", help="One JSON object, a key per section plus summary")
    parser.add_argument("--ndjson", action="store_true", help="One JSON line per process (scan section only)")
    parser.add_argument("--journal", action="store_true", help="Send alerts and findings to the systemd journal")
    parser.add_argument("--prometheus", metavar="PATH", help="Write node_exporter textfile metrics to PATH")
    parser.add_argument("--deep", action="store_true",
                        help="Hash every packaged executable and probe every pid up to pid_max")
    parser.add_argument("--offline", metavar="SYSROOT", nargs="?", const="",
                        help="No network this run; with SYSROOT, live-media mode: check a mounted disk "
                             "(no process or hidden sections)")
    parser.add_argument("--skip", action="append", default=[], choices=SECTIONS, metavar="SECTION",
                        help="Leave out a section (repeatable): " + ", ".join(SECTIONS))
    parser.add_argument("--no-prompt", dest="no_prompt", action="store_true",
                        help="Never ask the online question (unanswered means offline)")
    parser.add_argument("--campaigns", metavar="PATH", help="Use this known-bad AUR package list file (never fetch, never ask)")
    parser.add_argument("--fetch-campaigns", dest="fetch_campaigns", action="store_true",
                        help="Download or update the known-bad AUR package list now, without asking")
    parser.add_argument("--save-baseline", dest="save_baseline", action="store_true",
                        help="Record this run as the baseline, without asking")
    parser.add_argument("--no-baseline", dest="no_baseline", action="store_true",
                        help="Skip the comparison with the saved baseline")
    parser.add_argument("--proc-root", dest="proc_root", metavar="DIR", default=os.environ.get("WEIRD_PROC_ROOT"),
                        help="Read process info from DIR instead of /proc (replays, tests)")
    parser.add_argument("--sysroot", dest="sysroot", metavar="DIR", default=os.environ.get("WEIRD_SYSROOT"),
                        help="Prefix for package databases and system config (replays, tests)")
    parser.add_argument("--debug-log", dest="debug_log", metavar="FILE", help=argparse.SUPPRESS)
    if with_verbs:
        verbs = parser.add_subparsers(dest="verb")
        verbs.add_parser("trust", help="Pin an executable hash").add_argument("target")
        verbs.add_parser("untrust", help="Remove a pinned executable").add_argument("target")
        add_watch_arguments(verbs.add_parser("watch", help=WATCH_HELP))
        add_dev_commands(verbs.add_parser("dev", help="Developer and single-section commands"))
    return parser


def split_argv(argv: List[str]) -> Tuple[List[str], Optional[str], List[str]]:
    """Main flags before the first verb word, the verb, and everything after it."""
    skip_value = False
    for i, word in enumerate(argv):
        if skip_value:
            skip_value = False
            continue
        if word in VALUE_OPTIONS:
            following = argv[i + 1] if i + 1 < len(argv) else ""
            # --offline alone means no network; it only takes a SYSROOT that is not a verb or an option
            skip_value = word != "--offline" or bool(following) and not following.startswith("-") \
                and following not in VERBS
            continue
        if word.startswith("-"):
            continue
        if word in VERBS:
            return argv[:i], word, argv[i + 1:]
        break
    return argv, None, []


def dev_args(main_args, words: List[str], parser: argparse.ArgumentParser) -> argparse.Namespace:
    """Parse words with the dev parser and carry the main flags over."""
    args, extra = parser.parse_known_args(words)
    if extra:
        parser.parse_args(extra, namespace=args)
    for key in ("verbose", "json", "ndjson", "journal", "prometheus", "deep", "proc_root", "sysroot", "debug_log",
                "campaigns", "fetch_campaigns", "campaigns_checked", "no_prompt"):
        if getattr(main_args, key, None) and not getattr(args, key, None):
            setattr(args, key, getattr(main_args, key))
    if getattr(main_args, "offline", None) is not None:
        args.offline = main_args.offline
    return args


def section_args(main_args, parser: argparse.ArgumentParser, command: str, **extra) -> argparse.Namespace:
    args = dev_args(main_args, [command], parser)
    args.all = main_args.verbose
    args.section = True
    for key, value in extra.items():
        setattr(args, key, value)
    return args


class SectionStdout:
    """Stands in for sys.stdout while sections run in threads: each thread writes to its own buffer."""

    def __init__(self, real):
        self.real = real
        self.local = threading.local()

    def capture(self, buf: io.StringIO) -> None:
        self.local.buf = buf

    def release(self) -> None:
        self.local.buf = None

    def write(self, text: str) -> int:
        return (getattr(self.local, "buf", None) or self.real).write(text)

    def flush(self) -> None:
        (getattr(self.local, "buf", None) or self.real).flush()

    def __getattr__(self, name):
        return getattr(self.real, name)


def run_section(fn, args, out: SectionStdout, threaded: bool = False) -> Tuple[Dict, str, int, Dict[str, int], Dict,
                                                                              SectionReport]:
    """Run one section command, capturing its JSON payload, its report items, its counts and its raw data.

    A threaded section holds the root gate so the process scan cannot swap the module
    root (sysroot_override, for container processes) under it.
    """
    buf = io.StringIO()
    _section_state.counts = {}
    _section_state.snapshot = {}
    _section_state.report = None
    _section_state.collecting = True
    _section_state.in_report = True
    out.capture(buf)
    try:
        with _root_gate.reading() if threaded else contextlib.nullcontext():
            code = fn(args)
    finally:
        out.release()
        _section_state.collecting = False
        _section_state.in_report = False
    text = buf.getvalue()
    snapshot = getattr(_section_state, "snapshot", {}) or {}
    report = take_section_report("")
    if args.json:
        return json.loads(text), "", code, section_counts(), snapshot, report
    return {}, text, code, section_counts(), snapshot, report


def section_counts() -> Dict[str, int]:
    counts = getattr(_section_state, "counts", {})
    return {level: counts.get(level, 0) for level in ("critical", "medium", "low", "info", "yours")}


class SectionThread(threading.Thread):
    """Runs one section in the background. A daemon thread, so a Ctrl-C never waits for it."""

    def __init__(self, fn, *args):
        super().__init__(daemon=True)
        self.fn, self.args = fn, args
        self.result = None
        self.error: Optional[BaseException] = None
        self.start()

    def run(self) -> None:
        try:
            self.result = self.fn(*self.args)
        except BaseException as exc:
            self.error = exc

    def wait(self):
        self.join()
        if self.error is not None:
            raise self.error
        return self.result


class Progress:
    """One line on stderr naming the sections still running, redrawn every second.

    Only when stderr is a terminal and the output is for a person; cleared before
    any report text is printed and again when the run ends.
    """

    def __init__(self, enabled: bool):
        self.enabled = enabled
        self.running: List[str] = []
        self.lock = threading.Lock()
        self.started = time.monotonic()
        self.width = 0
        self.stopped = threading.Event()
        if enabled:
            threading.Thread(target=self.tick, daemon=True).start()

    def tick(self) -> None:
        while not self.stopped.wait(1.0):
            with self.lock:
                self.draw()

    def clear(self) -> None:
        if self.width:
            sys.stderr.write("\r" + " " * self.width + "\r")
            sys.stderr.flush()
            self.width = 0

    def draw(self) -> None:
        if not self.enabled:
            return
        if not self.running or self.stopped.is_set():
            self.clear()
            return
        line = f"checking {', '.join(self.running)}... {int(time.monotonic() - self.started)}s"
        sys.stderr.write("\r" + line.ljust(self.width))
        sys.stderr.flush()
        self.width = len(line)

    def begin(self, name: str) -> None:
        with self.lock:
            self.running.append(name)
            self.draw()

    def end(self, name: str) -> None:
        with self.lock:
            if name in self.running:
                self.running.remove(name)
            self.draw()

    def emit(self, text: str, out) -> None:
        """Print report text with the progress line out of the way, then put it back."""
        with self.lock:
            self.clear()
            out.write(text)
            out.flush()
            self.draw()

    def stop(self) -> None:
        self.stopped.set()
        with self.lock:
            self.clear()


# =============================================================================
# Changes since the baseline
# =============================================================================

THREADED_SECTIONS = ("aur", "persist", "kernel")
BASELINE_SECTIONS = ("processes", "aur", "persist", "kernel")
PROGRESS_NAMES = {"processes": "processes", "aur": "AUR packages", "persist": "persistence", "kernel": "kernel",
                  "stale": "stale binaries", "hidden": "hidden processes"}
# a program not running when the baseline was saved: by where it came from
NEW_PROCESS_SEVERITY = {"OFFICIAL": "info", "THIRD_PARTY": "info", "KERNEL": "info", "USER_TRUSTED": "info",
                        "PUBLISHER_SIGNED": "info", "PUBLISHER_HOSTED": "info",
                        "LOCAL_BUILD": "low", "USER_PKG": "low", "FLATPAK": "low", "SNAP": "low", "APPIMAGE": "low"}
def process_changes(base_entries: List[Dict], processes: List[ProcessInfo], deep: bool) -> List[Finding]:
    """Programs not in the baseline (same executable path run by the same user) and executables whose hash moved."""
    base: Dict[Tuple[str, str], Dict] = {}
    for entry in base_entries:
        if entry.get("exe_realpath"):
            base.setdefault((entry["exe_realpath"], str(entry.get("uid", ""))), entry)
    findings: List[Finding] = []
    seen: Set[Tuple[str, str]] = set()
    for proc in processes:
        realpath = os.path.realpath(proc.path) if proc.path else ""
        key = (realpath, str(proc.uid))
        if not realpath or key in seen:
            continue
        seen.add(key)
        entry = base.get(key)
        trust = proc.trust_level.value
        if entry is None:
            findings.append(Finding("new process", f"{proc.name} ({realpath}, {trust}) was not running at the "
                                    "previous run", NEW_PROCESS_SEVERITY.get(trust, "medium"), "", realpath,
                                    title=f"New since your last run: {display_name(proc)}",
                                    text=f"{tilde(realpath)} was not running at your last run. {origin_sentence(proc)}"))
        elif changed_hash(sys_path(realpath), entry, "exe_", deep):
            findings.append(Finding("process hash changed", f"{proc.name}: {realpath} is not the file the previous "
                                    "run recorded", "medium", "T1554", realpath,
                                    title=f"Changed since your last run: {display_name(proc)}",
                                    text=f"{tilde(realpath)} is not the same file as at your last run. That is normal "
                                         "after an update; if nothing was updated, look at it."))
    return findings


def persistence_changes(base_entries: List[Dict], entries: List["PersistEntry"], deep: bool) -> List[Finding]:
    """Persistence entries added or removed (by file, key and target) and targets whose hash moved."""
    base = {(e.get("file"), e.get("key"), e.get("target")): e for e in base_entries}
    current = {(e.file, e.key, e.target): e for e in entries}
    findings: List[Finding] = []
    for key, entry in current.items():
        old = base.get(key)
        if old is None:
            findings.append(Finding("new persistence entry", f"{entry.key} in {entry.file} runs "
                                    f"{entry.target or entry.command} ({entry.provenance})", "medium",
                                    entry.attack, entry.file,
                                    title=f"New since your last run: {persist_title(entry)}",
                                    text=f"{persist_runs_sentence(entry)} If you added it, there is nothing to do here; "
                                         "it will not be listed again."))
        elif entry.target and changed_hash(persist_host_path(entry.target), old, "target_", deep):
            findings.append(Finding("persistence target changed", f"{entry.target}, run by {entry.key} in "
                                    f"{entry.file}, is not the file the previous run recorded", "medium", "T1554",
                                    entry.target,
                                    title=f"Changed since your last run: {os.path.basename(entry.target)}",
                                    text=f"{tilde(entry.file)} starts {tilde(entry.target)}, and that file is "
                                         "different from your last run. Expected if you edited or updated it; it "
                                         "will not be listed again."))
    for key, old in base.items():
        if key not in current:
            findings.append(Finding("persistence entry removed", f"{old.get('key')} in {old.get('file')} no longer "
                                    f"runs {old.get('target') or '(none)'}", "info", "", str(old.get("file")),
                                    title=f"{tilde(str(old.get('file')))} no longer starts "
                                          f"{tilde(str(old.get('target') or old.get('command') or 'anything'))}"))
    return findings


def package_changes(base: Dict[str, str], packages: List["AurPackage"]) -> List[Finding]:
    current = {p.name: p.version for p in packages}
    findings: List[Finding] = []
    for name, version in current.items():
        if name not in base:
            findings.append(Finding("new foreign package", f"{name} {version} was installed after the previous run",
                                    "low", "", name, title=f"New since your last run: AUR package {name} {version}",
                                    text="It was installed since your last run. The AUR packages section checks "
                                         "its build recipe."))
        elif base[name] != version:
            findings.append(Finding("foreign package version", f"{name} went from {base[name]} to {version}",
                                    "info", "", name, title=f"{name} updated from {base[name]} to {version}"))
    for name, version in base.items():
        if name not in current:
            findings.append(Finding("foreign package removed", f"{name} {version} is no longer installed", "info",
                                    "", name, title=f"{name} {version} was removed"))
    return findings


def posture_changes(base: Dict[str, str], posture: Dict[str, str]) -> List[Finding]:
    findings: List[Finding] = []
    for key, label in POSTURE_LABELS.items():
        old, new = base.get(key), str(posture.get(key, ""))
        if old is not None and new and str(old) != new:
            findings.append(Finding("posture changed", f"{label} went from {old} to {new}", "medium", "", label,
                                    title=f"Changed since your last run: kernel setting {label}",
                                    text=f"It went from {old} to {new} since your last run. If you did not change "
                                         "it, find out what did."))
    return findings


def baseline_changes(baseline: Dict, raw: Dict, deep: bool = False) -> List[Finding]:
    """What this run shows that the baseline did not; a part missing on either side is not compared."""
    findings: List[Finding] = []
    if "processes" in baseline and "processes" in raw:
        findings += process_changes(baseline["processes"], raw["processes"], deep)
    if "persistence" in baseline and "persistence" in raw:
        findings += persistence_changes(baseline["persistence"], raw["persistence"], deep)
    if "packages" in baseline and "packages" in raw:
        findings += package_changes(baseline["packages"], raw["packages"])
    if "posture" in baseline and "posture" in raw:
        findings += posture_changes(baseline["posture"], raw["posture"])
    sort_findings(findings)
    return findings


def compared_parts(baseline: Dict, raw: Dict) -> str:
    parts = []
    if "processes" in baseline and "processes" in raw:
        parts.append(plural(len(raw["processes"]), "process", "processes"))
    if "persistence" in baseline and "persistence" in raw:
        parts.append(plural(len(raw["persistence"]), "persistence entry", "persistence entries"))
    if "packages" in baseline and "packages" in raw:
        parts.append(plural(len(raw["packages"]), "foreign package"))
    if "posture" in baseline and "posture" in raw:
        parts.append("kernel posture")
    return ", ".join(parts) or "nothing to compare"


def changes_report(changes: List[Finding], baseline: Dict, raw: Dict) -> SectionReport:
    """The changes since the previous run, as report items and one summary line."""
    report = SectionReport("changes")
    for f in changes:
        report.cards.append(Card(f.severity, f.title or f.detail, f.text if f.title else "", finding_details(f)))
    date = spoken_date(baseline)
    counts = finding_counts(changes)
    listed = counts["critical"] + counts["medium"] + counts["low"]
    if not changes:
        report.summary = f"Nothing changed since {date} ({compared_parts(baseline, raw)} compared)."
    elif not listed:
        report.summary = f"{plural(len(changes), 'small change')} since {date}."
    elif counts["info"]:
        report.summary = f"{plural(len(changes), 'change')} since {date}; {listed} listed above."
    else:
        report.summary = f"{plural(len(changes), 'change')} since {date}, all listed above."
    return report


def changes_payload(changes: List[Finding], baseline: Dict) -> Dict:
    return {"baseline_timestamp": int(baseline.get("timestamp") or 0), "baseline_date": baseline_date(baseline),
            "findings": [asdict(f) for f in changes], "counts": finding_counts(changes)}


def run_all(args) -> Tuple[Dict, Dict, int, Dict]:
    """Every section in a fixed order; returns ({section: payload or text}, summary, exit code, state).

    aur, persist and kernel run in daemon threads while the process scan runs on the
    main thread; stale and hidden follow on the main thread (the pid probe is
    CPU-bound). The sections the baseline covers are held until all of them are
    done so the changes section can print first; the rest stream as they finish.
    The state carries the raw section data (for the baseline), the baseline and
    changes used, the section a Ctrl-C landed in, and each section's report items,
    which the text report prints in one piece once everything has run.
    """
    parser = build_dev_parser()
    sections: Dict[str, object] = {}
    summary = {"critical": 0, "medium": 0, "low": 0, "info": 0, "yours": 0}
    state: Dict = {"raw": {}, "baseline": None, "changes": None, "interrupted": "", "reports": []}
    exit_code = 0
    # the one question, before any section or progress line can get in its way
    online_allowed(args)
    if "aur" not in getattr(args, "skip", None or []):
        chosen = maybe_offer_campaign_update(args)
        if chosen is not None:
            args.campaigns = str(chosen)
        args.campaigns_checked = True
        args.fetch_campaigns = False
    plan = [
        ("processes", cmd_scan, "Running programs", {}),
        ("aur", cmd_aur, "AUR packages", {}),
        ("persist", cmd_persist, "Programs that start on their own", {}),
        ("kernel", cmd_kernel, "Kernel and drivers", {}),
        ("stale", cmd_restart_needed, "Programs still running old files after an update",
         {"prometheus": None, "journal": False}),
        ("hidden", cmd_hidden, "Hidden processes", {}),
    ]
    command = {"processes": "scan", "stale": "restart-needed"}
    plan = [(name, fn, title, extra if name == "processes" else dict(extra, prometheus=None))
            for name, fn, title, extra in plan if name not in args.skip]
    baseline = None if getattr(args, "no_baseline", False) else load_baseline()
    state["baseline"] = baseline
    # shared caches are filled once here, before any section runs in a thread
    file_package_cache.build()
    real = sys.stdout
    out = SectionStdout(real)
    sys.stdout = out
    progress = Progress(not args.json and sys.stderr.isatty())
    started = time.monotonic()
    current = ""
    reports: Dict[str, SectionReport] = {}

    try:
        threads = {}
        for name, fn, title, extra in plan:
            if name in THREADED_SECTIONS:
                progress.begin(PROGRESS_NAMES[name])
                threads[name] = SectionThread(run_section, fn, section_args(args, parser, command.get(name, name), **extra),
                                              out, True)
        for index, (name, fn, title, extra) in enumerate(plan):
            current = name
            if name in threads:
                payload, text, code, counts, raw, report = threads[name].wait()
            else:
                progress.begin(PROGRESS_NAMES[name])
                payload, text, code, counts, raw, report = run_section(
                    fn, section_args(args, parser, command.get(name, name), **extra), out)
            progress.end(PROGRESS_NAMES[name])
            state["raw"].update(raw)
            for level in summary:
                summary[level] += counts[level]
            exit_code = 3 if 3 in (exit_code, code) else max(exit_code, code)
            if args.json:
                sections[name] = payload
            elif name != "stale" or report.cards:
                report.name = name
                reports[name] = report
                sections[name] = text
            if any(later in BASELINE_SECTIONS for later, *_ in plan[index + 1:]):
                continue
            if baseline is not None and state["changes"] is None:
                changes = baseline_changes(baseline, state["raw"], getattr(args, "deep", False))
                state["changes"] = changes
                for f in changes:
                    summary[f.severity] += 1
                code = findings_exit_code(changes)
                exit_code = exit_code if exit_code == 3 else max(exit_code, code)
                emit_findings_outputs(args, "changes", changes, started)
                if not args.json:
                    reports["changes"] = changes_report(changes, baseline, state["raw"])
    except KeyboardInterrupt:
        state["interrupted"] = current
        exit_code = 130
    finally:
        progress.stop()
        sys.stdout = real
    state["reports"] = [reports[name] for name in ["changes"] + [p[0] for p in plan] if name in reports]
    summary["exit_code"] = exit_code
    return sections, summary, exit_code, state


def baseline_after_run(args, state: Dict) -> str:
    """Record this run as the baseline, so the next run reports what changed since it.

    Every completed run that covered a baseline section writes one; nothing is
    written after a Ctrl-C or with --no-baseline. Returns the line the report adds
    for the first save or an explicit --save-baseline (JSON runs print it to
    stderr); later saves are silent.
    """
    if getattr(args, "no_baseline", False) or state["interrupted"] or not state["raw"]:
        return ""
    baseline = state["baseline"]
    data = build_baseline(state["raw"], baseline)
    save_baseline(data)
    if baseline is None or getattr(args, "save_baseline", False):
        message = f"Saved this machine's current state in {BASELINE_FILE}."
        if args.json:
            print(message, file=sys.stderr)
        return message
    return ""


def cmd_all(args) -> int:
    global _report_tty
    _report_tty = None
    _report_tty = report_tty()
    try:
        return report_all(args)
    finally:
        _report_tty = None


def report_all(args) -> int:
    global _self_check_shown
    warnings = self_check()
    if not args.json and not args.ndjson:
        print_self_check(warnings)
        _self_check_shown = True
    if args.ndjson:
        parser = build_dev_parser()
        return cmd_scan(section_args(args, parser, "scan"))
    sections, summary, exit_code, state = run_all(args)
    if args.json:
        payload = {"host": socket.gethostname(), "timestamp": int(time.time()), "self_check": warnings,
                   "self_integrity": _self_integrity}
        payload.update(sections)
        if state["changes"] is not None:
            payload["changes"] = changes_payload(state["changes"], state["baseline"])
        if state["interrupted"]:
            payload["interrupted"] = state["interrupted"]
        payload["online"] = {"enabled": bool(_online_state["decided"]), "note": online_note()}
        payload["summary"] = summary
        print(json.dumps(payload, indent=2))
        baseline_after_run(args, state)
        return exit_code
    notes = []
    if state["interrupted"]:
        notes.append(f"Stopped early during {PROGRESS_NAMES.get(state['interrupted'], state['interrupted'])}: "
                     "this report covers only the parts that finished.")
    if online_note():
        notes.append(online_note())
    baseline = state["baseline"]
    if state["interrupted"] or getattr(args, "no_baseline", False):
        lead = ""
    elif baseline is not None:
        lead = f"Compared with your last run on {spoken_date(baseline)}."
    else:
        lead = "First run: weird saved what this machine looks like now, so the next run can show what changed."
    saved = baseline_after_run(args, state)
    if saved and baseline is not None:
        notes.append(saved)
    if not getattr(args, "verbose", False):
        notes.append(paint("weird -v lists everything; weird 1234 explains process 1234.", "2"))
    print(render_report(state["reports"], getattr(args, "verbose", False), f"on {socket.gethostname()}", lead, notes))
    return 130 if state["interrupted"] else exit_code


def main(argv: Optional[List[str]] = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    main_words, verb, rest = split_argv(argv)
    parser = build_parser()
    args = parser.parse_args(main_words)
    set_roots(args.proc_root, args.sysroot)
    check_self_integrity()

    global DEBUG_LOG_FILE
    if getattr(args, 'debug_log', None):
        DEBUG_LOG_FILE = Path(args.debug_log)
        debug_log("startup", f"Debug logging enabled to {DEBUG_LOG_FILE}")

    dev = build_dev_parser()
    if verb == "dev":
        if not rest or rest == ["--help"] or rest == ["-h"]:
            dev.print_help()
            return 0
        sub = dev_args(args, rest, dev)
        if sub.command == "completions":
            return cmd_completions(sub, build_parser(with_verbs=True))
        return dev_main(sub, dev)
    if verb in ("trust", "untrust"):
        return dev_main(dev_args(args, ["baseline", verb] + rest, dev), dev)
    if verb == "watch":
        return dev_main(dev_args(args, ["watch"] + rest, dev), dev)
    if args.offline:
        sub = dev_args(args, ["offline", args.offline], dev)
        return cmd_offline(sub)
    if args.target is not None:
        if args.target.isdigit():
            sub = dev_args(args, ["inspect", args.target], dev)
            return cmd_inspect(sub)
        if os.path.exists(args.target):
            sub = dev_args(args, ["inspect", "0"], dev)
            sub.path = args.target
            return cmd_inspect(sub)
        parser.error(f"{args.target} is neither a pid nor an existing path")
    return cmd_all(args)


if __name__ == "__main__":
    sys.exit(main())
